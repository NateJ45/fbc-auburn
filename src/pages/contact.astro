---
// Safe to edit by hand for copy + structure changes.
// Contact page: section-driven via pageBuilder (2026-10-26, every main page a page builder).
// Edit sections and order in Sanity Studio under the Contact page document, Page layout. The form
// is the "Contact form" block (src/components/sections/ContactFormSection.astro); its questions
// stay on the document's "The form" tab. When pageBuilder is empty (no Sanity project or
// unmigrated), DEFAULT_CONTACT_SECTIONS renders so the page is never blank.

import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { getContactPage, getSiteSettings } from '@/lib/queries';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import { DEFAULT_CONTACT_SECTIONS } from '@/data/defaultSections';

const [page, siteSettings] = await Promise.all([getContactPage(), getSiteSettings()]);

const title = page?.seoTitle ?? `Contact ${site.name}`;
const description = page?.seoDescription ?? 'Ask a question or tell us you are visiting.';

const sections = page?.pageBuilder?.length ? page.pageBuilder : DEFAULT_CONTACT_SECTIONS;
// The share card's small line: the opening banner's eyebrow.
const kicker =
  (sections as { _type?: string; eyebrow?: string }[]).find((s) => s?._type === 'heroSection')
    ?.eyebrow || 'Get in touch';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Contact', url: `${site.url}/contact/` },
  ]),
];
---

<BaseLayout
  {title}
  {description}
  {schemas}
  {siteSettings}
  seoImage={page?.seoImage}
  ogCard={{ kicker }}
>
  {/* The old prayer side door (re-audit 2026-10-26): /contact/?topic=prayer goes to the prayer page,
      whose form keeps the prayer privacy promise. Runs on a full load and on a router swap. */}
  <script is:inline>
    if (/[?&]topic=pray/i.test(location.search)) location.replace('/prayer/');
  </script>
  <SectionRenderer {sections} idPrefix="contact" leadImage />
</BaseLayout>
