---
// scaffold-file: faq
// Safe to edit by hand for copy + structure changes.
// FAQ page. All common questions, grouped by category in the order
// set by faqPage.categoryOrder. Visitors who get this far are pre-qualifying themselves.
//
// Sections:
//   1. Hero (text-only)
//   2. Full FAQ list, grouped by category (FaqAccordion island)
//   3. Final CTA
//
// Per CLAUDE.md: this page injects FAQPage JSON-LD so each question is eligible for
// Google's rich-result accordion in search.

import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { getFaqPage, getSiteSettings } from '@/lib/queries';
import { breadcrumbSchema, faqPageSchema } from '@/lib/schemas';
import { site } from '@/data/site';

import Hero from '@/components/Hero.astro';
import FaqAccordion from '@/components/FaqAccordion';
import FinalCta from '@/components/FinalCta.astro';
import BoardRule from '@/components/home/BoardRule.astro';

const [page, siteSettings] = await Promise.all([getFaqPage(), getSiteSettings()]);

const title = page?.seoTitle ?? `Frequently Asked Questions · ${site.name}`;
const description =
  page?.seoDescription ??
  'What to wear, where to park, what happens on a Sunday: the questions people ask before a first visit.';

const heroEyebrow = page?.heroEyebrow ?? 'Before you visit';
const heroHeadline = page?.heroHeadline ?? 'Questions';
const heroSubhead = page?.heroSubhead ?? '';

const categoryOrder = page?.categoryOrder ?? [];
const faqs = page?.faqs ?? [];

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'FAQ', url: `${site.url}/faq/` },
  ]),
  faqPageSchema(faqs),
];
---

<BaseLayout
  {title}
  {description}
  {schemas}
  {siteSettings}
  seoImage={page?.seoImage}
  searchType="question"
>
  {/* ------- 1. Hero --------------------------------------------------------- */}
  <Hero
    eyebrow={heroEyebrow}
    headline={heroHeadline}
    subhead={heroSubhead}
    backgroundImage={page?.heroImage}
    headingId="faq-hero-heading"
    size="short"
    scriptAccent={page?.heroScriptAccent ?? 'Know'}
  />

  {/* ------- 2. FAQ accordion (grouped by category) ------------------------- */}
  {/* The section marker every other page opens its sections with (2026-10-24); the board's
      rule-then-section spacing also closes the gap that sat above the first group. */}
  <BoardRule />
  <section class="bg-background" aria-label="Frequently asked questions">
    <div class="mx-auto max-w-content px-m py-section-lg">
      {/* On the page's left edge like every other band (rule 17); it was centred, off the heading line. */}
      <div class="max-w-3xl">
        {faqs.length > 0 ? (
          <FaqAccordion
            client:visible
            faqs={faqs}
            categoryOrder={categoryOrder}
            idPrefix="faq-page"
          />
        ) : (
          <p class="text-center text-muted-foreground italic">
            FAQ content is being updated.{' '}
            <a href="/contact/" class="text-link underline underline-offset-2">
              Ask anything
            </a>{' '}
            in the meantime.
          </p>
        )}
      </div>
    </div>
  </section>

  {/* ------- 3. Final CTA ---------------------------------------------------- */}
  {/* Extra sections (2026-10-18): anything the editor adds from the section library, Studio:
      this page > Extra sections. Empty renders nothing. */}
  <SectionRenderer sections={page?.additionalSections ?? []} idPrefix="faq-extra" />

  <FinalCta
    eyebrow={page?.finalCtaEyebrow}
    headline={page?.finalCtaHeadline}
    subhead={page?.finalCtaSubhead}
    cta={page?.finalCta}
    secondaryCta={page?.secondaryCta}
    scriptAccent={page?.finalCtaScriptAccent}
    backgroundImage={page?.finalCtaBackgroundImage}
  />
</BaseLayout>
