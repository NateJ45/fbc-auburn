---
// Safe to edit by hand
// /sermons/: the sermon archive, section-driven via pageBuilder (2026-10-26, every main page a page
// builder). Edit sections and order in Sanity Studio under the Sermons page document, Page layout.
// The default (DEFAULT_SERMONS_SECTIONS, and what scripts/content/builder-pages.mjs wrote):
// the page head, the Watch band (the live stream, the Facebook page and the newest message; the
// Watch page was merged in here on 2026-10-24 and /watch/ redirects to this page), "Every sermon"
// with its filters (SermonArchive.astro), the series (hidden until there is one), the podcast
// (PodcastSection.astro), then anything the editor adds. The archive and the podcast render
// nothing until the first sermon is published.
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { getSiteSettings } from '@/lib/queries';
import { getSermonsPage } from '@/lib/collection-queries';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import { DEFAULT_SERMONS_SECTIONS } from '@/data/defaultSections';

const [page, siteSettings] = await Promise.all([getSermonsPage(), getSiteSettings()]);

const sections = page?.pageBuilder?.length ? page.pageBuilder : DEFAULT_SERMONS_SECTIONS;
// The share card's small line: the opening banner's eyebrow.
const kicker =
  (sections as { _type?: string; eyebrow?: string }[]).find((s) => s?._type === 'heroSection')
    ?.eyebrow || 'Sunday by Sunday';

const title = page?.seoTitle || 'Sermons';
const description =
  page?.seoDescription ||
  `Sermons from ${site.name} in Hamilton, Ohio: watch, listen or read the passage, by series, preacher or book of the Bible.`;
const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Sermons', url: `${site.url}/sermons/` },
  ]),
];
---

<BaseLayout
  {title}
  {description}
  {schemas}
  {siteSettings}
  seoImage={page?.seoImage}
  ogCard={{ kicker }}
>
  <SectionRenderer {sections} idPrefix="sermons" leadImage />
</BaseLayout>
