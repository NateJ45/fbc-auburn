---
// Safe to edit by hand
// Custom 404, "Off the path" (FBC Auburn mockups): the brick path breaks off after two steps, the title
// sits below it in plain navy type (the brick-wall title was dropped 2026-10-24), and two buttons lead back. No search (there isn't one).
//
// The words and buttons can be set in the Studio (Not Found Page); these are the fallbacks.
// The starter's photo column is gone: the broken path is the picture.
import { withTrailingSlash } from '@/lib/href';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getNotFoundPage, getSiteSettings } from '@/lib/queries';

const [notFoundPage, siteSettings] = await Promise.all([getNotFoundPage(), getSiteSettings()]);

const seoTitle = notFoundPage?.seoTitle ?? 'Page not found';
const seoDescription =
  notFoundPage?.seoDescription ?? 'This page has wandered off. Head back to the home page.';

const headline = notFoundPage?.headline ?? 'Off the path';
const body =
  notFoundPage?.body ??
  "This page has wandered off, or the link was mistyped. Let's get you back on the path.";

const primaryLabel = notFoundPage?.primaryCtaLabel ?? 'Back to the home page';
const primaryHref = withTrailingSlash(notFoundPage?.primaryCtaHref) ?? '/';
const secondaryLabel = notFoundPage?.secondaryCtaLabel ?? 'Get in touch';
const secondaryHref = withTrailingSlash(notFoundPage?.secondaryCtaHref) ?? '/contact/';
---

<BaseLayout title={seoTitle} description={seoDescription} siteSettings={siteSettings} noindex>
  <section
    class="lost mx-auto max-w-content px-m py-section-lg text-center"
    aria-labelledby="not-found-heading"
  >
    <div class="lost__path" aria-hidden="true">
      <span class="lost__brick lost__brick--1"></span>
      <span class="lost__brick lost__brick--2"></span>
      <span class="lost__gone lost__gone--3"></span>
      <span class="lost__gone lost__gone--4"></span>
    </div>
    <h1 id="not-found-heading" class="lost__h1 stone-heading stone-solid">
      {headline}
    </h1>
    <p class="mx-auto mt-m max-w-xl text-lg leading-relaxed text-muted-foreground">{body}</p>
    <div class="mt-l flex flex-wrap justify-center gap-s">
      <a href={primaryHref} class="btn-auburn btn-auburn--primary press-tactile">
        {primaryLabel}
      </a>
      <a href={secondaryHref} class="btn-auburn btn-auburn--secondary press-tactile">
        {secondaryLabel}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .lost__path {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: 16px;
    margin-bottom: 2.5rem;
  }
  /* Four steps of the brick path, stepping up to the right like the section marker: two laid
     (auburn bricks with the inset bottom band every brick on the site carries), two missing
     (dashed outlines where the next bricks should be). Brick brand, 2026-10-23. */
  .lost__brick,
  .lost__gone {
    width: 56px;
    height: 24px;
    border-radius: 3px;
  }
  /* Printed like every brick (2026-10-23): a darker rim, heavier along the bottom, and the linocut
     flecks from npm run gen:stones. */
  .lost__brick {
    border-radius: 2px;
    background-image: url('/textures/print-flecks.svg');
    background-size: 64px 44px;
    box-shadow:
      inset 0 0 0 2px rgb(0 0 0 / 0.2),
      inset 0 -3px 0 rgb(0 0 0 / 0.16);
  }
  .lost__brick--1 {
    background-color: #9a3b2a;
  }
  .lost__brick--2 {
    background-color: #b5503a;
    transform: translateY(-10px);
  }
  .lost__gone {
    border: 2px dashed var(--border);
  }
  .lost__gone--3 {
    transform: translateY(-20px);
  }
  .lost__gone--4 {
    transform: translateY(-30px);
  }
  .lost :global(.lost__h1) {
    font-size: clamp(3rem, 1.5rem + 6vw, 6rem);
  }
</style>
