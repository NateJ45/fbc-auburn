---
// Safe to edit by hand
// /bulletin/: "This week's bulletin" (FBC Auburn, 2026-10-18). One address that never changes, for
// the menu, the Facebook page or a QR code on the printed bulletin: it always shows the newest
// current Bulletin from the Downloads list (newestBulletin in src/lib/sermons.ts), with the few
// before it underneath. Nothing to switch over each week: upload the new one and publish.
// When this week's is not up yet (audit 2026-10-25), the newest one stays, labelled "Last week's"
// (bulletinToShow), with a line saying when the next goes up, so the page never looks abandoned.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import BoardRule from '@/components/home/BoardRule.astro';
import DownloadRow from '@/components/collections/DownloadRow.astro';
import { getSiteSettings } from '@/lib/queries';
import { getBulletins } from '@/lib/collection-queries';
import { churchDataNow } from '@/lib/church-feeds';
import { bulletinToShow, currentDownloads, fileLabel, longDate } from '@/lib/sermons';
import { PRE_LAUNCH_NOTES } from '@/data/for-jacob';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';

const [bulletins, siteSettings] = await Promise.all([getBulletins(), getSiteSettings()]);
const now = churchDataNow();
const { bulletin, thisWeek } = bulletinToShow(bulletins, now);
// When the next one goes up, in the church's words ("by Saturday evening"). Empty: no line.
// Before launch, the ask for it shows in its place.
const POSTED_WHEN = '';
const nextLine = POSTED_WHEN
  ? `A new bulletin goes up each week, ${POSTED_WHEN}.`
  : PRE_LAUNCH_NOTES
    ? '[Jacob: which day is the new bulletin posted here, and who posts it? We will say it on this page, like "A new one goes up by Saturday evening", so people know when to look.]'
    : '';
const earlier = currentDownloads(
  bulletins.filter((b) => b._id !== bulletin?._id),
  now,
  'bulletin',
  5,
);
const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: "This week's bulletin", url: `${site.url}/bulletin/` },
  ]),
];
---

<BaseLayout
  title="This week's bulletin"
  description={`The newest Sunday bulletin from ${site.name}: the order of service, the week's news and the dates to keep.`}
  {schemas}
  {siteSettings}
>
  <Hero
    eyebrow="Sunday bulletin"
    headline="This week's bulletin"
    subhead="The order of service, this week's news and the dates to keep."
    headingId="bulletin-heading"
    size="short"
  />
  <BoardRule />
  <section class="bg-background" aria-label="The bulletin">
    <div class="mx-auto max-w-content px-m py-section-lg">
      {bulletin ? (
        <div class="c-feature">
          <p class="c-feature__label">
            {thisWeek ? '' : "Last week's bulletin · "}
            {longDate(bulletin.date)}
          </p>
          <p class="c-feature__title">{bulletin.title}</p>
          {bulletin.note && <p class="c-meta">{bulletin.note}</p>}
          <a
            class="btn-auburn btn-auburn--secondary press-tactile"
            href={bulletin.file?.url}
            target="_blank"
            rel="noopener"
            data-search-title={bulletin.title}
            data-search-type="bulletin"
            data-search-date={longDate(bulletin.date) || undefined}
            data-search-note={bulletin.note || undefined}
          >
            Open the bulletin
            {fileLabel(bulletin.file) && ` (${fileLabel(bulletin.file)})`}
          </a>
        </div>
      ) : (
        <p class="c-empty">
          The first bulletin is not up yet. Check back on Sunday morning, or{' '}
          <a class="c-link" href="/contact/?topic=question&about=The%20bulletin">
            ask the church office
          </a>
          .
        </p>
      )}
      {(!bulletin || !thisWeek) && nextLine && <p class="c-meta mt-m">{nextLine}</p>}
      {earlier.length > 0 && (
        <>
          <h2 class="font-display text-h2 auburn-h2 leading-tight mt-section-md mb-m">
            Earlier bulletins
          </h2>
          <ul class="c-files" role="list">
            {earlier.map((d) => (
              <DownloadRow item={d} />
            ))}
          </ul>
        </>
      )}
    </div>
  </section>
</BaseLayout>
