---
// Safe to edit by hand
// Privacy policy page: section-driven via pageBuilder (2026-10-26, every main page a page builder).
// Edit sections and order in Sanity Studio under the Privacy page document, Page layout. The policy
// is the "Privacy policy text" block (src/components/sections/PrivacyPolicy.astro), which shows
// the church's built-in policy when no words are typed in it. When pageBuilder is empty (no
// Sanity project or unmigrated), DEFAULT_PRIVACY_SECTIONS renders so the page is never blank.

import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { getPrivacyPage, getSiteSettings } from '@/lib/queries';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import { DEFAULT_PRIVACY_SECTIONS } from '@/data/defaultSections';

const [page, siteSettings] = await Promise.all([getPrivacyPage(), getSiteSettings()]);

const title = page?.seoTitle ?? 'Privacy policy';
const description =
  page?.seoDescription ??
  'What the ' + site.name + ' website collects, why, and what it never does with it.';

const sections = page?.pageBuilder?.length ? page.pageBuilder : DEFAULT_PRIVACY_SECTIONS;
// The share card's small line: the opening banner's eyebrow.
const kicker =
  (sections as { _type?: string; eyebrow?: string }[]).find((s) => s?._type === 'heroSection')
    ?.eyebrow || 'Your privacy';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Privacy Policy', url: `${site.url}/privacy/` },
  ]),
];
---

<BaseLayout
  {title}
  {description}
  {schemas}
  {siteSettings}
  seoImage={page?.seoImage}
  ogCard={{ kicker }}
>
  <SectionRenderer {sections} idPrefix="privacy" leadImage />
</BaseLayout>
