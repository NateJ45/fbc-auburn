---
// scaffold-file: journal
// Safe to edit by hand for copy + structure changes.
// A News and notes post (layout 2026-10-24, from the hppres.org stories): a back link with a long
// thin arrow, the title big in Young Serif, a wide cover cut with the stepped brick corner
// (.shape-step--lg, src/styles/shapes.css), then the body in two columns on a wide screen: a
// narrow sticky rail on the left (the date, reading time, author, categories, the headings and the
// share buttons) and the text on the right at a reading measure. On a phone the rail is one row
// above the text. "More from News and notes" closes it, its cards cut with the same corner.
// Styles: src/styles/article.css. Docs: docs/agent/shapes.md ("The article page").
// BreadcrumbList + BlogPosting JSON-LD, the reading progress bar and the Photo needed cover
// (journalCoverShot) are unchanged.
//
// Static-site routing: getStaticPaths enumerates every journalEntry slug at
// build time. The query is duplicated (once for paths, once for the full doc)
// — Astro caches each call per slug, so the perf hit is just the static map.

import '@/styles/shapes.css';
import '@/styles/article.css';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  getAllJournalEntries,
  getJournalEntryBySlug,
  getJournalPage,
  getSiteSettings,
} from '@/lib/queries';
import { getSectionVisibility } from '@/lib/sectionVisibility';
import { breadcrumbSchema, blogPostingSchema } from '@/lib/schemas';
import { readingTimeFromPortableText, formatReadingTime } from '@/lib/reading-time';
import { extractHeadings } from '@/lib/portable-text-headings';
import { site } from '@/data/site';
import { urlFor } from '@/lib/sanity';

import SanityImage from '@/components/SanityImage.astro';
import ShotRequest from '@/components/ShotRequest.astro';
import { journalCoverShot } from '@/data/shot-list';
import JournalPortableText from '@/components/JournalPortableText';
import JournalCategoryChip from '@/components/JournalCategoryChip.astro';
import ReadingProgress from '@/components/ReadingProgress.astro';
import StickyCTAChip from '@/components/StickyCTAChip';
import CaseStudyTOC from '@/components/CaseStudyTOC';
import FinalCta from '@/components/FinalCta.astro';
import Lightbox from '@/components/Lightbox.astro';
import BoardRule from '@/components/home/BoardRule.astro';
import { MARKER } from '@/components/home/stones.generated';
import { formatDate } from '@/lib/format-date';
import ShareButtons from '@/components/ShareButtons.astro';
import SearchMeta from '@/components/search/SearchMeta.astro';
import { Image } from 'astro:assets';
import markPrint from '@/assets/brand/mark-print.png';

// Enumerate slugs + carry prev/next refs (newest-first iteration).
// Returns [] when journal is off — no detail pages build and they 404.
export async function getStaticPaths() {
  const [entries, settings] = await Promise.all([getAllJournalEntries(), getSiteSettings()]);
  const visible = getSectionVisibility(settings?.sectionVisibility);
  if (!visible.journal) return [];

  if (!Array.isArray(entries) || entries.length === 0) return [];

  return entries
    .map((e, i) => {
      const prev = entries[i - 1] ?? null; // newer post
      const next = entries[i + 1] ?? null; // older post
      return {
        params: { slug: e.slug?.current ?? '' },
        props: {
          prev: prev ? { title: prev.title, slug: prev.slug?.current } : null,
          next: next ? { title: next.title, slug: next.slug?.current } : null,
        },
      };
    })
    .filter((entry) => entry.params.slug);
}

const { slug } = Astro.params;
const { prev, next } = Astro.props as {
  prev: { title?: string; slug?: string } | null;
  next: { title?: string; slug?: string } | null;
};

const [entry, siteSettings, journalPage] = await Promise.all([
  getJournalEntryBySlug(slug as string),
  getSiteSettings(),
  // Pulled here purely so the sticky CTA chip label can come from
  // journalPage.stickyCtaLabel without doubling up the singleton fetch
  // elsewhere. Cached by the GROQ layer across getStaticPaths.
  getJournalPage(),
]);

// Listed by getStaticPaths, so empty means a failed read: stop the build
// rather than publish the post as a redirect to /404 (see [slug].astro).
if (!entry && import.meta.env.PROD) {
  throw new Error(
    `[journal] "${slug}" was listed but came back empty; refusing to publish it as a 404`,
  );
}
if (!entry) {
  return Astro.redirect('/404');
}

// Meta
// The layout adds the church's name to the title. (The starter's "Studio Journal" wording is gone.)
const title = entry.seoTitle ?? entry.title;
const description = entry.seoDescription ?? entry.excerpt ?? `News and notes from ${site.name}.`;
// Before launch, a stand-in cover gives way to a "Photo needed" box (src/data/shot-list.ts).
const coverShot = journalCoverShot(entry.coverImage);
const coverOg = entry.coverImage?.asset
  ? urlFor(entry.coverImage).width(1200).height(630).fit('crop').quality(80).format('jpg').url()
  : undefined;

// Derived
const readMinutes = readingTimeFromPortableText(entry.body);
// The headings list sits in the rail on a wide screen when the body has h2/h3/h4 headings.
const headings = extractHeadings(entry.body);
const hasToc = headings.length > 0;
// The same ids, by block key, for the body's own headings (JournalPortableText). Walks the body
// with extractHeadings' rule (h2 to h4 with some text), so the n-th such block gets the n-th id
// and the TOC links always land (audit DEV-M2, 2026-10-25: built here, not in the browser).
const headingIds: Record<string, string> = {};
{
  let n = 0;
  for (const b of (entry.body ?? []) as {
    _type?: string;
    _key?: string;
    style?: string;
    children?: { text?: string }[];
  }[]) {
    if (b?._type !== 'block' || !['h2', 'h3', 'h4'].includes(b.style ?? '')) continue;
    const text = (b.children ?? [])
      .map((c) => c?.text ?? '')
      .join('')
      .trim();
    if (!text) continue;
    const h = headings[n++];
    if (b._key && h) headingIds[b._key] = h.id;
  }
}
// Only the before/after slider needs React in the browser; a post without one is plain HTML.
const bodyNeedsJs = ((entry.body ?? []) as { _type?: string }[]).some(
  (b) => b?._type === 'beforeAfter',
);
const dateLabel = formatDate(entry.publishedAt);
const updatedLabel =
  entry.updatedAt && entry.updatedAt !== entry.publishedAt ? formatDate(entry.updatedAt) : '';
const categories = Array.isArray(entry.categories) ? entry.categories : [];

type RelatedPost = {
  title?: string;
  slug?: { current?: string };
  publishedAt?: string;
  coverImage?: any;
};
const related: RelatedPost[] = Array.isArray(entry.relatedPosts)
  ? (entry.relatedPosts as RelatedPost[]).filter((p) => p?.slug?.current).slice(0, 3)
  : [];

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'News and notes', url: `${site.url}/journal/` },
    { name: entry.title ?? slug, url: `${site.url}/journal/${slug}/` },
  ]),
  blogPostingSchema(entry, coverOg ?? null),
];
---

<BaseLayout
  {title}
  {description}
  ogImage={coverOg}
  ogCard={{ kicker: dateLabel || 'News and notes' }}
  {schemas}
  {siteSettings}
  ogType="article"
  ogArticle={{ publishedAt: entry.publishedAt, author: entry.author }}
  searchType="news"
>
  <SearchMeta date={dateLabel} />
  {/* Thin progress bar tracking scroll through the article. */}
  <ReadingProgress />

  <article class="art">
    {/* ------- 1. Back link, title, standfirst ----------------------------- */}
    <header class="art-head mx-auto max-w-content art-gutter">
      {/* The page-head grammar of the sermon detail (audit 2026-10-25, GD-M12): the brick marker and
          the section's name as the eyebrow, here also the way back to the list. */}
      <a href="/journal/" class="art-back hb-label">
        <svg
          class="hb-marker"
          viewBox="0 0 78 36"
          width="78"
          height="36"
          aria-hidden="true"
          focusable="false"
        >
          {MARKER.map((m) => (
            <path d={m.d} fill={m.fill} />
          ))}
        </svg>
        <span>News and notes</span>
      </a>
      <h1 class="art-title font-display">{entry.title}</h1>
      {entry.excerpt && <p class="art-standfirst">{entry.excerpt}</p>}
    </header>

    {/* ------- 2. Cover: wide, the stepped brick corner -------------------- */}
    {coverShot && (
      <div class="art-cover mx-auto max-w-content art-gutter">
        <div class="art-cover__frame shape-step shape-step--lg">
          <ShotRequest shot={coverShot} class="shot--fill" priority />
        </div>
      </div>
    )}
    {entry.coverImage?.asset && !coverShot && (
      <figure class="art-cover mx-auto max-w-content art-gutter">
        <div class="art-cover__frame shape-step shape-step--lg">
          <SanityImage
            source={entry.coverImage}
            width={2000}
            height={1125}
            loading="eager"
            fetchpriority="high"
            sizes="(min-width: 82.5rem) 1280px, 100vw"
          />
        </div>
        {entry.coverImage.caption && (
          <figcaption class="art-cover__caption">{entry.coverImage.caption}</figcaption>
        )}
      </figure>
    )}

    {/* ------- 3. The rail and the body ------------------------------------ */}
    <div class="art-layout mx-auto max-w-content art-gutter">
      <aside class="art-rail" aria-label="About this post">
        <div class="art-rail__inner">
          <dl class="art-meta">
            {dateLabel && (
              <div class="art-meta__item">
                <dt>Posted</dt>
                <dd class="art-meta__date">
                  <time datetime={entry.publishedAt}>{dateLabel}</time>
                </dd>
              </div>
            )}
            {readMinutes > 0 && (
              <div class="art-meta__item">
                <dt>Reading time</dt>
                <dd>{formatReadingTime(readMinutes)}</dd>
              </div>
            )}
            {entry.author && (
              <div class="art-meta__item">
                <dt>Written by</dt>
                <dd>
                  {entry.author}
                  {updatedLabel && <span class="art-meta__note">Updated {updatedLabel}</span>}
                </dd>
              </div>
            )}
          </dl>
          {categories.length > 0 && (
            <ul class="art-cats" role="list">
              {categories.map((cat: any) => (
                <li>
                  <JournalCategoryChip title={cat.title} tooltip={cat.description} />
                </li>
              ))}
            </ul>
          )}
          {hasToc && (
            <div class="art-toc">
              <CaseStudyTOC client:idle headings={headings} />
            </div>
          )}
          {/* Pass it on (card 126): plain share links, no third-party scripts. */}
          <ShareButtons
            title={entry.title ?? title}
            path={`/journal/${slug}/`}
            heading="Share"
            buttonClass="art-share__btn btn-auburn btn-auburn--secondary press-tactile gap-2"
            class="art-share"
          />
        </div>
      </aside>

      <div class="art-body">
        {/* Server-rendered either way. Hydrated (`client:visible`) only when the post has a
            before/after slider, the one part that needs React; the photo viewer is Lightbox below. */}
        {bodyNeedsJs ? (
          <JournalPortableText client:visible value={entry.body} headingIds={headingIds} />
        ) : (
          <JournalPortableText value={entry.body} headingIds={headingIds} />
        )}
        {/* The post's photos open full screen (inline images and galleries). */}
        <Lightbox />

        {entry.relatedProject?.slug?.current && (
          <aside class="mt-section-md border-t border-border-soft pt-l">
            <p class="art-eyebrow">Related project</p>
            <a
              href={`/portfolio/${entry.relatedProject.slug.current}/`}
              class="group inline-flex items-baseline gap-s text-foreground transition-colors hover:text-primary-dark"
            >
              <span class="font-display text-h3">{entry.relatedProject.title}</span>
              <span
                aria-hidden="true"
                class="text-xl transition-transform group-hover:translate-x-1"
              >
                →
              </span>
            </a>
          </aside>
        )}
      </div>
    </div>
  </article>

  {/* ------- 4. More from News and notes ---------------------------------- */}
  {related.length > 0 && (
    <>
      <BoardRule />
      <section class="art-more bg-background" aria-labelledby="art-more-heading">
        <div class="mx-auto max-w-content art-gutter py-section-lg">
          <div class="art-more__head">
            <div>
              <p class="art-eyebrow">Keep reading</p>
              <h2 id="art-more-heading" class="font-display text-h2 auburn-h2 leading-tight">
                More from News and notes
              </h2>
            </div>
            <a class="c-link art-more__all" href="/journal/">
              Everything in News and notes
            </a>
          </div>
          <ul class="art-cards" role="list">
            {related.map((post) => {
              const shot = journalCoverShot(post.coverImage);
              const date = formatDate(post.publishedAt);
              return (
                <li class="art-card shape-card">
                  <div class="art-card__pic shape-step">
                    {shot ? (
                      <ShotRequest shot={shot} inLink class="shot--fill" />
                    ) : post.coverImage?.asset ? (
                      <div class="shape-zoom">
                        <SanityImage
                          source={post.coverImage}
                          width={720}
                          height={540}
                          sizes="(min-width: 64rem) 26rem, (min-width: 40rem) 45vw, 100vw"
                          alt=""
                          quality={70}
                        />
                      </div>
                    ) : (
                      <div class="shape-zoom shape-tile" aria-hidden="true">
                        <Image src={markPrint} alt="" width={240} format="webp" quality={80} />
                      </div>
                    )}
                  </div>
                  {date && (
                    <time class="art-card__date" datetime={post.publishedAt}>
                      {date}
                    </time>
                  )}
                  <h3 class="art-card__title font-display">
                    <a class="art-card__link" href={`/journal/${post.slug?.current}/`}>
                      {post.title}
                    </a>
                  </h3>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    </>
  )}

  {/* ------- 5. Next / previous post -------------------------------------- */}
  {(prev || next) && (
    <nav class="border-t border-border-soft bg-background" aria-label="Newer and older posts">
      <div class="mx-auto grid max-w-content grid-cols-1 gap-m px-m py-l md:grid-cols-2">
        {prev ? (
          <a href={`/journal/${prev.slug}/`} class="group">
            <p class="art-eyebrow">Newer post</p>
            <p class="font-display text-h4 text-foreground transition-colors group-hover:text-primary-dark">
              ← {prev.title}
            </p>
          </a>
        ) : (
          <div />
        )}
        {next ? (
          <a href={`/journal/${next.slug}/`} class="group md:text-right">
            <p class="art-eyebrow">Older post</p>
            <p class="font-display text-h4 text-foreground transition-colors group-hover:text-primary-dark">
              {next.title} →
            </p>
          </a>
        ) : (
          <div />
        )}
      </div>
    </nav>
  )}

  {/* ------- 6. Final CTA -------------------------------------------------- */}
  {/* The same closing call-to-action as the News and notes page (Studio: Journal page > Final
      CTA), with church wording when it is empty. It was the starter's studio sales copy. */}
  <FinalCta
    headline={journalPage?.finalCtaHeadline || 'Come and see on a Sunday'}
    subhead={
      journalPage?.finalCtaSubhead ||
      'We would love to meet you. Plan your visit, or ask us anything first.'
    }
    cta={journalPage?.finalCta}
    scriptAccent={journalPage?.finalCtaScriptAccent}
    backgroundImage={journalPage?.finalCtaBackgroundImage}
  />

  {/* Sticky contextual CTA — appears past 50% scroll on long posts.
      Label is Sanity-editable on journalPage; clearing the field hides the
      chip across every journal post. */}
  {journalPage?.stickyCtaLabel !== '' && (
    <StickyCTAChip
      client:idle
      label={journalPage?.stickyCtaLabel ?? 'Got a question?'}
      href="/contact/"
    />
  )}
</BaseLayout>
