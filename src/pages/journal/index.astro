---
// scaffold-file: journal
// Safe to edit by hand for copy + structure changes.
// News and notes (the journal index): section-driven via pageBuilder (2026-10-26, every main page
// a page builder). Edit sections and order in Sanity Studio under the News and notes document,
// Page layout. The posts are the "News and notes posts" block
// (src/components/sections/JournalPosts.astro): category chips, the post grid (the first featured
// post gets the big card) and the newsletter sign-up. When pageBuilder is empty (no Sanity
// project or unmigrated), DEFAULT_JOURNAL_SECTIONS renders so the page is never blank.

import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { getJournalPage, getSiteSettings } from '@/lib/queries';
import { getSectionVisibility } from '@/lib/sectionVisibility';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import { DEFAULT_JOURNAL_SECTIONS } from '@/data/defaultSections';

const [page, siteSettings] = await Promise.all([getJournalPage(), getSiteSettings()]);

// Section visibility guard.
const visible = getSectionVisibility(siteSettings?.sectionVisibility);
if (!visible.journal) return Astro.redirect('/');

const title = page?.seoTitle ?? `News and notes · ${site.name}`;
const description =
  page?.seoDescription ??
  'News, sermon notes and stories from the church family at First Baptist Church of Auburn.';

const sections = page?.pageBuilder?.length ? page.pageBuilder : DEFAULT_JOURNAL_SECTIONS;
// The share card's small line: the opening banner's eyebrow.
const kicker =
  (sections as { _type?: string; eyebrow?: string }[]).find((s) => s?._type === 'heroSection')
    ?.eyebrow || 'From the church';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'News and notes', url: `${site.url}/journal/` },
  ]),
];
---

<BaseLayout
  {title}
  {description}
  {schemas}
  {siteSettings}
  seoImage={page?.seoImage}
  ogCard={{ kicker }}
>
  <SectionRenderer {sections} idPrefix="journal" leadImage />
</BaseLayout>
