import { addDays, churchNow } from '@/lib/church-facts';

/** A church day `n` days from the build (negative: before it). */
const SOON = (n: number) => addDays(churchNow(churchDataNow()).date, n);

const image = (alt = 'Fixture image') => ({
  _type: 'image',
  alt,
  asset: {
    _type: 'reference',
    _ref: 'image-0123456789abcdef0123456789abcdef01234567-1600x900-jpg',
  },
});

const para = (key: string, text: string) => ({
  _type: 'block',
  _key: key,
  style: 'normal',
  markDefs: [],
  children: [{ _type: 'span', _key: `${key}-s`, marks: [], text }],
});

const cta = (label: string) => ({
  _type: 'ctaBlock',
  label,
  linkType: 'external',
  externalUrl: '#',
});

// A small countdown, the kind of thing an editor asks an AI for (card 121).
// Static numbers so the thumbnail does not change from day to day; it uses the
// variables the frame's base stylesheet provides (src/lib/custom-code.ts).
const COUNTDOWN = `<div class="count">
  <p class="label">Vacation Bible School starts in</p>
  <div class="row">
    <div><b>12</b><span>days</span></div>
    <div><b>06</b><span>hours</span></div>
    <div><b>30</b><span>minutes</span></div>
  </div>
</div>
<style>
  .count { text-align: center; padding: 1.5rem 1rem; }
  .label { margin: 0 0 1rem; color: var(--muted-foreground); }
  .row { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .row div { min-width: 5.5rem; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius); background: #fff; }
  .row b { display: block; font-family: var(--font-display); font-size: 2.5rem; line-height: 1; color: var(--primary); }
  .row span { font-size: 0.875rem; color: var(--muted-foreground); }
</style>`;

// Isolation probes for tests/custom-code.spec.ts (card 121). NOT on the wall
// (no data-section-type), so they are never shot as thumbnails. The boxed probe
// tries to read the page, the site's storage and cookies, and to mark the
// page's <body>; the on-page probe shows what the switch gives up.
const BOXED_PROBE = `<p id="probe">waiting</p>
<script>
  var out = [];
  try { out.push('parent-dom:' + (parent.document.body ? 'READ' : 'none')); } catch (e) { out.push('parent-dom:blocked'); }
  try { parent.document.body.setAttribute('data-custom-code-escaped', 'yes'); } catch (e) {}
  try { out.push('storage:' + (localStorage.getItem('custom-code-secret') === null ? 'empty' : 'READ')); } catch (e) { out.push('storage:blocked'); }
  try { out.push('cookie:' + (document.cookie ? 'READ' : 'empty')); } catch (e) { out.push('cookie:blocked'); }
  document.getElementById('probe').textContent = 'ran ' + out.join(' ');
</script>`;

const ON_PAGE_PROBE = `<p data-on-page-probe>waiting</p>
<script>
  document.querySelector('[data-on-page-probe]').textContent =
    'on page: ' + (localStorage.getItem('custom-code-secret') || 'nothing stored');
</script>`;

