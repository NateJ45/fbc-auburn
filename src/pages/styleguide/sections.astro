        _type: 'textColumn',
        heading: 'Sundays',
        body: [para('c1p', 'A few sentences in the first column.')],
      },
      {
        _key: 'c2',
        _type: 'textColumn',
        heading: 'Wednesdays',
        body: [para('c2p', 'A few sentences in the second column.')],
      },
      {
        _key: 'c3',
        _type: 'textColumn',
        heading: 'Through the year',
        body: [para('c3p', 'A few sentences in the third column.')],
      },
    ],
  },
  {
    _type: 'photoSection',
    _key: 'cb-photo',
    image: image('The congregation outside after worship'),
    caption: 'A caption under the photo.',
  },
  { _type: 'formSection', _key: 'cb-form', form: FIXTURE_FORMS['fixture-signup'] },
  // Church Trac (docs/agent/church-trac.md): a made-up form address, and fbcm's saved newsletter page
  // (drawn from tests/fixtures under CHURCH_TRAC_PAGES_FIXTURE=1; otherwise the band's empty state).
  {
    _type: 'churchTracFormSection',
    _key: 'cb-ct-form',
    heading: 'Tell us you are coming',
    intro: 'A form from Church Trac, in the site’s own frame.',
    embed: '<iframe src="https://example.churchtrac.com/connectcard"></iframe>',
    size: 'short',
  },
  {
    _type: 'churchTracPageSection',
    _key: 'cb-ct-page',
    heading: 'This week’s bulletin',
    page: 'children',
  },
  // The email backbone (card 127): the made-up event in mail-fixtures.ts.
  { ...FIXTURE_RSVP_BLOCK, _type: 'rsvpSection' },
];
---

<BaseLayout
  title={`Sections wall | ${site.name}`}
  description="Fixed-data wall of every page-builder section. Not for visitors."
  noindex
>
  {SECTIONS.map((section) => (
    <div data-section-type={String(section._type)}>
      <SectionRenderer sections={[section]} idPrefix={`fx-${String(section._key)}`} />
    </div>
  ))}
  <div data-custom-code-checks>
    <SectionRenderer sections={CODE_CHECKS} idPrefix="fx-code" />
  </div>
</BaseLayout>
