// Foundation, edit with care
//
// THE SECTIONS WALL: one of every page-builder block, rendered through the real
// SectionRenderer with FIXED data (the authoring kit, PORTS.md card 109).
//
// WHAT IT IS FOR. `npm run thumbnails` (scripts/shoot-section-thumbnails.mjs)
// shoots each `[data-section-type]` box below into
// public/section-thumbnails/<type>.jpg, and those pictures are what the
// "+ Add item" menu's grid view shows in the Studio. So the picture an editor
// picks from is the block as this site actually draws it, in this site's
// brand, not a generic drawing. Re-run the script after a reskin.
//
// src/lib/authoring.test.ts fails if a block type in sections.ts,
// richSections.ts or FBC Auburn's auburnSections.ts / auburnMotionSections.ts has no fixture here (it looks for `_type: '<name>'`) or no
// picture on disk, so a new block cannot ship without a thumbnail.
//
// Fixed data on purpose (see styleguide.astro). Collection-fed blocks get their
// collection rows inline, already in the shape the GROQ projection produces.
// The images are fake Sanity references; the script answers the CDN request
// with a local fixture, so no network is needed. NOT shot by the visual suite,
// and like the other walls: noindex, out of the sitemap ('/styleguide' is
// filtered in astro.config.mjs) and under a reserved slug.

import BaseLayout from '@/layouts/BaseLayout.astro';
