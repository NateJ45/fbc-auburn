---
// Safe to edit by hand
// "On this page" (2026-11-21, the inner-page rhythm pass): an index of a long page's H2s, worked
// out at build time by src/lib/page-index.ts (rule 13). SectionRenderer draws it on pages that ask
// for it (`pageIndex`) once there are five or more H2s.
//
//   From 1024px: a slim rail fixed in the left gutter, one short line per heading; the line of the
//   section you are reading is longer and auburn. Hover it, or Tab into it, and it opens into a
//   white card with the headings written out. The words are always in the links (clipped, never
//   removed), so a screen reader hears the full list and keyboard focus works the same.
//   Phones and tablets: a small "On this page" disclosure under the page head (a real
//   <details>), closed by default; a tap on a link closes it.
//
// The rail sits inside <main>, whose view-transition name makes it a layer of its own, so at the
// foot of the page the footer slides over it rather than the rail floating on the footer.
// The script marks the current heading (aria-current="location") with one IntersectionObserver
// (plus a once-a-frame scroll check for jumps the observer cannot see),
// re-armed on every astro:page-load and dropped on astro:before-swap. It also takes out any link
// whose target is missing or is not an H2, and hides both lists if fewer than five are left. No
// script: both lists still work as plain anchor links. Scrolling is the browser's own (rule 5).
import { INDEX_MIN, type IndexEntry } from '@/lib/page-index';

interface Props {
  entries: IndexEntry[];
}
const { entries } = Astro.props;
---

{entries.length >= INDEX_MIN && (
  <>
    <nav class="otp" aria-label="On this page" data-otp data-flow="off">
      <p class="otp__title">On this page</p>
      <ol class="otp__list" role="list">
        {entries.map((e) => (
          <li>
            <a class="otp__link" href={`#${e.id}`} data-otp-link={e.id}>
              <span class="otp__tick" aria-hidden="true" />
              <span class="otp__text">{e.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
    <div class="otp-m-wrap" data-otp data-flow="off">
      <details class="otp-m">
        <summary class="otp-m__summary">On this page</summary>
        <nav aria-label="On this page">
          <ol class="otp-m__list" role="list">
            {entries.map((e) => (
              <li>
                <a class="otp-m__link" href={`#${e.id}`} data-otp-link={e.id}>
                  {e.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
    </div>
  </>
)}

<style>
  /* ---- Phones and tablets: the disclosure -------------------------------------------------- */
  .otp-m-wrap {
    max-width: var(--container-content);
    margin-inline: auto;
    padding: 8px var(--board-gutter, 20px) 0;
  }
  .otp-m {
    border: 1px solid var(--border);
    border-radius: var(--radius-card, 20px);
    background: var(--card);
  }
  .otp-m__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 48px;
    padding: 0 18px;
    font-weight: 600;
    color: var(--heading-solid);
    cursor: pointer;
    list-style: none;
  }
  .otp-m__summary::-webkit-details-marker {
    display: none;
  }
  .otp-m__summary::after {
    content: '';
    width: 9px;
    height: 9px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 200ms ease;
  }
  .otp-m[open] > .otp-m__summary::after {
    transform: translateY(2px) rotate(-135deg);
  }
  .otp-m__summary:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
    border-radius: var(--radius-card, 20px);
  }
  .otp-m__list {
    margin: 0;
    padding: 0 18px 14px;
    list-style: none;
  }
  .otp-m__link {
    display: block;
    padding: 10px 0;
    border-top: 1px solid var(--border);
    color: var(--link);
    text-decoration: none;
  }
  .otp-m__link[aria-current='location'] {
    font-weight: 600;
    color: var(--heading-solid);
  }
  .otp-m__link:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  /* ---- From 1024px: the rail ---------------------------------------------------------------- */
  .otp {
    display: none;
  }
  @media (width >= 64rem) {
    .otp-m-wrap {
      display: none;
    }
    .otp {
      position: fixed;
      z-index: 30;
      top: 50%;
      left: 6px;
      display: block;
      max-height: 70vh;
      padding: 10px 8px;
      overflow-y: auto;
      border-radius: var(--radius-inner);
      background: rgb(255 255 255 / 0.82);
      box-shadow: var(--shadow-card);
      transform: translateY(-50%);
      transition:
        width 220ms ease,
        background-color 220ms ease,
        box-shadow 220ms ease;
      width: 30px;
    }
    .otp__title {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .otp__list {
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .otp__link {
      display: flex;
      align-items: center;
      gap: 12px;
      min-height: 20px;
      padding: 3px 0;
      color: var(--foreground);
      text-decoration: none;
      border-radius: var(--radius-tag);
    }
    .otp__tick {
      flex: none;
      width: 10px;
      height: 2px;
      margin-left: 2px;
      border-radius: 2px;
      background: rgb(31 58 95 / 0.45);
      transition:
        width 200ms ease,
        background-color 200ms ease;
    }
    .otp__link[aria-current='location'] .otp__tick {
      width: 14px;
      background: var(--auburn-red, #9a3b2a);
    }
    /* Collapsed, the words are clipped away but still read out. */
    .otp__text {
      overflow: hidden;
      clip-path: inset(0 100% 0 0);
      white-space: nowrap;
      font-size: 0.9375rem;
      line-height: 1.3;
      opacity: 0;
      transition: opacity 160ms ease;
    }
    .otp:is(:hover, :focus-within) {
      width: min(19rem, calc(100vw - 32px));
      padding: 14px 16px 14px 8px;
      background: #ffffff;
      box-shadow: var(--shadow-raised);
    }
    .otp:is(:hover, :focus-within) .otp__title {
      position: static;
      width: auto;
      height: auto;
      margin: 0 0 8px 2px;
      clip-path: none;
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--muted-foreground);
    }
    .otp:is(:hover, :focus-within) .otp__text {
      clip-path: none;
      white-space: normal;
      opacity: 1;
    }
    .otp__link:hover .otp__text,
    .otp__link[aria-current='location'] .otp__text {
      color: var(--heading-solid);
    }
    .otp__link[aria-current='location'] .otp__text {
      font-weight: 600;
    }
    .otp__link:focus-visible {
      outline: 2px solid var(--ring);
      outline-offset: 2px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .otp,
    .otp__tick,
    .otp__text,
    .otp-m__summary::after {
      transition: none;
    }
  }
  @media print {
    .otp,
    .otp-m-wrap {
      display: none;
    }
  }
</style>

<script>
  import { INDEX_MIN } from '@/lib/page-index';

  let observer: IntersectionObserver | null = null;
  let onScroll: (() => void) | null = null;

  function stop() {
    observer?.disconnect();
    observer = null;
    if (onScroll) window.removeEventListener('scroll', onScroll);
    onScroll = null;
  }

  function init() {
    stop();
    const lists = [...document.querySelectorAll<HTMLElement>('[data-otp]')];
    if (lists.length === 0) return;

    // Keep only links whose target is an H2 on the page.
    const ids = new Set<string>();
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-otp-link]')) {
      const id = link.dataset.otpLink ?? '';
      const target = document.getElementById(id);
      if (target?.tagName === 'H2') ids.add(id);
      else link.closest('li')?.remove();
    }
    if (ids.size < INDEX_MIN) {
      for (const l of lists) l.style.display = 'none';
      return;
    }
    const targets = [...ids].map((id) => document.getElementById(id) as HTMLElement);
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-otp-link]')];

    // The current heading: the last one whose top has passed 30% of the way down the screen.
    let current = '';
    const mark = () => {
      const line = window.innerHeight * 0.3;
      let id = '';
      for (const t of targets) {
        if (t.getBoundingClientRect().top <= line) id = t.id;
        else break;
      }
      if (id === current) return;
      current = id;
      for (const a of links) {
        if (a.dataset.otpLink === id) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      }
    };
    observer = new IntersectionObserver(mark, { rootMargin: '0px 0px -70% 0px', threshold: 0 });
    for (const t of targets) observer.observe(t);
    mark();
    // A jump (an anchor link, Home or End, the scrollbar dragged) can carry every heading past the
    // line without one of them changing sides of the observer's box, so the observer never
    // fires. One passive scroll listener, at most once a frame, catches those.
    let queued = false;
    onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        mark();
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    // A tap in the phone list closes it, so the section is not hidden under the open list.
    for (const a of document.querySelectorAll<HTMLAnchorElement>('.otp-m__link')) {
      a.addEventListener('click', () => a.closest('details')?.removeAttribute('open'));
    }
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', stop);
</script>
