---
// Safe to edit by hand
// Sunday's weather for Plan your visit: one quiet line, e.g. "Sunday: 58°,
// light rain." The words and every decision are src/lib/sunday-weather.ts
// (ported from First Baptist Muncie); this file is the markup and the few
// lines that fetch.
//
// RUN TIME, LAZY, NEVER IN THE WAY. Nothing is fetched at build: the visitor's
// browser reads api.weather.gov (free, no key, CORS open) once, when idle
// after load, and only from Wednesday to Sunday noon, church time. Any failure
// (offline, a status, an answer with no Sunday in it) leaves the line hidden.
// It does not touch LCP: the request starts after the load event.
//
// NO LAYOUT SHIFT. The line is `hidden` in the markup, so it reserves no
// space, and the script shows it only while its place is NOT on screen. A
// visitor already looking at the spot when the answer lands simply does not
// get the line (a shift in view is worse than a missing forecast).
//
// RESERVE MODE (`reserve`, Home's This Sunday card, board E). The caller's CSS keeps one line of
// room for it (see .hb-sunday .sunday-weather in home-board.css), so nothing can move and the line
// is shown even while it is on screen. Outside the window the room simply stays empty.

interface Props {
  /** The caller reserves the line's room, so show it even while on screen. */
  reserve?: boolean;
  class?: string;
}

const { reserve = false, class: className = '' } = Astro.props;
---

<div
  class:list={['sunday-weather', className]}
  data-sunday-weather
  data-reserve={reserve ? '' : undefined}
>
  <p class="sunday-weather__line" hidden>
    <span data-sunday-weather-text></span>
  </p>
</div>

<script>
  import {
    NWS_FORECAST_URL,
    inWeatherWindow,
    sundayPeriod,
    weatherSentence,
  } from '@/lib/sunday-weather';

  const run = async () => {
    const box = document.querySelector<HTMLElement>('[data-sunday-weather]');
    const line = box?.querySelector<HTMLElement>('.sunday-weather__line');
    const text = box?.querySelector<HTMLElement>('[data-sunday-weather-text]');
    if (!box || !line || !text || !line.hidden) return;
    if (!inWeatherWindow(new Date())) return;
    try {
      const res = await fetch(NWS_FORECAST_URL, { headers: { Accept: 'application/geo+json' } });
      if (!res.ok) return;
      const data: unknown = await res.json();
      const periods = (data as { properties?: { periods?: unknown } } | null)?.properties?.periods;
      const sentence = weatherSentence(sundayPeriod(periods, new Date()));
      if (!sentence) return;
      const top = box.getBoundingClientRect().top;
      const reserved = box.hasAttribute('data-reserve');
      if (!reserved && top >= 0 && top < window.innerHeight) return; // in view: no shift, no line
      text.textContent = sentence;
      line.hidden = false;
    } catch {
      // Offline, blocked or malformed: the line stays hidden.
    }
  };

  const start = () => {
    if ('requestIdleCallback' in window) window.requestIdleCallback(() => void run());
    else setTimeout(() => void run(), 200);
  };
  // First load (after the load event, so the forecast never competes with the
  // page), and again after every view-transition navigation. run() is a no-op
  // on a page without the line, or once it is showing.
  const schedule = () => {
    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start, { once: true });
  };
  schedule();
  document.addEventListener('astro:after-swap', schedule);
</script>

<style>
  .sunday-weather__line {
    margin: 0.75rem 0 0;
    color: var(--foreground);
    font-size: var(--fs-body);
  }
</style>
