---
// Safe to edit by hand
// The Sunday times band (2026-10-24, from the hppres.org audit): a pale stone panel across the
// bottom of an inner page head, starting a third of the way in and running off the right edge of
// the window, so the most-asked fact sits on the first screen without crowding the title.
// On a wide screen: "Sundays at Auburn", then one column per Sunday gathering (the time big, what
// it is in small caps), then the address and Directions. On a phone it folds into one bar, the
// times and "Directions", and the whole bar opens the map.
// Everything comes from Site settings > Church facts (never typed here); a time not yet confirmed
// carries the "To confirm" tag. Switched on per page by the page head's "Show the Sunday times
// band" box (heroSection.showTimes), drawn by BoardPageHead.
import NotConfirmed from './NotConfirmed.astro';
import SundayChange from './SundayChange.astro';
import { getChurchFacts } from '@/lib/church-data';
import { namedTimes, sundayLineServices } from '@/lib/church-facts';
import { churchDataNow } from '@/lib/church-feeds';

const facts = await getChurchFacts();
// A different Sunday (2026-10-26): the coming Sunday's times when it is changed, with the change
// in a line under them; the usual ones otherwise.
const regular = facts.serviceTimes.filter((t) => t.dayIndex === 0);
const { services: sundays, sunday } = sundayLineServices(facts, churchDataNow());
const address = facts.address;
const confirmed = sundays.every((t) => t.confirmed);
// The phone bar's line, each time named (re-audit 2026-10-26): "Sunday School 9:45 · Worship 11:00".
const short = namedTimes(sundays);
---

{regular.length > 0 && (
  <div class="times-band-wrap">
    <aside class="times-band" aria-label="Sunday times">
      <div class="times-band__wide">
        <p class="times-band__title">
          {sunday?.changed ? (sunday.isToday ? 'Today' : 'This Sunday') : 'Sundays'}
          <br />
          at Auburn
          {!confirmed && <NotConfirmed confirmed={false} class="times-band__tag" />}
        </p>
        <ul role="list" class="times-band__times">
          {sundays.map((t) => (
            <li>
              <span class="times-band__time">{t.timeLabel}</span>
              <span class="times-band__what">{t.label}</span>
              {t.note && <span class="times-band__note">{t.note}</span>}
            </li>
          ))}
        </ul>
        <SundayChange sunday={sunday} class="times-band__change" />
        {address && (
          <p class="times-band__where">
            {address.lines.map((l) => (
              <span>{l}</span>
            ))}
            <span class="times-band__maps">
              <a
                href={address.mapsUrl}
                class="times-band__directions"
                rel="noopener"
                target="_blank"
              >
                Directions <span aria-hidden="true">→</span>
                <span class="sr-only"> (opens Google Maps in a new tab)</span>
              </a>
              <a
                href={address.appleMapsUrl}
                class="times-band__directions"
                rel="noopener"
                target="_blank"
              >
                Apple Maps<span class="sr-only"> (opens in a new tab)</span>
              </a>
            </span>
          </p>
        )}
      </div>
      {/* Phones and tablets (re-audit 2026-10-26): the times, then the address with Directions and
          Apple Maps right under them, so a first-timer in the car has the where on the first
          screen, not at the foot of the page. */}
      <div class="times-band__bar">
        <p class="times-band__bar-times">
          {short}
          {!confirmed && <NotConfirmed confirmed={false} class="times-band__bar-tag" />}
        </p>
        <SundayChange sunday={sunday} size="compact" />
        {address ? (
          <>
            <p class="times-band__bar-where">{address.oneLine}</p>
            <p class="times-band__bar-links">
              <a href={address.mapsUrl} rel="noopener" target="_blank">
                Directions<span class="sr-only"> (opens Google Maps in a new tab)</span>
              </a>
              <a href={address.appleMapsUrl} rel="noopener" target="_blank">
                Apple Maps<span class="sr-only"> (opens in a new tab)</span>
              </a>
            </p>
          </>
        ) : (
          <p class="times-band__bar-links">
            <a href="/plan-your-visit/">Plan your visit</a>
          </p>
        )}
      </div>
    </aside>
  </div>
)}

<style>
  .times-band-wrap {
    max-width: var(--container-content);
    margin-inline: auto;
    padding-inline: var(--board-gutter, 1.25rem);
  }
  .times-band {
    position: relative;
    /* A flat pale sky, so the times read cleanly; a brick-red course along the top edge. */
    background: #e9eef5;
    border-top: 4px solid var(--auburn-red);
    /* The panel is always pale, so its words keep the light theme's colours whatever the stored
       preference (axe in dark mode, 2026-10-25: pale text on the pale panel). */
    --foreground: #16263d;
    --muted-foreground: #4a5a73;
    --heading-solid: #1f3a5f;
    --link: #1f3a5f;
    color: var(--heading-solid);
  }
  /* Wide: from a third of the way in out to the right edge of the window. */
  @media (min-width: 64rem) {
    .times-band {
      margin-left: 30%;
      margin-right: calc(50% - 50vw);
      margin-top: -1.5rem;
    }
  }
  .times-band__wide {
    display: none;
  }
  @media (min-width: 64rem) {
    .times-band__wide {
      display: grid;
      /* The address column gets room for two lines (re-audit 2026-10-26: it was squeezed to three). */
      grid-template-columns: auto auto minmax(15rem, 1fr);
      align-items: start;
      gap: 2rem;
      padding: 2.25rem 2.5rem;
      max-width: calc(var(--container-content) * 0.78);
    }
  }
  /* A different Sunday: the change line runs under the whole row. */
  .times-band__wide :global(.times-band__change) {
    grid-column: 1 / -1;
    margin: -0.75rem 0 0;
  }
  .times-band__title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1.1;
  }
  .times-band__times {
    display: flex;
    gap: 2.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .times-band__times li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .times-band__time {
    font-family: var(--font-display);
    font-size: 2.1rem;
    line-height: 1;
  }
  .times-band__what {
    font-size: var(--fs-tag);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    max-width: 12rem;
  }
  .times-band__note {
    font-size: var(--fs-small);
    color: var(--muted-foreground);
  }
  .times-band__where {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    line-height: 1.45;
    color: var(--foreground);
  }
  /* The band is always the pale panel (#e9eef5), so its link is the light theme's navy, not the
     --link token: in the stored dark preference --link turns pale and the arrow fell to 2.54:1. */
  .times-band__directions {
    margin-top: 0.4rem;
    font-weight: 600;
    color: #1f3a5f;
  }
  .times-band__bar-tag {
    margin-left: 0.5rem;
    vertical-align: middle;
  }
  @media (min-width: 64rem) {
    .times-band__tag {
      display: table;
      margin-top: 0.75rem;
    }
  }
  /* Phone and tablet: the times, then the address and the two map links (re-audit 2026-10-26). */
  .times-band__bar {
    display: grid;
    gap: 0.35rem;
    padding: 0.9rem 1.1rem 0.75rem;
  }
  .times-band__bar p {
    margin: 0;
  }
  .times-band__bar-times {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.3;
    color: var(--heading-solid);
  }
  .times-band__bar-where {
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--foreground);
  }
  .times-band__bar-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }
  .times-band__bar-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--fs-small);
    font-weight: 600;
    color: #1f3a5f;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .times-band__maps {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }
  @media (min-width: 64rem) {
    .times-band__bar {
      display: none;
    }
  }
</style>
