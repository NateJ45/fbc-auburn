---
// Safe to edit by hand
// The picture for a sermon or a series, in the one 16:9 frame with 14px corners: the sermon's own
// picture, else its series' picture, else the YouTube thumbnail, else the stones (three gold steps
// from the mark on a stone ground) with the series' book or title in cream Young Serif, so a sermon
// with no picture at all looks like series art, not a missing picture (block polish, 2026-10-18):
//   - the ground is one of three stone tiles (navy, deep sky, green; scripts/gen-stones.mjs), picked
//     from the words, so every sermon in a series shares its series' colour and neighbours differ;
//   - the word is plain type (it was cut out of a brick wall until 2026-10-24, dropped as too busy);
//   - the size follows the word's length (a container unit), so Mark and Lamentations both fill it.
// `play` adds the round play button (a link around it is the caller's). Decorative: the words beside it carry the meaning, so alt is empty.
import SanityImage from '@/components/SanityImage.astro';
import PlayMark from './PlayMark.astro';
import { MARKER } from '@/components/home/stones.generated';
import { sermonVideo, type SermonDoc } from '@/lib/sermons';
import type { SanityImageObject } from '@/lib/pageBuilder.types';

interface Props {
  sermon?: SermonDoc | null;
  /** A series card passes its art here (and no sermon). */
  art?: unknown;
  /** The words on the stones when there is no picture. */
  word?: string | null;
  /** What picks the ground: the series title, so a series card and its sermons match. */
  seed?: string | null;
  play?: boolean;
  width?: number;
  sizes?: string;
  loading?: 'lazy' | 'eager';
}
const {
  sermon,
  art,
  word,
  seed,
  play = false,
  width = 720,
  sizes = '(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 100vw',
  loading = 'lazy',
} = Astro.props;
const picked = [sermon?.image, sermon?.series?.art, art].find(
  (img) => (img as { asset?: unknown } | null | undefined)?.asset,
) as SanityImageObject | undefined;
const thumb = !picked ? sermonVideo(sermon?.videoUrl)?.thumbnailUrl : undefined;
const blankWord = (word ?? sermon?.series?.title ?? '').trim();
const GROUNDS = ['navy', 'deep', 'green'] as const;
const hash = [...(seed ?? sermon?.series?.title ?? blankWord)].reduce(
  (h, c) => (h * 31 + c.charCodeAt(0)) >>> 0,
  9,
);
const ground = GROUNDS[hash % GROUNDS.length];
// The longest word decides the size (Young Serif is about 0.6em a letter, so 112 / letters
// fills about three quarters of the width); a title of several words is set smaller so it fits on two
// or three lines under the steps.
const words = blankWord.split(/\s+/).filter(Boolean);
const longest = Math.max(4, ...words.map((w) => w.length));
const size = Math.max(7, Math.min(22, Math.round((words.length > 1 ? 74 : 112) / longest)));
---

{picked ? (
  <span class="c-art">
    <SanityImage
      source={picked}
      width={width}
      height={Math.round((width * 9) / 16)}
      sizes={sizes}
      alt=""
      quality={70}
      loading={loading}
    />
    {play && <PlayMark />}
  </span>
) : thumb ? (
  <span class="c-art">
    <img
      src={thumb}
      alt=""
      width="480"
      height="360"
      loading={loading}
      decoding="async"
      referrerpolicy="no-referrer"
    />
    {play && <PlayMark />}
  </span>
) : (
  <span class:list={['c-art c-art--blank', `c-art--${ground}`]} aria-hidden="true">
    <svg viewBox="0 0 78 36" width="78" height="36" focusable="false">
      {MARKER.map((s) => (
        <path d={s.d} fill={s.fill} />
      ))}
    </svg>
    {blankWord && (
      <span class="c-art__word" style={`--word: ${size}cqi`}>
        {blankWord}
      </span>
    )}
    {play && <PlayMark />}
  </span>
)}
