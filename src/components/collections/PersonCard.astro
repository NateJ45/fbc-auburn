---
// Safe to edit by hand
// One person on the people list (shape system, 2026-10-24): a 4:5 portrait cut with the stepped
// brick corner (.shape-step, src/styles/shapes.css), every face framed the same way (object-position
// centre, a third down, so heads line up across a row). Someone with no photo gets the same shape
// in warm printed brick with the church's mark (.shape-tile), so a grid never breaks. Then the
// name in Young Serif, the role in small caps grey, a few sentences, and the email or the place
// they serve only when the Studio says so (the GROQ leaves them out otherwise;
// src/lib/collection-arms.ts). Docs: docs/agent/shapes.md ("People").
import '@/styles/shapes.css';
import { Image } from 'astro:assets';
import SanityImage from '@/components/SanityImage.astro';
import markPrint from '@/assets/brand/mark-print.png';
import type { PersonDoc } from '@/lib/sermons';
import type { SanityImageObject } from '@/lib/pageBuilder.types';

interface Props {
  person: PersonDoc;
  showBio?: boolean;
  as?: 'h3' | 'h4';
}
const { person: p, showBio = true, as: Name = 'h3' } = Astro.props;
const photo = (p.photo as SanityImageObject | null)?.asset ? (p.photo as SanityImageObject) : null;
---

<li class="c-person">
  {photo ? (
    <div class="c-photo shape-step">
      <SanityImage
        source={photo}
        width={480}
        height={600}
        sizes="(min-width: 64rem) 20vw, (min-width: 40rem) 40vw, 90vw"
        alt={photo.alt || (p.name ?? '')}
        quality={75}
      />
    </div>
  ) : (
    <div class="c-photo c-photo--blank shape-step shape-tile" aria-hidden="true">
      <Image src={markPrint} alt="" width={240} format="webp" quality={80} />
    </div>
  )}
  <Name class="c-person__name">{p.name}</Name>
  {p.role && <p class="c-person__role">{p.role}</p>}
  {showBio && p.bio && <p class="c-person__bio">{p.bio}</p>}
  {p.location && <p class="c-person__line">Serving in {p.location}</p>}
  {p.email && (
    <p class="c-person__line">
      <a class="c-link" href={`mailto:${p.email}`}>
        {p.email}
      </a>
    </p>
  )}
</li>
