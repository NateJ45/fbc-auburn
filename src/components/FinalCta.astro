---
// Safe to edit by hand
// The full-bleed call-to-action section that closes every interior page (and the home page).
// Charcoal Dark panel with editorial headline, optional subhead, and a Bronze CTA pill.
// FBC Auburn: with no background photo it is the light close from the mockups (soft ground, the
// stone mark above the headline, red button); with a photo it keeps the dark scrimmed panel.
//
// scriptAccent: optional single word/phrase from the headline to render in handwritten
// the script accent font via the `.font-script` utility. Inherits the heading color (text-bg) so
// it reads correctly on the Charcoal Dark surface in both light and dark theme.
// Falls back silently when undefined, blank, or not found. No existing CTA is affected.

import CtaLink from '@/components/CtaLink.astro';
import SanityImage from '@/components/SanityImage.astro';
import { splitHeadingAccent } from '@/lib/heading-accent';
import { hasInlineRich } from '@/lib/inline-rich';
import InlineRich from '@/components/InlineRich.astro';
import type { SanityImageObject } from '@/lib/pageBuilder.types';
import { getImage } from 'astro:assets';
import markLight from '@/assets/brand/fbc-auburn-icon-full-color.svg';

interface CtaBlock {
  label?: string;
  linkType?: 'internal' | 'external' | 'email' | 'phone';
  internalLink?: { _type?: string; slug?: string } | null;
  externalUrl?: string;
  emailAddress?: string;
  phoneNumber?: string;
  openInNewTab?: boolean;
}

interface Props {
  /** Optional eyebrow label above the headline (e.g., "Ready to Begin?"). */
  eyebrow?: string;
  headline?: string;
  subhead?: string;
  cta?: CtaBlock | null;
  /** Optional secondary CTA rendered as an outlined inverse button next to the primary. */
  secondaryCta?: CtaBlock | null;
  /** Override the default heading id (defaults to "final-cta"). */
  headingId?: string;
  /** Fallback CTA label when cta.label isn't set. */
  fallbackCtaLabel?: string;
  /**
   * Optional single word/phrase from the headline to render in handwritten
   * the script accent font. Matched case-insensitively against the headline,
   * first occurrence only. Leave
   * blank to skip. Use sparingly, one accent per heading. The script word
   * inherits the heading color (text-bg / cream) so contrast is correct on
   * the Charcoal Dark surface in both themes.
   */
  scriptAccent?: string;
  /**
   * The COLOUR sibling of the script accent (PORTS.md card 26). One word from
   * the headline, set in the section accent. Skipped when a script accent is
   * already in play: one accent per heading. On this panel the accent is pinned
   * by `.bg-accent-dark` in globals.css, because the band is the same near-black
   * whatever theme the reader is in.
   */
  headingAccent?: string;
  /** Optional rich twin of `subhead`: bold and italic only. */
  subheadRich?: unknown;
  /**
   * Optional decorative background photo. When set, it fills the panel behind a
   * fixed charcoal scrim that keeps the cream headline and bronze button
   * readable. When absent, the panel renders as the solid Charcoal Dark surface,
   * exactly as before. The shape matches what SanityImage accepts.
   */
  backgroundImage?: SanityImageObject | null;
}

const {
  eyebrow,
  headline = 'We would love to meet you this Sunday.',
  subhead = 'Tell us you are coming, or ask anything at all.',
  cta,
  secondaryCta,
  headingId = 'final-cta',
  fallbackCtaLabel = 'Plan your visit',
  scriptAccent,
  headingAccent,
  subheadRich,
  backgroundImage,
} = Astro.props as Props;

// Only treat the background as present when a real asset is attached, so an
// empty image object never flips on the overlay path.
const hasBackground = !!backgroundImage?.asset;

// Split the headline around the script-accent word when provided. Both accent
// devices go through splitHeadingAccent: same matching, same stega handling,
// only the class on the wrapping span differs.
const {
  found: scriptFound,
  before: scriptBefore,
  word: scriptWord,
  after: scriptAfter,
} = splitHeadingAccent(headline, scriptAccent);

// The colour accent, only considered when the script accent did not fire.
const colour = scriptFound
  ? { found: false, before: '', word: '', after: '', heading: headline }
  : splitHeadingAccent(headline, headingAccent);

const richSubhead = hasInlineRich(subheadRich);
const mark = hasBackground ? null : await getImage({ src: markLight });
---

<section
  class:list={[
    hasBackground
      ? 'bg-accent-dark text-bg relative overflow-hidden'
      : 'final-cta--light bg-muted text-foreground',
  ]}
  aria-labelledby={headingId}
>
  {/* Optional background photo + fixed charcoal scrim. Rendered only when an
      image is set; otherwise the section stays the solid Charcoal Dark panel.
      The scrim is tuned dark enough that the cream headline and bronze button
      stay readable over any photo. The image is decorative, so it is
      aria-hidden with empty alt and sits at z-0 behind the stripe + content. */}
  {hasBackground && (
    <div class="absolute inset-0 z-0" aria-hidden="true">
      <SanityImage
        source={backgroundImage}
        width={1920}
        sizes="100vw"
        loading="lazy"
        alt=""
        class="h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-accent-dark/70" />
    </div>
  )}

  {/* Bronze accent stripe, same 2px brand signature used at the top of the
      site header, mobile menu, footer, and every marketing card. Softens the
      transition from the previous (usually light) section into this dark
      panel and ties the close-of-page back into the brand vocabulary. */}
  {hasBackground && <div class="relative z-10 h-0.5 bg-primary" aria-hidden="true"></div>}

  <div
    class:list={[
      'mx-auto max-w-content px-m py-section-lg text-center',
      hasBackground && 'relative z-10',
    ]}
  >
    {mark && (
      <img
        src={mark.src}
        alt=""
        width="160"
        height="160"
        loading="lazy"
        decoding="async"
        class="final-cta__mark mx-auto"
      />
    )}
    {eyebrow && (
      <p
        class:list={[
          'text-xs tracking-[0.22em] uppercase',
          hasBackground ? 'text-bg/75' : 'text-link',
        ]}
      >
        {eyebrow}
      </p>
    )}
    {/* Cream hairline accent beneath the eyebrow that matches SectionHeading's
        inverse-tone treatment so headings carry the same editorial signature
        on both light and dark surfaces. */}
    {eyebrow && hasBackground && (
      <div class="mx-auto mt-s mb-m h-px w-12 bg-bg/40" aria-hidden="true" />
    )}
    <h2
      id={headingId}
      class:list={[
        'font-display leading-tight',
        hasBackground ? 'text-h1 text-bg' : 'final-cta__h2',
      ]}
    >
      {scriptFound ? (
        <>
          {scriptBefore}
          <span class="font-script">{scriptWord}</span>
          {scriptAfter}
        </>
      ) : colour.found ? (
        <>
          {colour.before}
          <span class="heading-accent">{colour.word}</span>
          {colour.after}
        </>
      ) : (
        headline
      )}
    </h2>
    {(subhead || richSubhead) && (
      <p
        class:list={[
          'mx-auto mt-m max-w-2xl text-lg',
          hasBackground ? 'text-bg/85' : 'text-muted-foreground',
        ]}
      >
        {richSubhead ? <InlineRich value={subheadRich} /> : subhead}
      </p>
    )}
    <div class="mt-l flex flex-wrap justify-center gap-s">
      <CtaLink
        cta={cta}
        variant="primary"
        onDark={hasBackground}
        fallbackHref="/contact/"
        fallbackLabel={fallbackCtaLabel}
      />
      {secondaryCta && <CtaLink cta={secondaryCta} variant="secondary" onDark={hasBackground} />}
    </div>
  </div>
</section>
