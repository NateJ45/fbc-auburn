---
// Safe to edit by hand
// Home's opening (2026-10-23, the photo hero): a full-width photograph with the welcome set over
// it in white, so the first thing a visitor sees is people, not a logo. Over the photo, darkened
// toward the lower left so the words always read: the church's name and town as a small line,
// the welcome as the page's one h1 ("Come as you are."), a sentence on what the church is about,
// the Sunday times and address, and two buttons (plan a first visit; the second action). The This
// Sunday card sits at the right on a wide screen and follows the words on a phone.
// The one brick sill on the page is the footer's (audit 2026-10-25); the hero has none of its own.
//
// Content: the Home document's hero block (Studio > Home > Page layout > Hero). "Background photo"
// is the picture; Eyebrow and Headline make the name line ("First Baptist Church of" + "Auburn");
// "Welcome line" is the big heading; Subhead the sentence; the two buttons. With no photo the
// hero falls back to the navy brick ground. A stand-in (an Unsplash picture) is labelled
// "Stand-in photograph" in the corner until the church's own photo replaces it. Before launch a
// stand-in is not shown at all: the hero keeps the navy ground and a pinned "Photo needed" note
// names the shot we want (src/data/shot-list.ts, key "hero").
//
// The video (2026-10-25, "Background video" on the same block, Home only): a short silent clip of
// church life plays over the photo, under the same shade. The photo is still drawn first and stays
// the page's LCP; the script below adds the <video> after load, with the photo as its poster, and
// only when hero-video.ts allows it (never with reduced motion, Save-Data, a slow connection or in
// print), so those visitors get the still and download nothing. The clip fades in once it plays, a
// small Pause button (WCAG 2.2.2: motion longer than five seconds) sits at the top right, the choice
// is remembered on this device, and the clip pauses while the hero is off screen. A video fills the
// shot request, so the "Photo needed" note goes once one is uploaded.
import SanityImage from '@/components/SanityImage.astro';
import ShotRequest from '@/components/ShotRequest.astro';
import { exampleSrc, heroSrcset, shotFor } from '@/data/shot-list';
import SundayCard from './SundayCard.astro';
import { getChurchFacts } from '@/lib/church-data';
import { ctaHref } from '@/lib/cta-href';
import { townOf } from '@/lib/place-line';
import { splitStega } from '@/lib/preview-stega';
import { heroVideoSource } from '@/lib/hero-video';
import type { ProjectedHeroSection, ProjectedImage } from '@/lib/pageBuilder.types';

interface Props {
  block: ProjectedHeroSection;
}
const { block } = Astro.props;

// The clip's URL, cleaned of preview markers so the src is a real address in the draft preview too.
const video = heroVideoSource({
  url: splitStega(block.backgroundVideo?.url ?? '').cleaned,
  mimeType: block.backgroundVideo?.mimeType,
});
const shot = video ? null : shotFor(Astro.url.pathname, 'hero', 0, block.backgroundImage);
// Before launch the shot's example clip (a stock Pexels video, shot-list.ts) plays the same way as a
// real upload, over the example photo, so Home shows what the hero video will look like. It goes
// with the shot request at launch (PRE_LAUNCH_NOTES), like the example photo.
const clip =
  video ?? (shot?.video ? { url: exampleSrc(shot.video.file, 'mp4'), type: 'video/mp4' } : null);
const photo = !shot && block.backgroundImage?.asset ? block.backgroundImage : null;
// Before launch the shot's example photo fills the hero behind its note, so Home reads as finished.
// It is the page's LCP element, so phones get a smaller copy (29 KB, not the 2000px 166 KB file
// that pushed Lighthouse's mobile LCP past 4.5 s; heroSrcset in shot-list.ts). On a phone the hero
// is taller than wide and the landscape photo is cropped to cover it, so it is drawn about 1.5
// times the screen width: `sizes` says so, or the browser would pick a copy too small and blur it.
const example = shot?.example ? exampleSrc(shot.example.file) : null;
const exampleSrcset = shot?.example ? heroSrcset(shot.example.file) : undefined;
const isStandIn = (img: ProjectedImage | null | undefined) =>
  (img?.asset as { source?: { name?: string } } | null | undefined)?.source?.name === 'unsplash';

// The name line: "First Baptist Church of Auburn", then the town from Church facts so "Auburn" is
// never read as Alabama. No ZIP (2026-10-25): it wrapped the line to two on a phone, and the
// header's place line says the same "Hamilton, OH" (src/lib/place-line.ts).
const nameLine = [splitStega(block.eyebrow ?? '').cleaned, splitStega(block.headline ?? '').cleaned]
  .filter(Boolean)
  .join(' ');
const facts = await getChurchFacts();
const town = facts.address ? townOf(facts.address.lines[1]) : '';
const primary = block.primaryCta;
const secondary = block.secondaryCta;
---

<section
  class="hb-hero"
  aria-labelledby="hb-h1"
  data-photo={photo || example || clip ? 'yes' : 'no'}
  data-hero-video={clip?.url}
  data-hero-video-type={clip?.type}
>
  <div class="hb-photo" aria-hidden={photo ? undefined : 'true'}>
    {example && (
      <img
        src={example}
        srcset={exampleSrcset}
        sizes="(max-width: 767px) 150vw, 100vw"
        alt=""
        width="2000"
        height="1333"
        loading="eager"
        fetchpriority="high"
        class="hb-photo__img"
      />
    )}
    {photo && (
      <SanityImage
        source={photo as never}
        width={2000}
        sizes="100vw"
        quality={65}
        loading="eager"
        fetchpriority="high"
        class="hb-photo__img"
      />
    )}
    <div class="hb-photo__shade"></div>
  </div>
  {clip && (
    <button
      type="button"
      class="hb-video-toggle"
      data-hero-video-toggle
      aria-pressed="false"
      hidden
    >
      <span class="hb-video-toggle__icon" aria-hidden="true"></span>
      <span class="hb-video-toggle__label">Pause video</span>
    </button>
  )}
  {isStandIn(photo) && (
    <p class="hb-standin">
      <span>Stand-in photograph</span>
    </p>
  )}

  {shot && (
    <div class="hb-wrap hb-hero__shot">
      <ShotRequest shot={shot} variant="tag" />
    </div>
  )}

  <div class="hb-wrap hb-hero__inner">
    <div class="hb-hero__copy">
      {nameLine && (
        <p class="hb-name">
          {nameLine}
          {town && <span class="hb-name__town">{town}</span>}
        </p>
      )}
      <h1 class="hb-h1" id="hb-h1">
        {block.welcome || 'Come as you are.'}
      </h1>
      {/* The times and the address are the This Sunday card's job; saying them here too was the
          same fact twice on one screen (review, 2026-10-23). */}
      {block.subhead && <p class="hb-intro">{block.subhead}</p>}
      {(primary?.label || secondary?.label) && (
        <div class="hb-actions">
          {primary?.label && (
            <a class="btn-auburn btn-auburn--primary" href={ctaHref(primary, '/plan-your-visit/')}>
              {primary.label}
            </a>
          )}
          {/* A space between the buttons so site search does not run their words together. */}{' '}
          {secondary?.label && (
            <a class="hb-ghost" href={ctaHref(secondary, '/sermons/')}>
              {secondary.label}
            </a>
          )}
        </div>
      )}
    </div>
    <div class="hb-hero__card">
      <SundayCard />
    </div>
  </div>
  {/* No brick sill here (audit 2026-10-25, GD-H3): one sill per page, the footer's. */}
</section>

{/* The phone Sunday bar that used to follow the hero is SundayBar.astro since 2026-10-25, rendered
    by the footer on Home and Plan your visit. */}

<script>
  // The hero's clip (see the header comment). Built here, not in the HTML, so a visitor who should
  // get the still downloads nothing and the photo is always the first thing painted.
  import { heroVideoAllowed } from '@/lib/hero-video';

  const PAUSED_KEY = 'fbc-hero-video-paused';
  const readPaused = () => {
    try {
      return localStorage.getItem(PAUSED_KEY) === '1';
    } catch {
      return false;
    }
  };
  const writePaused = (paused: boolean) => {
    try {
      if (paused) localStorage.setItem(PAUSED_KEY, '1');
      else localStorage.removeItem(PAUSED_KEY);
    } catch {
      /* private window: the choice lasts for this page only */
    }
  };

  function initHeroVideo() {
    const hero = document.querySelector<HTMLElement>('.hb-hero[data-hero-video]');
    if (!hero || hero.dataset.videoOn) return;
    // After the load event, so the clip never competes with the photo (the LCP) for the network.
    if (document.readyState !== 'complete') {
      addEventListener('load', initHeroVideo, { once: true });
      return;
    }
    const conn = (
      navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }
    ).connection;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const allowed = heroVideoAllowed({
      reducedMotion: reduce.matches,
      saveData: conn?.saveData,
      effectiveType: conn?.effectiveType,
      print: matchMedia('print').matches,
    });
    if (!allowed) return;
    hero.dataset.videoOn = '1';

    const frame = hero.querySelector<HTMLElement>('.hb-photo');
    const still = frame?.querySelector<HTMLImageElement>('img');
    const toggle = hero.querySelector<HTMLButtonElement>('[data-hero-video-toggle]');
    if (!frame) return;

    const clip = document.createElement('video');
    // hb-photo__img so the flow layer's scroll drift moves it with the photo (the parallax).
    clip.className = 'hb-photo__img hb-photo__video';
    clip.muted = true;
    clip.defaultMuted = true;
    clip.loop = true;
    clip.playsInline = true;
    clip.preload = 'none';
    clip.setAttribute('muted', '');
    clip.setAttribute('playsinline', '');
    clip.setAttribute('aria-hidden', 'true');
    clip.tabIndex = -1;
    clip.disablePictureInPicture = true;
    // The photo the browser already chose is the poster, so nothing new is fetched for it.
    if (still?.currentSrc) clip.poster = still.currentSrc;
    const source = document.createElement('source');
    source.src = hero.dataset.heroVideo ?? '';
    source.type = hero.dataset.heroVideoType ?? 'video/mp4';
    clip.append(source);
    frame.insertBefore(clip, frame.querySelector('.hb-photo__shade'));

    let paused = readPaused();
    let onScreen = true;
    const label = toggle?.querySelector('.hb-video-toggle__label');
    const sync = () => {
      if (!toggle || !label) return;
      toggle.setAttribute('aria-pressed', String(paused));
      label.textContent = paused ? 'Play video' : 'Pause video';
    };
    const run = () => {
      if (paused || !onScreen) clip.pause();
      else clip.play().catch(() => {});
    };
    clip.addEventListener('playing', () => hero.classList.add('is-video-playing'), { once: true });
    clip.addEventListener('error', () => clip.remove(), { once: true });
    source.addEventListener('error', () => clip.remove(), { once: true });
    if (toggle) {
      toggle.hidden = false;
      toggle.addEventListener('click', () => {
        paused = !paused;
        writePaused(paused);
        sync();
        run();
      });
    }
    sync();

    // Pause while the hero is scrolled away; turn the clip off if reduced motion is switched on.
    const io = new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      run();
    });
    io.observe(hero);
    // Start now rather than on the observer's first report, which a browser may hold back (a
    // background tab runs no observer callbacks); the hero is on screen at load, and the observer
    // pauses the clip if it is not.
    run();
    const onReduce = () => {
      if (!reduce.matches) return;
      clip.pause();
      clip.remove();
      hero.classList.remove('is-video-playing');
      if (toggle) toggle.hidden = true;
    };
    reduce.addEventListener('change', onReduce);
    // Chrome pauses a muted video in a hidden tab and does not always start it again, so a Home
    // opened in a background tab showed the still photo after switching to it. Pick up again here.
    const onVisible = () => {
      if (!document.hidden && clip.isConnected) run();
    };
    document.addEventListener('visibilitychange', onVisible);
    document.addEventListener(
      'astro:before-swap',
      () => {
        io.disconnect();
        reduce.removeEventListener('change', onReduce);
        document.removeEventListener('visibilitychange', onVisible);
        clip.pause();
      },
      { once: true },
    );
  }
  initHeroVideo();
  document.addEventListener('astro:page-load', initHeroVideo);
</script>
