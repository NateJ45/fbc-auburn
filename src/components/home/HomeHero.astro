---
// Safe to edit by hand
// Board E's opening: the church's Auburn-wide lockup at hero scale (the full-colour mark beside
// "FIRST BAPTIST CHURCH OF" over a mosaic "Auburn"), then the lead row (the red welcome line, a
// paragraph, one red button and a text link) beside the This Sunday card, then the stone path
// running in from the left edge under the buttons and ending in red at the card's left
// side (the card is the door). The place line ("Hamilton, OH 45013") sits
// top right of the masthead, from Church facts, so "Auburn" is never read as Alabama. On a
// phone the mark is hidden (the header carries it), the card comes straight after the welcome
// and its buttons (so the time and place are on the first screen), and a short strip of the path
// follows the card.
//
// Content: the Home document's hero block (Studio > Home > Page layout > Hero). Eyebrow and
// Headline draw the lockup, "Welcome line" is the red line, Subhead the paragraph, and the two
// buttons. The h1 reads "First Baptist Church of Auburn" as one heading.
//
// The path lays itself once, when it comes into view: the inline script below arms it before
// first paint (only under html.motion), then lays it as soon as a third of it is on screen (at
// once on a tall screen). See StonePath.astro.
import markAsset from '@/assets/brand/fbc-auburn-icon-full-color.svg';
import SundayCard from './SundayCard.astro';
import SundayFacts from './SundayFacts.astro';
import StonePath from './StonePath.astro';
import { getChurchFacts } from '@/lib/church-data';
import { timesPhrase } from '@/lib/church-facts';
import { ctaHref } from '@/lib/cta-href';
import { splitStega } from '@/lib/preview-stega';
import { brickWord, LETTER_TONES } from '../../../scripts/lib/brick-letters.mjs';
import type { ProjectedHeroSection } from '@/lib/pageBuilder.types';

interface Props {
  block: ProjectedHeroSection;
}
const { block } = Astro.props;

// The brick word (treatment A of the brick letterforms): navy brick letters, every fourth letter
// (the "b" of Auburn) in auburn, one SVG per word. Built from the visible text only; a preview's
// invisible stega run is put back after the letters.
const { cleaned: word, encoded } = splitStega(block.headline || 'Auburn');
let k = 0;
const wordSvgs = word
  .split(/\s+/)
  .filter(Boolean)
  .map((w, n) => {
    const accent: number[] = [];
    [...w].forEach((_, i) => {
      if (k++ % 4 === 2) accent.push(i);
    });
    return brickWord(w, {
      tones: LETTER_TONES.navy,
      accent: { letters: accent, tones: LETTER_TONES.auburn },
      seed: 3 + n * 11,
      tracking: -0.035,
    });
  });
// The masthead is set for a word of up to 7 letters ("Auburn" is 6). A longer word, should an
// editor type one, scales the type down so it never runs off the screen.
const longest = Math.max(1, ...word.split(/\s+/).map((w) => w.length));
const wordScale = Math.min(1, 7 / longest).toFixed(3);
const name = [splitStega(block.eyebrow ?? '').cleaned, word].filter(Boolean).join(' ');
const primary = block.primaryCta;

const facts = await getChurchFacts();

// The phone Sunday bar (Home audit research, 2026-10-17): once the This Sunday card has scrolled
// away, a slim bar at the bottom keeps when, where and the visit button one tap away. Same facts
// as the card; same visit link as the hero's own button.
const barMinutes = facts.serviceTimes.filter((s) => s.dayIndex === 0).map((s) => s.minutes);
const barTimes = barMinutes.length ? `Sundays ${timesPhrase(barMinutes)}` : '';
const barVisitHref = ctaHref(block.primaryCta, '/plan-your-visit/');
const addr = facts.address;
// The town, state and ZIP ("Hamilton, OH 45013"), worded as everywhere else (visitor audit,
// 2026-10-18); the road is already in the header note and on the card (the Home critic counted it
// three times above the fold).
const place = addr ? addr.lines[1] : '';
const secondary = block.secondaryCta;
---

<!-- The This Sunday card is the largest thing on the first screen and its stone ground is a CSS
     background, which the browser finds late; fetch it early (Lighthouse: LCP 3.7s on mobile). -->
<link
  rel="preload"
  as="image"
  href="/textures/tile-deep.svg"
  type="image/svg+xml"
  fetchpriority="high"
/>
<section class="hb-hero" aria-labelledby="hb-h1">
  <div class="hb-wrap">
    <div class="hb-masthead">
      <img
        class="hb-hero-mark"
        src={markAsset.src}
        width={markAsset.width}
        height={markAsset.height}
        alt=""
        loading="eager"
        decoding="async"
      />
      <h1 class="hb-h1" id="hb-h1" aria-label={name}>
        {block.eyebrow && <span class="hb-eyebrow">{block.eyebrow}</span>}{' '}
        <span class="hb-word" style={`--hb-word-scale: ${wordScale}`}>
          {wordSvgs.map((svg, i) => (
            <>
              {i > 0 && ' '}
              <Fragment set:html={svg} />
            </>
          ))}
          {encoded}
        </span>
      </h1>
      {place && <p class="hb-place">{place}</p>}
    </div>

    <div class="hb-lead">
      <div>
        {block.welcome && <p class="hb-welcome">{block.welcome}</p>}
        <SundayFacts />
        {block.subhead && <p class="hb-intro">{block.subhead}</p>}
        {(primary?.label || secondary?.label) && (
          <div class="hb-actions">
            {primary?.label && (
              <a
                class="btn-auburn btn-auburn--primary"
                href={ctaHref(primary, '/plan-your-visit/')}
              >
                {primary.label}
              </a>
            )}
            {/* A space between the buttons so site search does not read "visitMeet" (card 126);
                the row is flex, so it changes nothing on screen. */}{' '}
            {secondary?.label && (
              <a class="hb-textlink" href={ctaHref(secondary, '/about/')}>
                {secondary.label}
              </a>
            )}
          </div>
        )}
      </div>
      <SundayCard />
      <StonePath variant="phone" />
      <StonePath variant="wide" />
    </div>
  </div>
</section>

{barTimes && (
  <div class="hb-sundaybar" data-sundaybar hidden>
    <p class="hb-sundaybar__times hb-num">{barTimes}</p>
    {facts.address && (
      <a class="hb-sundaybar__link" href={facts.address.mapsUrl} rel="noopener" target="_blank">
        Directions<span class="sr-only"> (opens Google Maps in a new tab)</span>
      </a>
    )}
    <a class="btn-auburn btn-auburn--primary hb-sundaybar__visit" href={barVisitHref}>
      Plan your visit
    </a>
  </div>
)}

<script is:inline>
  // Arm the stone path before first paint, then lay it. Only under
  // html.motion (set in BaseLayout's head unless reduced motion or ?still), so without JS or
  // with reduced motion the finished path is what renders.
  (function () {
    if (!document.documentElement.classList.contains('motion')) return;
    var paths = document.querySelectorAll('[data-stone-path]');
    paths.forEach(function (p) {
      p.classList.add('is-armed');
    });
    var lay = function (p) {
      p.classList.add('is-laid');
    };
    // Lay each path when a third of it is in view, so people actually see it happen. Without
    // IntersectionObserver, lay it 350ms after the markup is parsed, as before.
    if (!('IntersectionObserver' in window)) {
      setTimeout(function () {
        paths.forEach(lay);
      }, 350);
      return;
    }
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          lay(e.target);
          io.unobserve(e.target);
        });
      },
      { threshold: 0.33 },
    );
    paths.forEach(function (p) {
      io.observe(p);
    });
  })();
</script>

<script>
  // The phone Sunday bar: shown once the This Sunday card has scrolled up out of view, hidden again
  // while the footer (which carries its own invitation) is on screen. Two IntersectionObservers, no
  // scroll listener. CSS shows it below 768px only (home-board.css).
  const bar = document.querySelector<HTMLElement>('[data-sundaybar]');
  const card = document.querySelector<HTMLElement>('[data-this-sunday]');
  const footer = document.querySelector<HTMLElement>('.site-footer');
  if (bar && card && 'IntersectionObserver' in window) {
    let pastCard = false;
    let footerIn = false;
    const sync = () => {
      bar.hidden = !(pastCard && !footerIn);
    };
    new IntersectionObserver(([e]) => {
      pastCard = !e.isIntersecting && e.boundingClientRect.top < 0;
      sync();
    }).observe(card);
    if (footer) {
      new IntersectionObserver(([e]) => {
        footerIn = e.isIntersecting;
        sync();
      }).observe(footer);
    }
  }
</script>
