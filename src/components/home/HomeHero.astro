---
// Safe to edit by hand
// Home's opening (2026-10-23, the photo hero): a full-width photograph with the welcome set over
// it in white, so the first thing a visitor sees is people, not a logo. Over the photo, darkened
// toward the lower left so the words always read: the church's name and town as a small line,
// the welcome as the page's one h1 ("Come as you are."), a sentence on what the church is about,
// the Sunday times and address, and two buttons (plan a first visit; the second action). The This
// Sunday card sits at the right on a wide screen and follows the words on a phone. A printed
// brick sill runs along the photo's foot, the doorstep into the page.
//
// Content: the Home document's hero block (Studio > Home > Page layout > Hero). "Background photo"
// is the picture; Eyebrow and Headline make the name line ("First Baptist Church of" + "Auburn");
// "Welcome line" is the big heading; Subhead the sentence; the two buttons. With no photo the
// hero falls back to the navy brick ground. A stand-in (an Unsplash picture) is labelled
// "Stand-in photograph" in the corner until the church's own photo replaces it. Before launch a
// stand-in is not shown at all: the hero keeps the navy ground and a pinned "Photo needed" note
// names the shot we want (src/data/shot-list.ts, key "hero").
import SanityImage from '@/components/SanityImage.astro';
import ShotRequest from '@/components/ShotRequest.astro';
import { exampleSrc, heroSrcset, shotFor } from '@/data/shot-list';
import SundayCard from './SundayCard.astro';
import Sill from '@/components/Sill.astro';
import { getChurchFacts } from '@/lib/church-data';
import { ctaHref } from '@/lib/cta-href';
import { townOf } from '@/lib/place-line';
import { splitStega } from '@/lib/preview-stega';
import type { ProjectedHeroSection, ProjectedImage } from '@/lib/pageBuilder.types';

interface Props {
  block: ProjectedHeroSection;
}
const { block } = Astro.props;

const shot = shotFor(Astro.url.pathname, 'hero', 0, block.backgroundImage);
const photo = !shot && block.backgroundImage?.asset ? block.backgroundImage : null;
// Before launch the shot's example photo fills the hero behind its note, so Home reads as finished.
// It is the page's LCP element, so phones get a smaller copy (29 KB, not the 2000px 166 KB file
// that pushed Lighthouse's mobile LCP past 4.5 s; heroSrcset in shot-list.ts). On a phone the hero
// is taller than wide and the landscape photo is cropped to cover it, so it is drawn about 1.5
// times the screen width: `sizes` says so, or the browser would pick a copy too small and blur it.
const example = shot?.example ? exampleSrc(shot.example.file) : null;
const exampleSrcset = shot?.example ? heroSrcset(shot.example.file) : undefined;
const isStandIn = (img: ProjectedImage | null | undefined) =>
  (img?.asset as { source?: { name?: string } } | null | undefined)?.source?.name === 'unsplash';

// The name line: "First Baptist Church of Auburn", then the town from Church facts so "Auburn" is
// never read as Alabama. No ZIP (2026-10-25): it wrapped the line to two on a phone, and the
// header's place line says the same "Hamilton, OH" (src/lib/place-line.ts).
const nameLine = [splitStega(block.eyebrow ?? '').cleaned, splitStega(block.headline ?? '').cleaned]
  .filter(Boolean)
  .join(' ');
const facts = await getChurchFacts();
const town = facts.address ? townOf(facts.address.lines[1]) : '';
const primary = block.primaryCta;
const secondary = block.secondaryCta;
---

<section class="hb-hero" aria-labelledby="hb-h1" data-photo={photo || example ? 'yes' : 'no'}>
  <div class="hb-photo" aria-hidden={photo ? undefined : 'true'}>
    {example && (
      <img
        src={example}
        srcset={exampleSrcset}
        sizes="(max-width: 767px) 150vw, 100vw"
        alt=""
        width="2000"
        height="1333"
        loading="eager"
        fetchpriority="high"
        class="hb-photo__img"
      />
    )}
    {photo && (
      <SanityImage
        source={photo as never}
        width={2000}
        sizes="100vw"
        quality={65}
        loading="eager"
        fetchpriority="high"
        class="hb-photo__img"
      />
    )}
    <div class="hb-photo__shade"></div>
  </div>
  {isStandIn(photo) && (
    <p class="hb-standin">
      <span>Stand-in photograph</span>
    </p>
  )}

  {shot && (
    <div class="hb-wrap hb-hero__shot">
      <ShotRequest shot={shot} variant="tag" />
    </div>
  )}

  <div class="hb-wrap hb-hero__inner">
    <div class="hb-hero__copy">
      {nameLine && (
        <p class="hb-name">
          {nameLine}
          {town && <span class="hb-name__town">{town}</span>}
        </p>
      )}
      <h1 class="hb-h1" id="hb-h1">
        {block.welcome || 'Come as you are.'}
      </h1>
      {/* The times and the address are the This Sunday card's job; saying them here too was the
          same fact twice on one screen (review, 2026-10-23). */}
      {block.subhead && <p class="hb-intro">{block.subhead}</p>}
      {(primary?.label || secondary?.label) && (
        <div class="hb-actions">
          {primary?.label && (
            <a class="btn-auburn btn-auburn--primary" href={ctaHref(primary, '/plan-your-visit/')}>
              {primary.label}
            </a>
          )}
          {/* A space between the buttons so site search does not run their words together. */}{' '}
          {secondary?.label && (
            <a class="hb-ghost" href={ctaHref(secondary, '/sermons/')}>
              {secondary.label}
            </a>
          )}
        </div>
      )}
    </div>
    <div class="hb-hero__card">
      <SundayCard />
    </div>
  </div>
  <Sill class="hb-hero__sill" />
</section>

{/* The phone Sunday bar that used to follow the hero is SundayBar.astro since 2026-10-25, rendered
    by the footer on Home and Plan your visit. */}
