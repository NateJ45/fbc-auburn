---
// Safe to edit by hand
// Board E's This Sunday card: deep sky on the soft stone tile, beside the welcome on Home. On
// desktop the stone path's red end meets its left side: the card is the door. No icon in
// the address row (a mosaic pin on the mosaic tile lost its red; Home audit 2026-10-17).
// Every fact is derived at build time from Site settings > Church facts (rule 15): the date
// (thisSunday(), so it moves on by itself with the daily rebuild), the Sunday gatherings, the
// address and its map link. The forecast line is SundayWeather in reserve mode (fetched by the
// browser, Wednesday to Sunday noon). The pill shows while any of it is unconfirmed.
//
// Phones (961px down, 2026-10-24): the card becomes a compact strip under the hero buttons, about
// 140px instead of about 400: the date, the two times, the tag and one Directions button. The
// forecast, the calendar link, the watch line and the full address are hidden there by CSS
// (home-board.css); the address stays one tap away through Directions and in the footer card.
//
// Renders nothing when no Sunday gathering is set.
import SundayWeather from '@/components/church/SundayWeather.astro';
import { getChurchFacts } from '@/lib/church-data';
import { clockLabel, sundayIcs, thisSunday } from '@/lib/church-facts';
import { watchLive } from '@/lib/live-service';
import { site } from '@/data/site';
import { churchDataNow, loadUpcomingStream } from '@/lib/church-feeds';

interface Props {
  /** The build moment; tests pass a fixed one. */
  now?: Date;
}
const { now = churchDataNow() } = Astro.props;
const facts = await getChurchFacts();
const sunday = thisSunday(facts, now);
const address = facts.address;
// "Add Sundays to my calendar" (/sunday.ics), only once a Sunday time is confirmed.
const hasCalendar = sundayIcs({ ...facts, title: site.name }, now, site.url) !== null;
const timesConfirmed = sunday?.confirmed ?? true;
const addressConfirmed = address?.confirmed ?? true;
const pill = !timesConfirmed
  ? addressConfirmed
    ? 'Times to confirm'
    : 'To confirm'
  : addressConfirmed
    ? ''
    : 'Address to confirm';
// "9:45 am" reads "9:45" on a Sunday morning card; an afternoon or evening time keeps its "pm".
const short = (label: string) => label.replace(/ am$/, '');
// Watching from home (2026-10-24): where Sunday streams, and once the church is on YouTube the
// coming Sunday's scheduled stream by name (church-video.ts upcomingStream). Derived, never typed.
const live = watchLive(facts);
const stream = live?.check ? await loadUpcomingStream(facts) : null;
const liveAt = live?.start != null ? short(clockLabel(live.start)) : '';
const streamHref = stream?.watchUrl ?? live?.href;
---

{sunday && (
  <aside class="hb-sunday" aria-labelledby="hb-sunday-title" data-this-sunday>
    <div class="hb-sunday__top">
      <h2 class="hb-sunday__title" id="hb-sunday-title">
        {sunday.isToday ? 'Today' : 'This Sunday'}
      </h2>
      {pill && <span class="hb-pill">{pill}</span>}
    </div>
    <p class="hb-sunday__date">
      <time datetime={sunday.date}>{sunday.dateLabel.replace(/^Sunday, /, '')}</time>
    </p>
    <SundayWeather reserve />
    {/* The spaces between dt and dd are for site search (card 126): the list is a grid, so they
        change nothing on screen, but without them Pagefind reads "9:45Sunday School". */}
    <dl class="hb-sunday__times hb-num">
      {sunday.services.map((s) => (
        <>
          <dt>{short(s.timeLabel)}</dt>{' '}
          <dd>
            {s.label}
            {s.note && `, ${s.note}`}
          </dd>{' '}
        </>
      ))}
    </dl>
    {hasCalendar && (
      <a class="hb-sunday__cal" href="/sunday.ics" download>
        Add Sundays to my calendar
      </a>
    )}
    {live && streamHref && (
      <p class="hb-sunday__watch">
        Can&rsquo;t be there?{' '}
        <a href={streamHref} target="_blank" rel="noopener noreferrer" data-live-link={streamHref}>
          {stream ? <>Watch &ldquo;{stream.title}&rdquo; live</> : 'Watch live'}
          {live.via ? ` on ${live.via}` : ''}
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
        {liveAt && ` at ${liveAt}`}.
      </p>
    )}
    {address && (
      <div class="hb-sunday__where">
        <p>
          {/* The address in its own span, so the phone strip can drop it and keep Directions. */}
          <span class="hb-sunday__addr">
            {[address.street, address.city, address.state].filter(Boolean).join(', ')}
            <br />
            {address.findUs && (
              <>
                <span class="hb-sunday__findus">{address.findUs}</span>
                <br />
              </>
            )}
          </span>
          <a class="hb-sunday__dir" href={address.mapsUrl} rel="noopener" target="_blank">
            Directions<span class="sr-only"> (opens Google Maps in a new tab)</span>
          </a>
        </p>
      </div>
    )}
  </aside>
)}
