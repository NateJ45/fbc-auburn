---
// Safe to edit by hand
// The brick path (2026-10-21): a low wall of courses stepping up toward the This Sunday card,
// generated by scripts/gen-stones.mjs and inlined as SVG, one <path> per brick in laying order
// (bottom course first, left to right), each carrying --i so it can be laid brick by brick on
// load (24ms apart). Decorative: aria-hidden, and it never sits over text (the wide path tucks
// under the This Sunday card, which stacks above it).
//
// Motion lives in src/styles/home-board.css and the small script in HomeHero.astro: the hidden
// starting state needs html.motion AND the script's is-armed class, so with no JS, ?still or
// reduced motion the path is simply finished.
import { PATH_PHONE, PATH_PHONE_VIEWBOX, PATH_WIDE, PATH_WIDE_VIEWBOX } from './stones.generated';

interface Props {
  variant: 'wide' | 'phone';
}
const { variant } = Astro.props;
const stones = variant === 'wide' ? PATH_WIDE : PATH_PHONE;
const viewBox = variant === 'wide' ? PATH_WIDE_VIEWBOX : PATH_PHONE_VIEWBOX;
---

<svg
  class:list={['hb-path', `hb-path-${variant}`]}
  viewBox={viewBox}
  aria-hidden="true"
  focusable="false"
  data-stone-path
>
  {stones.map((s, i) => (
    <path class="hb-stone" style={`--i: ${i}`} d={s.d} fill={s.fill} />
  ))}
</svg>
