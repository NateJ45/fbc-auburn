---
// Safe to edit by hand
// Home, "board E" (approved 2026-10-17; docs/design-directions/2026-10-17-fbc-auburn/README.md).
// Walks the Home document's page layout (Studio > Home > Page layout) and draws each block in the
// board's grammar. Like SectionRenderer, the board owns the cadence (rule 9: blocks carry no
// colour field), so reordering in the Studio can never break the rhythm:
//
//   Hero (the first)             -> HomeHero: the lockup, the welcome, This Sunday, the stone path
//   Stepping-stone steps (first) -> HomeWalk: Your first Sunday (Home audit research, 2026-10-17)
//   Icon cards                   -> HomeBand: "board" (Through the week, sky band) before Who we
//                                   are and This week; "ways" (Other ways in, green) after them
//   Image + text (the first)     -> HomeBelong: Who we are, the photo mosaic
//   This week + Watch, adjacent  -> HomeWeekWatch: side by side (either alone is fine too)
//   anything else                -> SectionRenderer, so a section an editor adds still renders
//
// Every section label leads with the same marker: three gold steps from the mark.
//
// PREVIEW. The Studio preview passes `editDoc`, and each drawn block is wrapped in a real block box
// carrying its data-sanity attribute (the in-canvas insert / move / remove controls), exactly as
// SectionRenderer does. The live site never passes it, and the wrapper is then a Fragment.
import '@/styles/home-board.css';
import HomeHero from './HomeHero.astro';
import HomeWalk from './HomeWalk.astro';
import HomeBand from './HomeBand.astro';
import HomeBelong from './HomeBelong.astro';
import HomeWeekWatch from './HomeWeekWatch.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { sectionEditAttr, type EditDoc } from '@/lib/preview-edit-attr';
import type {
  PageBuilderBlock,
  ProjectedHeroSection,
  ProjectedIconCardsSection,
  ProjectedImageTextSection,
  ProjectedStepsRailSection,
  ProjectedThisWeekSection,
  ProjectedWatchSection,
} from '@/lib/pageBuilder.types';

interface Props {
  sections: unknown[];
  editDoc?: EditDoc;
}
const { sections, editDoc } = Astro.props;
const blocks = (sections ?? []) as PageBuilderBlock[];

type Row =
  | { kind: 'hero'; key: string; block: ProjectedHeroSection }
  | { kind: 'walk'; key: string; block: ProjectedStepsRailSection }
  | {
      kind: 'band';
      key: string;
      block: ProjectedIconCardsSection;
      variant: 'board' | 'ways';
    }
  | { kind: 'belong'; key: string; block: ProjectedImageTextSection }
  | {
      kind: 'weekWatch';
      key: string;
      keys: string[];
      week: ProjectedThisWeekSection | null;
      watch: ProjectedWatchSection | null;
    }
  | { kind: 'other'; key: string; block: PageBuilderBlock };

const rows: Row[] = [];
let seenHero = false;
let seenWalk = false;
let seenMiddle = false; // Who we are or This week drawn: a card band after them is "ways"
let seenCards = false;
let seenBelong = false;
for (let i = 0; i < blocks.length; i++) {
  const b = blocks[i];
  const key = (b as { _key?: string })._key ?? `home-${i}`;
  if (b._type === 'heroSection' && !seenHero) {
    seenHero = true;
    rows.push({ kind: 'hero', key, block: b as ProjectedHeroSection });
  } else if ((b as { _type: string })._type === 'stepsRailSection' && !seenWalk) {
    seenWalk = true;
    rows.push({ kind: 'walk', key, block: b as unknown as ProjectedStepsRailSection });
  } else if (b._type === 'iconCardsSection') {
    rows.push({
      kind: 'band',
      key,
      block: b as ProjectedIconCardsSection,
      variant: seenCards || seenMiddle ? 'ways' : 'board',
    });
    seenCards = true;
  } else if (b._type === 'imageTextSection' && !seenBelong) {
    seenBelong = true;
    seenMiddle = true;
    rows.push({ kind: 'belong', key, block: b as ProjectedImageTextSection });
  } else if (b._type === 'thisWeekSection' || b._type === 'watchSection') {
    const next = blocks[i + 1];
    const pairs =
      next &&
      next._type !== b._type &&
      (next._type === 'thisWeekSection' || next._type === 'watchSection');
    const group = pairs ? [b, next] : [b];
    if (pairs) i++;
    seenMiddle = true;
    rows.push({
      kind: 'weekWatch',
      key,
      keys: group.map((g) => (g as { _key?: string })._key ?? key),
      week: (group.find((g) => g._type === 'thisWeekSection') as ProjectedThisWeekSection) ?? null,
      watch: (group.find((g) => g._type === 'watchSection') as ProjectedWatchSection) ?? null,
    });
  } else {
    rows.push({ kind: 'other', key, block: b });
  }
}

const Wrap = editDoc ? 'div' : Fragment;
const wrapAttrs = (key: string) =>
  editDoc ? { 'data-sanity': sectionEditAttr(editDoc, key) } : {};
const hid = (key: string) => `home-${key}`;
---

<div class="hb">
  {rows.map((r) =>
    r.kind === 'other' ? (
      <SectionRenderer sections={[r.block]} idPrefix={hid(r.key)} {editDoc} />
    ) : (
      <Wrap {...wrapAttrs(r.key)}>
        {r.kind === 'hero' ? (
          <HomeHero block={r.block} />
        ) : r.kind === 'walk' ? (
          <HomeWalk block={r.block} headingId={hid(r.key)} />
        ) : r.kind === 'band' ? (
          <HomeBand block={r.block} variant={r.variant} headingId={hid(r.key)} />
        ) : r.kind === 'belong' ? (
          <HomeBelong block={r.block} headingId={hid(r.key)} />
        ) : (
          <HomeWeekWatch week={r.week} watch={r.watch} headingId={hid(r.key)} />
        )}
      </Wrap>
    ),
  )}
</div>
