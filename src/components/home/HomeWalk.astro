---
// Safe to edit by hand
// "Your first Sunday" on Home: the steps a first-time visitor takes on a Sunday morning, drawn
// from a Home "Stepping-stone steps" block. HomeBoard draws the first such block here, straight
// after the hero, so the page answers "what is it like?" before anything else.
//
// PANELS (2026-11-20, the Home rhythm pass; Details reference: Vault "Stacked Scroll Panels" and
// Teamway's stacked step panels). Each step is a wide panel with its photo: the numbered red
// brick, the time, the title and the words on the left, the step's photo on the right (the site's
// `.split`, rule 17). From 1024px the panels stack as you scroll: each one holds a little lower
// than the last under the header while the next slides over it, so the four steps pile up like
// courses of brick. Phones and tablets get a plain column, photo first. Before this the steps
// were four text columns on white, the plainest band on the page.
//
// - Photos come from each step's "Photo (optional)" field. Before launch an empty or stand-in
//   slot shows its "Photo needed" request with an example (src/data/shot-list.ts, keyed by the
//   block's heading); a step with no photo and no request is a text panel across the full width.
// - A step marked as a Sunday gathering takes its time from Site settings > Church facts (rule
//   15), so the time is typed once.
// - The block's Heading ("Your first Sunday") names it in the Studio and keys its shot list; the
//   page shows only the Intro as the section title (no eyebrow over it, 2026-11-20). With no
//   Intro the Heading is the title.
// - Everything is in the HTML: no reveal hides text until a script runs.
import SanityImage from '@/components/SanityImage.astro';
import ShotRequest from '@/components/ShotRequest.astro';
import { shotFor } from '@/data/shot-list';
import { splitStega } from '@/lib/preview-stega';
import { getChurchFacts } from '@/lib/church-data';
import { ctaHref } from '@/lib/church-cta-href';
import type { ProjectedRailStep, ProjectedStepsRailSection } from '@/lib/pageBuilder.types';

interface Props {
  block: ProjectedStepsRailSection;
  headingId: string;
}
const { block, headingId } = Astro.props;
const steps: ProjectedRailStep[] = (block.steps ?? []).filter((s: ProjectedRailStep) => s?.title);
const facts = await getChurchFacts();
const sunday = facts.serviceTimes.filter((s) => s.dayIndex === 0);
const gatheringOf = (g?: string) =>
  g === 'first' ? sunday[0] : g === 'second' ? (sunday[1] ?? null) : null;
// "9:45" reads cleanly beside a place; an afternoon time keeps its "pm".
const short = (label: string) => label.replace(/ am$/, '');
const cta = block.primaryCta?.label ? block.primaryCta : null;
const title = block.intro || block.heading || 'Your first Sunday';
const shotKey = splitStega(block.heading || 'Your first Sunday').cleaned;
const path = Astro.url.pathname;
const panels = steps.map((s, i) => {
  const g = gatheringOf(s.gathering);
  const photo = s.image?.asset ? s.image : null;
  return {
    step: s,
    when: [g && short(g.timeLabel), s.place].filter(Boolean).join(' · '),
    shot: shotFor(path, shotKey, i, s.image),
    photo,
  };
});
---

{panels.length > 0 && (
  <section class="hb-section hb-walk" id="first-sunday" aria-labelledby={headingId}>
    <div class="hb-wrap">
      <h2 class="hb-walk__heading" id={headingId}>
        {title}
      </h2>
      {/* Below 1024px the list scrolls sideways, so it takes keyboard focus and a name. */}
      <ol
        class="hb-walk__panels"
        tabindex="0"
        aria-label={`Your first Sunday, ${panels.length} steps`}
      >
        {panels.map(({ step: s, when, shot, photo }, i) => (
          <li
            class:list={['hb-walk__panel', (shot || photo) && 'split']}
            style={`--hb-walk-i: ${i}`}
          >
            <div class="hb-walk__text">
              <span class:list={['hb-walk__stone', `hb-walk__stone--${i % 4}`]} aria-hidden="true">
                {i + 1}
              </span>
              {when && <p class="hb-walk__when hb-num">{when}</p>}
              <h3 class="hb-walk__title">{s.title}</h3>
              {s.body && <p class="hb-walk__body">{s.body}</p>}
              {s.linkLabel && s.linkHref && (
                <a class="hb-walk__link" href={s.linkHref}>
                  {s.linkLabel}
                </a>
              )}
            </div>
            {shot ? (
              <figure class="hb-walk__ph">
                <ShotRequest shot={shot} class="shot--fill" />
              </figure>
            ) : (
              photo && (
                <figure class="hb-walk__ph">
                  <SanityImage
                    source={photo as never}
                    width={900}
                    sizes="(max-width: 1023px) 100vw, 45vw"
                    quality={70}
                  />
                </figure>
              )
            )}
          </li>
        ))}
      </ol>
      {cta && (
        <div class="hb-walk__end">
          {block.endHeading && <p class="hb-walk__endline">{block.endHeading}</p>}
          <a class="btn-auburn btn-auburn--navy" href={ctaHref(cta, '/plan-your-visit/')}>
            {cta.label}
          </a>
        </div>
      )}
    </div>
  </section>
)}
