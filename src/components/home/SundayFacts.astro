---
// Safe to edit by hand
// Board E's phone fact line: "Sunday School 9:45 · Worship 11:00" (each time named, re-audit 2026-10-26), then the address and Directions, under
// the red welcome line. Shown below 960px only (home-board.css), so time and place are on the
// first phone screen even with the browser's own bars taking height; at desktop the header's
// Sunday note carries the same facts. Derived from Site settings > Church facts (rule 15), the
// same way as that note in Header.astro. Renders nothing without a Sunday time.
//
// data-pagefind-ignore (card 126): this line repeats the header note and the This Sunday card, and
// its two spans sit side by side in the HTML, so site search read them as "11:00 am4241 Hamilton...".
// The space between the spans keeps copy-paste and reader modes tidy too.
import { getChurchFacts } from '@/lib/church-data';
import { namedTimes } from '@/lib/church-facts';

const facts = await getChurchFacts();
const minutes = (facts.serviceTimes ?? []).filter((t) => t.dayIndex === 0).map((t) => t.minutes);
const address = facts.address ?? null;
---

{minutes.length > 0 && (
  <p class="hb-facts hb-num" data-pagefind-ignore="all">
    <span class="hb-facts__times">
      {namedTimes((facts.serviceTimes ?? []).filter((t) => t.dayIndex === 0))}
    </span>{' '}
    {address && (
      <span class="hb-facts__where">
        {address.street} ·{' '}
        <a href={address.mapsUrl} rel="noopener" target="_blank">
          Directions<span class="sr-only"> (opens Google Maps in a new tab)</span>
        </a>
      </span>
    )}
  </p>
)}
