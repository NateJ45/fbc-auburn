---
// Safe to edit by hand
// A board E section label: small caps with a hairline, led by three stepping stones. The marker
// colours follow the path down the page (0 sky, 1 green, 2 gold, 3 red); HomeBoard passes the
// index. Renders as an h2 when it is the section's heading, or a <p> when the section has its own.
import { MARKERS } from './stones.generated';

interface Props {
  text: string;
  /** 0 sky, 1 green, 2 gold, 3 red; wraps past 3. */
  marker: number;
  as?: 'h2' | 'p';
  id?: string;
}
const { text, marker, as: Tag = 'h2', id } = Astro.props;
const stones = MARKERS[((marker % MARKERS.length) + MARKERS.length) % MARKERS.length];
---

<Tag class="hb-label" id={id}>
  <svg
    class="hb-marker"
    viewBox="0 0 78 36"
    width="78"
    height="36"
    aria-hidden="true"
    focusable="false"
  >
    {stones.map((s) => (
      <path d={s.d} fill={s.fill} />
    ))}
  </svg>
  {text}
</Tag>
