---
// Safe to edit by hand
// A board E section label: small caps led by a brick marker. Renders as an h2 when it is the
// section's heading, or a <p> when the section has its own.
//
// Two markers (2026-11-09). A page head keeps the three stepped bricks from the mark
// (`marker="steps"`), once per page, where it echoes the logo. A section inside the page gets one
// brick: Home carried five of the stepped ones, and by the third they read as wallpaper.
import '@/styles/board.css';
import { MARKER } from './stones.generated';
import { layOrder } from '@/lib/brick-lay';

interface Props {
  text: string;
  as?: 'h2' | 'p';
  id?: string;
  /** "steps": the three stepped bricks, for a page head. "brick" (default): one brick. */
  marker?: 'steps' | 'brick';
}
const { text, as: Tag = 'h2', id, marker = 'brick' } = Astro.props;
const steps = marker === 'steps';
// The one brick is the marker's bottom step, the first shape gen:stones draws (x 1 to 29, y 25 to 34).
const bricks = steps ? MARKER : MARKER.slice(0, 1);
// The steps are laid bottom step first as the section comes in (src/styles/flow.css).
const markerTurns = layOrder(bricks);
---

<Tag class="hb-label" id={id}>
  <svg
    class:list={['hb-marker', !steps && 'hb-marker--brick']}
    viewBox={steps ? '0 0 78 36' : '0 24 30 11'}
    width={steps ? 78 : 30}
    height={steps ? 36 : 11}
    aria-hidden="true"
    focusable="false"
  >
    {bricks.map((s, i) => (
      <path class="lay-brick" d={s.d} fill={s.fill} style={`--lay: ${markerTurns[i]}`} />
    ))}
  </svg>
  {text}
</Tag>
