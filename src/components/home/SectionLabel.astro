---
// Safe to edit by hand
// A board E section label: small caps with a hairline, led by three gold steps from the mark
// (one marker everywhere). Renders as an h2 when it is the section's heading, or a <p> when
// the section has its own.
import '@/styles/board.css';
import { MARKER } from './stones.generated';

interface Props {
  text: string;
  as?: 'h2' | 'p';
  id?: string;
}
const { text, as: Tag = 'h2', id } = Astro.props;
---

<Tag class="hb-label" id={id}>
  <svg
    class="hb-marker"
    viewBox="0 0 78 36"
    width="78"
    height="36"
    aria-hidden="true"
    focusable="false"
  >
    {MARKER.map((s) => (
      <path d={s.d} fill={s.fill} />
    ))}
  </svg>
  {text}
</Tag>
