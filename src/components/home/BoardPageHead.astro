---
// Safe to edit by hand
// Board E's page head for the inner pages (About, Plan your visit, What we believe, Ministries,
// Watch, Contact and the rest), replacing the first pass's arched hero on 2026-10-17. White
// ground, the masthead's hairline, the eyebrow as a section label led by stepping stones, the
// title, the subhead and the buttons, all on the one left edge. No arch and no second copy of the
// mark under the header's logo.
//
// One stone moment per page (PRODUCT.md): the title is the mosaic (StoneHeading) unless the page
// already carries the mark or the baptism drawing further down, in which case `quiet` sets it in
// plain Young Serif. SectionRenderer works that out from the page's blocks.
//
// A page photo (Sanity "Background image") sits beside the words cut to the gable, on the split's
// narrow track; a stone icon, when chosen, takes that place instead of a photo, large and
// right-aligned to the container edge, centred on the title block (audit 2026-10-25, GD-H5).
import '@/styles/board.css';
import SanityImage from '@/components/SanityImage.astro';
import CtaLink from '@/components/CtaLink.astro';
import StoneHeading from '@/components/StoneHeading.astro';
import StoneIcon from '@/components/StoneIcon.astro';
import SectionLabel from './SectionLabel.astro';
import TimesBand from '@/components/church/TimesBand.astro';
import { splitHeadingAccent } from '@/lib/heading-accent';
import type { SanityImageObject } from '@/lib/pageBuilder.types';
import type { ComponentProps } from 'astro/types';

type Cta = ComponentProps<typeof CtaLink>['cta'];

interface Props {
  eyebrow?: string;
  headline: string;
  subhead?: string;
  image?: SanityImageObject | null;
  primaryCta?: Cta | null;
  secondaryCta?: Cta | null;
  headingId: string;
  icon?: string | null;
  /** The page has its own stone moment further down: set the title plain. */
  quiet?: boolean;
  /** Two-tone title (2026-10-24): these words of the title in auburn, the rest navy. */
  headingAccent?: string;
  /** The Sunday times band across the bottom of the head (TimesBand.astro, 2026-10-24). */
  showTimes?: boolean;
  /** The one-red-button rule (audit 2026-10-25): navy when an earlier block has the red. */
  primaryVariant?: 'primary' | 'navy';
  /** A collection item (a sermon): its title runs long, so it is capped at 64px, not 88. */
  detail?: boolean;
}
const {
  eyebrow,
  headline,
  subhead,
  image,
  primaryCta,
  secondaryCta,
  headingId,
  icon,
  quiet,
  headingAccent,
  showTimes = false,
  primaryVariant = 'primary',
  detail = false,
} = Astro.props as Props;
// The quiet (plain Young Serif) title takes the accent as a coloured span; the brick title draws it.
const split = splitHeadingAccent(headline, headingAccent);
const hasImage = !!image?.asset;
const side = hasImage || !!icon;
---

<section
  class:list={['board-head', showTimes && 'board-head--times', detail && 'board-head--detail']}
  aria-labelledby={headingId}
  data-hero="board"
>
  <div
    class:list={[
      'board-head__inner',
      side && 'board-head__inner--side',
      !hasImage && icon && 'board-head__inner--icon',
    ]}
  >
    <div class="board-head__copy">
      {eyebrow && <SectionLabel text={eyebrow} as="p" />}
      {quiet ? (
        <h1 id={headingId} class="board-head__title">
          {split.found ? (
            <>
              {split.before}
              <span class="board-head__accent">{split.word}</span>
              {split.after}
            </>
          ) : (
            headline
          )}
        </h1>
      ) : (
        <StoneHeading text={headline} id={headingId} accent={headingAccent} />
      )}
      {subhead && <p class="board-head__sub">{subhead}</p>}
      {(primaryCta || secondaryCta) && (
        <div class="board-head__ctas">
          {primaryCta && <CtaLink cta={primaryCta} variant={primaryVariant} />}
          {secondaryCta && <CtaLink cta={secondaryCta} variant="secondary" />}
        </div>
      )}
    </div>
    {hasImage ? (
      <div class="board-head__photo">
        <SanityImage
          source={image}
          width={720}
          sizes="(min-width: 60rem) 36vw, 100vw"
          loading="eager"
          fetchpriority="high"
          quality={70}
        />
      </div>
    ) : (
      icon && <StoneIcon name={icon} size={240} loading="eager" class="board-head__icon" />
    )}
  </div>
  {showTimes && <TimesBand />}
</section>
