---
// Safe to edit by hand
// Board E's "This week and last Sunday": the coming week beside the latest message, drawn from the
// Home "This week" block and the "Watch" block next to it (HomeBoard pairs them; either can be
// missing and the other then takes the row alone).
//
// This week is derived, never typed (rule 15): the next seven days of Site settings > Church facts
// > Service times plus Church Trac events (thisWeek()), each with the date in big deep-sky
// numerals. Last Sunday is the YouTube replay (LastSunday) once a channel is set, and until then
// the Watch block's poster card: its link label as the title, its text underneath, lifting on
// hover. Before launch, a stand-in poster gives way to a pinned "Photo needed" note on the card's
// ink ground (src/data/shot-list.ts).
import SectionLabel from './SectionLabel.astro';
import LastSunday from '@/components/church/LastSunday.astro';
import SanityImage from '@/components/SanityImage.astro';
import ShotRequest from '@/components/ShotRequest.astro';
import { exampleSrc, shotFor } from '@/data/shot-list';
import { splitStega } from '@/lib/preview-stega';
import { getChurchFacts } from '@/lib/church-data';
import { andList, monthDay, thisWeek, timesPhrase } from '@/lib/church-facts';
import { churchDataNow, loadChurchEvents } from '@/lib/church-feeds';
import { ctaHref } from '@/lib/cta-href';
import type {
  ProjectedThisWeekSection,
  ProjectedWatchSection,
  SanityImageObject,
} from '@/lib/pageBuilder.types';
import { sermonHref, sermonVideo, watchSermon } from '@/lib/sermons';
import { fixtureNewestSermon } from '@/lib/collection-queries';

interface Props {
  week?: ProjectedThisWeekSection | null;
  watch?: ProjectedWatchSection | null;
  headingId: string;
  /** The build moment; tests pass a fixed one. */
  now?: Date;
}
const { week, watch, headingId, now = churchDataNow() } = Astro.props;

const facts = await getChurchFacts();
// This week (Home audit research, 2026-10-17): the weekly schedule in one line per day (from
// Church facts, Sunday included so a quiet week still reads as a full week), then the dated
// things from the church calendar, a cancelled one struck through rather than silently missing,
// and one honest line when there is nothing extra.
const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const weekday = facts.serviceTimes;
const rhythm = [...new Set(weekday.map((s) => s.dayIndex))].map((d) => {
  const day = weekday.filter((s) => s.dayIndex === d);
  return {
    day: DAYS[d],
    time: timesPhrase(day.map((s) => s.minutes)),
    what: andList(day.map((s) => s.label)),
    confirmed: day.every((s) => s.confirmed),
  };
});
const dated = week
  ? thisWeek(facts, await loadChurchEvents(facts), now).filter((r) => r.source === 'calendar')
  : [];
const MAX_ROWS = 4;
const rows = dated.slice(0, MAX_ROWS);
const more = dated.length - rows.length;
const anyUnconfirmed = rhythm.some((r) => !r.confirmed);
const weekHeading = week?.heading || 'This week';
const watchHeading = watch?.heading || 'Last Sunday';
const label = [week && weekHeading, watch && watchHeading].filter(Boolean).join(' and ');
// Last Sunday's message (Home audit research, 2026-10-17): while the entry is under 8 days old
// the card names it (title, passage, date) and links to its video; otherwise it shows the
// block's own words. Derived from the entry's date at build time (daily rebuilds), never stale.
const lm = watch?.lastMessage;
const lmAge = lm?.date
  ? (now.getTime() - new Date(`${lm.date}T12:00:00Z`).getTime()) / 86400000
  : 99;
const fresh = Boolean(lm?.title && lmAge >= 0 && lmAge <= 8);
const lmDate =
  fresh && lm?.date
    ? new Date(`${lm.date}T12:00:00Z`).toLocaleDateString('en-US', {
        month: 'long',
        day: 'numeric',
        timeZone: 'UTC',
      })
    : '';
// "Live now" (2026-10-24): the tag and the card's jump to the stream are driven by
// src/lib/live-client.ts, the same clock as the site-wide banner (components/church/LiveBanner.astro).
// No link set (the built-in defaults, where the Watch page may not exist): a plain card.
const watchHref =
  fresh && lm?.videoUrl ? lm.videoUrl : watch?.link ? ctaHref(watch.link) : undefined;
// The sermon archive (2026-10-18). Which message the card names, first match wins:
//   1. a sermon preached in the last eight days (the Sermons list): the card names it and goes
//      to its page, ahead of the YouTube replay, because it carries the passage and the audio;
//   2. the YouTube replay (LastSunday), once a channel is set;
//   3. the hand-typed "Last Sunday's message" above, while it is under eight days old;
//   4. the newest sermon of any age, labelled "Latest message";
//   5. the block's own words and poster.
// With no sermons at all, 2, 3 and 5 are exactly what the card did before.
const { fresh: sermonNow, latest: sermonAny } = watchSermon(
  watch?.latestSermon ?? (watch ? await fixtureNewestSermon() : null),
  now,
);
const sermon = sermonNow ?? (fresh ? null : sermonAny);
const sermonPic = [sermon?.image, sermon?.series?.art].find(
  (img) => (img as { asset?: unknown } | null | undefined)?.asset,
) as SanityImageObject | undefined;
const sermonThumb = sermon && !sermonPic ? sermonVideo(sermon.videoUrl)?.thumbnailUrl : undefined;
const poster = sermon ? (sermonPic ?? (sermonThumb ? null : watch?.poster)) : watch?.poster;
// The block's own poster (step 5) is the only one with a shot request; a sermon's picture never is.
const posterShot =
  watch && poster === watch.poster
    ? shotFor(Astro.url.pathname, splitStega(watchHeading).cleaned, 0, watch.poster)
    : null;
const cardHref = sermon ? sermonHref(sermon.slug) : watchHref;
const cardTitle = sermon
  ? sermon.title
  : fresh
    ? lm?.title
    : watch?.link?.label || 'Watch the message';
const cardSub = sermon
  ? [sermonNow ? '' : 'Latest message', sermon.passage, sermon.date ? monthDay(sermon.date) : '']
      .filter(Boolean)
      .join(' · ')
  : fresh
    ? [lm?.passage, lmDate].filter(Boolean).join(' · ')
    : watch?.body;
const CardTag = cardHref ? 'a' : 'div';
---

<section class="hb-section" aria-labelledby={headingId}>
  <div class="hb-wrap">
    <SectionLabel text={label} as="p" />
    <div class="hb-pair">
      {week && (
        <div>
          <h2 id={headingId}>{weekHeading}</h2>
          {week.intro && <p class="hb-week-foot">{week.intro}</p>}
          {rhythm.length > 0 && (
            <ul class="hb-rhythm hb-num">
              {rhythm.map((r) => (
                <li>
                  <strong>Every {r.day}</strong> · {r.time} · {r.what}
                </li>
              ))}
            </ul>
          )}
          {rows.length === 0 && (
            <p class="hb-week-empty">Nothing extra on the calendar this week.</p>
          )}
          <ul class="hb-week hb-num" hidden={rows.length === 0}>
            {rows.map((r) => (
              <li class:list={[r.cancelled && 'is-cancelled']}>
                <time class="hb-week__day" datetime={r.date}>
                  {Number(r.date.slice(8, 10))}
                </time>
                <p>
                  <strong>{r.when}</strong>
                  {r.cancelled && <span class="hb-week__cancelled">Cancelled</span>}
                  <br />
                  <span class="hb-week__what">
                    {r.what} · {r.time}
                    {r.where && `, ${r.where}`}
                  </span>
                </p>
              </li>
            ))}
          </ul>
          {(anyUnconfirmed || facts.calendarPageUrl || more > 0) && (
            <p class="hb-week-foot">
              {anyUnconfirmed && 'Times to confirm. '}
              {more > 0 && `And ${more} more this week. `}
              {facts.calendarPageUrl && (
                <a href={facts.calendarPageUrl} rel="noopener" target="_blank">
                  Full calendar<span class="sr-only"> (opens Church Trac in a new tab)</span>
                </a>
              )}
            </p>
          )}
        </div>
      )}
      {watch && (
        <div>
          <h2 id={week ? undefined : headingId}>{watchHeading}</h2>
          <LastSunday showChannelLink={false} fallbackOnly={Boolean(sermonNow)}>
            <CardTag
              slot="fallback"
              class:list={['hb-watch', cardHref && 'hb-lift']}
              href={cardHref}
              data-live-link={cardHref && facts.liveUrl ? facts.liveUrl : undefined}
            >
              {posterShot && (
                <>
                  {posterShot.video ? (
                    <video
                      class="hb-watch__video"
                      src={exampleSrc(posterShot.video.file, 'mp4')}
                      poster={exampleSrc(`${posterShot.video.file}-poster`)}
                      muted
                      loop
                      playsinline
                      preload="none"
                      aria-hidden="true"
                      data-shot-video
                    />
                  ) : (
                    posterShot.example && (
                      <img src={exampleSrc(posterShot.example.file)} alt="" loading="lazy" />
                    )
                  )}
                  <span class="hb-watch__shot">
                    <ShotRequest shot={posterShot} variant="tag" />
                  </span>
                </>
              )}
              {poster?.asset && !posterShot && (
                <SanityImage
                  source={poster as never}
                  width={900}
                  sizes="(max-width: 960px) 100vw, 50vw"
                  alt=""
                  quality={65}
                />
              )}
              {sermonThumb && (
                <img
                  src={sermonThumb}
                  alt=""
                  width="480"
                  height="360"
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                />
              )}
              <span class="hb-watch__text">
                <span class="hb-watch__play" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24">
                    <path d="M8 5.5v13l11-6.5z" fill="#9A3B2A" />
                  </svg>
                </span>
                <span>
                  {facts.liveUrl && (
                    <span class="hb-watch__live" data-live-show hidden>
                      Live now
                    </span>
                  )}
                  <strong class="hb-watch__title">{cardTitle}</strong>
                  {cardSub && <span class="hb-watch__sub">{cardSub}</span>}
                </span>
              </span>
            </CardTag>
          </LastSunday>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hb-week {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 0;
  }
  .hb-week li {
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding: 18px 0;
    border-bottom: 1px solid var(--hb-line);
  }
  .hb-week p {
    margin: 0;
  }
  .hb-week__day {
    flex: none;
    width: 64px;
    font-family: var(--font-display);
    font-size: var(--fs-numeral);
    line-height: 1;
    color: var(--auburn-deep);
  }
  .hb-week__what {
    color: var(--hb-muted);
  }
  .hb-rhythm {
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
    color: var(--hb-body);
  }
  .hb-rhythm ~ .hb-week {
    border-top: 1px solid var(--hb-line);
  }
  .hb-rhythm li {
    padding: 4px 0;
  }
  .hb-rhythm strong {
    color: var(--hb-ink);
  }
  .hb-week-empty {
    margin: 0 0 12px;
    color: var(--hb-muted);
  }
  /* A cancelled event stays in the list, struck through, so nobody wonders where it went. */
  .hb-week li.is-cancelled .hb-week__what,
  .hb-week li.is-cancelled .hb-week__day {
    text-decoration: line-through;
    color: var(--hb-muted);
  }
  .hb-week__cancelled {
    margin-left: 8px;
    padding: 1px 8px;
    border-radius: 999px;
    background: #f6e4df;
    color: #7e2e20;
    font-size: var(--fs-tag);
    font-weight: 700;
  }
</style>

<script>
  // Before launch the card plays an example clip (shot-list.ts). It loads nothing until the card
  // comes on screen (preload="none", no autoplay: the clip was a fifth of the first load) and
  // pauses again when it leaves; with reduced motion it holds still on its poster.
  function initShotClip() {
    const clip = document.querySelector<HTMLVideoElement>('[data-shot-video]');
    if (!clip || clip.dataset.clipOn) return;
    clip.dataset.clipOn = '1';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const io = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) clip.play().catch(() => {});
      else clip.pause();
    });
    io.observe(clip);
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  }
  initShotClip();
  document.addEventListener('astro:page-load', initShotClip);
</script>
