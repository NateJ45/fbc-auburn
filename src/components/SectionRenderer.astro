---
// Foundation, edit with care
// Renders a page-builder section array. Maps each block _type to its component
// and OWNS the alternating background cadence for content blocks, so reordering
// can never break the page rhythm (that is why blocks have no color field). A
// content block's `look` (src/lib/section-looks.ts, rule 9 as amended) is a
// request the cadence resolves into a measured surface, never a colour.
// Self-contained blocks (hero, CTA band, stats, spacer) manage their own surface.
//
// Cadence logic lives in src/lib/sectionCadence.ts and is unit-tested separately.
// This file is thin template glue: it imports classified rows and delegates.
//
// The GROQ query that loads `sections` must project images with imageProjection
// and ctaBlocks with ctaProjection (see sectionsProjection() in queries.ts).
import Hero from '@/components/Hero.astro';
import FinalCta from '@/components/FinalCta.astro';
import StatsRow from '@/components/StatsRow.astro';
import RichTextSection from '@/components/sections/RichTextSection.astro';
import ImageText from '@/components/sections/ImageText.astro';
import GalleryGrid from '@/components/sections/GalleryGrid.astro';
import QuoteBlock from '@/components/sections/QuoteBlock.astro';
import VideoEmbed from '@/components/sections/VideoEmbed.astro';
import FounderSection from '@/components/sections/FounderSection.astro'; // scaffold: about
import StorySection from '@/components/sections/StorySection.astro'; // scaffold: about
import ServiceAreaSection from '@/components/sections/ServiceAreaSection.astro';
import GuaranteeSection from '@/components/sections/GuaranteeSection.astro';
import FaqSection from '@/components/sections/FaqSection.astro'; // scaffold: faq
import LogoStrip from '@/components/sections/LogoStrip.astro';
import TeamGrid from '@/components/sections/TeamGrid.astro';
import IconCards from '@/components/sections/IconCards.astro';
import FindYourPlace from '@/components/sections/FindYourPlace.astro';
import LetterSection from '@/components/sections/LetterSection.astro';
import ThisWeekSection from '@/components/sections/ThisWeekSection.astro';
import WatchSection from '@/components/sections/WatchSection.astro';
import EmbedSection from '@/components/sections/EmbedSection.astro';
import DynamicList from '@/components/sections/DynamicList.astro';
import StepsRail from '@/components/sections/StepsRail.astro';
import WalkSection from '@/components/sections/WalkSection.astro';
// FBC Auburn collection-fed blocks (2026-10-18)
import LatestSermon from '@/components/sections/LatestSermon.astro';
import SermonSeriesGrid from '@/components/sections/SermonSeriesGrid.astro';
import PeopleSection from '@/components/sections/PeopleSection.astro';
import DownloadsList from '@/components/sections/DownloadsList.astro';
import SectionDivider from '@/components/SectionDivider.astro';
import BoardRule from '@/components/home/BoardRule.astro';
import { classifySections } from '@/lib/sectionCadence';
import { expandSyncedSections } from '@/lib/authoring';
import type { PageBuilderBlock } from '@/lib/pageBuilder.types';
import { sectionEditAttr, type EditDoc } from '@/lib/preview-edit-attr';
import ChurchMap from '@/components/church/ChurchMap.astro';
import { getChurchFacts } from '@/lib/church-data';
import { plain } from '@/lib/church-facts';
// FBC Auburn's church section library (churchSections.ts): one branch, one dispatcher.
import ChurchBlock from '@/components/church-blocks/ChurchBlock.astro';
import { isChurchBlock } from '@/lib/churchBlocks.types';
import { anchorFor } from '@/lib/section-anchors';

interface Props {
  sections?: unknown[];
  /** Prefix for generated heading ids, so two renderers on a page do not collide. */
  idPrefix?: string;
  /**
   * PREVIEW ONLY. When the Studio preview route passes the document each
   * section belongs to, every section is wrapped in a real block box carrying a
   * `data-sanity` attribute, which is what gives the Presentation overlay its
   * in-canvas insert / duplicate / remove / drag-to-reorder controls
   * (PORTS.md card 17).
   *
   * The live pages never pass it, and with it absent the wrapper is a
   * `<Fragment>`, which renders NOTHING at all. That is why the static build's
   * markup stays byte-identical with this feature installed, and
   * `npm run parity compare` is the standing gate on that promise.
   */
  editDoc?: EditDoc;
  /**
   * True where these sections open the page, right under its page head (the Studio pages, About).
   * The first section after the page head then loads its first photo eagerly at high priority,
   * since on a phone it sits in the first screen (audit DEV-M8, 2026-10-25: Lighthouse flagged the
   * lazy-loaded LCP photo on Ministries). Every other photo stays lazy. Off (the default) for extra sections
   * drawn at the foot of a page and for Home, whose hero photo is already the priority.
   */
  leadImage?: boolean;
}

const { sections = [], idPrefix = 'section', editDoc, leadImage = false } = Astro.props as Props;
// Synced sections (the authoring kit, PORTS.md card 109) are swapped for the
// sections their saved copy holds BEFORE the cadence runs, so a synced band
// takes its place in the alternating rhythm like any typed-in band (rule 9).
// Only the five content blocks take a look (src/lib/section-looks.ts), so every other block is
// only ever handed a light surface by the cadence; this narrows the type for them.
const lightSurface = (s: string | null): 'background' | 'muted' =>
  s === 'muted' ? 'muted' : 'background';

// A section with a named anchor (src/lib/section-anchors.ts, site audit 2026-10-25) takes the name
// as its heading id, so /what-we-believe/#the-gospel lands on it; the rest keep the numbered id.
const rows = classifySections<PageBuilderBlock>(
  expandSyncedSections(sections as PageBuilderBlock[]),
  idPrefix,
).map((row) => ({
  ...row,
  headingId: anchorFor((row.block as { _key?: string })._key, row.headingId),
}));

// FBC Auburn, board E on the inner pages (2026-10-17). Every section after the hero opens with a
// rule of three stepping stones and a hairline (BoardRule), which replaced the gold-stone divider
// that marked a change of band colour (the ground is white now; src/styles/board.css). Every
// marker is the same three gold steps from the mark (Home audit, 2026-10-17).
// One stone moment per page (PRODUCT.md): a page that draws the mark or the baptism picture
// further down gets a plain title rather than the mosaic one.
// The map card goes under the rich-text band that gives the church's street address (Plan your
// visit's "Getting here"), so it follows those words if an editor moves or retitles the band
// (visitor audit, 2026-10-18). Matched on the street from Church facts, stega stripped.
const mapStreet = plain((await getChurchFacts()).address?.street).toLowerCase();
const givesAddress = (block: unknown): boolean => {
  const body = (block as { body?: unknown }).body;
  if (!mapStreet || !Array.isArray(body)) return false;
  const text = body
    .flatMap((b) =>
      ((b as { children?: { text?: string }[] })?.children ?? []).map((c) => c?.text ?? ''),
    )
    .join(' ');
  return plain(text).toLowerCase().includes(mapStreet);
};
const quietTitle = (sections as PageBuilderBlock[]).some(
  (b) =>
    b?._type === 'imageTextSection' &&
    ((b as { art?: string }).art === 'mark' || (b as { art?: string }).art === 'baptism'),
);
// A dated notice is a strip between bands, so it takes no rule of its own (church library).
const UNRULED = new Set(['heroSection', 'spacerSection', 'noticeSection']);
const ruled = rows.map(({ block }) => !UNRULED.has(block._type));
// The first Questions block on a page answers to #questions (2026-10-24): /faq/ forwards to
// /plan-your-visit/#questions since the Questions page was merged into Plan your visit.
const firstFaq = rows.findIndex(({ block }) => block._type === 'faqSection');
// The section whose first photo loads eagerly (leadImage above): the first one after the page
// head, so a hero, a spacer or a notice band is skipped. -1 when leadImage is off.
const LEAD_SKIP = new Set(['heroSection', 'spacerSection', 'noticeSection']);
const leadRow = leadImage ? rows.findIndex(({ block }) => !LEAD_SKIP.has(block._type)) : -1;
// One red button per page (audit 2026-10-25, GD-H2; DESIGN.md): the filled auburn button is the
// page's single primary next step. The first block that draws a primary button keeps the red; every
// later one draws it in solid navy. A closing band always draws a button (it has a fallback).
const drawsRed = (block: unknown): boolean => {
  const b = block as {
    _type?: string;
    primaryCta?: { label?: string } | null;
    endLinkLabel?: string;
  };
  if (b._type === 'ctaBandSection') return true;
  if (b._type === 'heroSection' || b._type === 'stepsRailSection') return !!b.primaryCta?.label;
  if (b._type === 'walkSection') return !!b.endLinkLabel;
  return false;
};
const redRow = rows.findIndex(({ block }) => drawsRed(block));
const primaryVariant = (i: number): 'primary' | 'navy' => (i === redRow ? 'primary' : 'navy');

// A real element in preview, nothing at all on the live site. The wrapper must
// NOT be `display: contents`: the overlay outlines the element's rect, and a
// contents element has none. A plain block-level div around a full-width
// <section> changes no layout.
const Wrap = editDoc ? 'div' : Fragment;
const wrapAttrs = (key: string | undefined) =>
  editDoc && key ? { 'data-sanity': sectionEditAttr(editDoc, key) } : {};
// A section that came out of a synced section is not in the page itself; its
// in-canvas controls act on the synced block it came from, which is.
const editKeyOf = (block: unknown) => {
  const b = block as { _key?: string; _editKey?: string };
  return b._editKey ?? b._key;
};
---

{rows.map(({ block: s, surface, headingId }, rowIndex) => (
  <>
    {ruled[rowIndex] && <BoardRule />}

    <Wrap {...wrapAttrs(editKeyOf(s))}>
      {s._type === 'heroSection' ? (
        <Hero
          eyebrow={s.eyebrow}
          headline={s.headline ?? ''}
          subhead={s.subhead}
          backgroundImage={s.backgroundImage}
          primaryCta={s.primaryCta}
          secondaryCta={s.secondaryCta}
          scriptAccent={s.scriptAccent}
          headingAccent={s.headingAccent}
          showTimes={s.showTimes ?? false}
          size={s.size ?? 'short'}
          icon={s.icon}
          quiet={quietTitle}
          headingId={headingId}
          primaryVariant={primaryVariant(rowIndex)}
        />
      ) : s._type === 'ctaBandSection' ? (
        <FinalCta
          eyebrow={s.eyebrow}
          headline={s.headline}
          subhead={s.subhead}
          subheadRich={s.subheadRich}
          cta={s.cta}
          scriptAccent={s.scriptAccent}
          headingAccent={s.headingAccent}
          backgroundImage={s.backgroundImage}
          headingId={headingId}
          primaryVariant={primaryVariant(rowIndex)}
        />
      ) : s._type === 'statSection' ? (
        <StatsRow
          stats={
            (s.stats ?? []).filter((x) => typeof x?.number === 'number') as {
              number: number;
              suffix?: string;
              label: string;
            }[]
          }
        />
      ) : s._type === 'spacerSection' ? (
        s.variant === 'space' ? (
          <div class="py-section-md" aria-hidden="true" />
        ) : (
          <SectionDivider variant={s.variant === 'line' ? 'line' : 'ornament'} />
        )
      ) : s._type === 'richTextSection' ? (
        <RichTextSection
          eyebrow={s.eyebrow}
          heading={s.heading}
          scriptAccent={s.scriptAccent}
          headingAccent={s.headingAccent}
          body={s.body}
          width={s.width}
          align={s.align}
          surface={surface ?? 'background'}
          headingId={headingId}
        >
          {givesAddress(s) && <ChurchMap />}
        </RichTextSection>
      ) : s._type === 'imageTextSection' ? (
        <ImageText
          art={s.art}
          image={s.image}
          imageSide={s.imageSide}
          eyebrow={s.eyebrow}
          heading={s.heading}
          body={s.body}
          cta={s.cta}
          surface={surface ?? 'background'}
          headingId={headingId}
          isFirst={rowIndex === leadRow}
        />
      ) : s._type === 'gallerySection' ? (
        <GalleryGrid
          heading={s.heading}
          images={s.images}
          columns={s.columns}
          surface={surface ?? 'background'}
          headingId={headingId}
        />
      ) : s._type === 'quoteSection' ? (
        <QuoteBlock
          quote={s.quote}
          attribution={s.attribution}
          detail={s.detail}
          surface={surface ?? 'background'}
        />
      ) : s._type === 'videoSection' ? (
        <VideoEmbed
          url={s.url}
          heading={s.heading}
          caption={s.caption}
          surface={surface ?? 'background'}
          headingId={headingId}
        />
      ) : // scaffold-branch: about
      s._type === 'founderSection' ? (
        <FounderSection
          portrait={s.portrait}
          eyebrow={s.eyebrow}
          headline={s.headline}
          content={s.content}
          cta={s.cta}
          headingId={headingId}
        />
      ) : // scaffold-branch: about
      s._type === 'storySection' ? (
        <StorySection
          eyebrow={s.eyebrow}
          headline={s.headline}
          content={s.content}
          portrait={s.portrait}
          attribution={s.attribution}
          credentialLine={s.credentialLine}
          serviceAreaLine={s.serviceAreaLine}
          surface={lightSurface(surface)}
          headingId={headingId}
        />
      ) : s._type === 'serviceAreaSection' ? (
        <ServiceAreaSection
          eyebrow={s.eyebrow}
          headline={s.headline}
          description={s.description}
          travelFees={s.travelFees ?? []}
          showTravelFees={s.showTravelFees ?? true}
          surface={lightSurface(surface)}
          headingId={headingId}
        />
      ) : s._type === 'guaranteeSection' ? (
        <GuaranteeSection
          text={s.text}
          siteSettingsText={s.siteSettingsText}
          surface={lightSurface(surface)}
        />
      ) : // scaffold-branch: faq
      s._type === 'faqSection' ? (
        <FaqSection
          eyebrow={s.eyebrow}
          headline={s.headline}
          headingAccent={s.headingAccent}
          subhead={s.subhead}
          subheadRich={s.subheadRich}
          items={s.items ?? []}
          cta={s.cta}
          headingId={headingId}
          anchor={rowIndex === firstFaq ? 'questions' : undefined}
          schema={rowIndex === firstFaq}
        />
      ) : s._type === 'logoStripSection' ? (
        <LogoStrip
          eyebrow={s.eyebrow}
          headline={s.headline}
          logos={s.logos ?? []}
          layout={s.layout ?? 'row'}
          headingId={headingId}
        />
      ) : s._type === 'iconCardsSection' ? (
        <IconCards
          eyebrow={s.eyebrow}
          heading={s.heading}
          intro={s.intro}
          cards={s.cards ?? []}
          surface={lightSurface(surface)}
          headingId={headingId}
        />
      ) : s._type === 'letterSection' ? (
        <LetterSection
          eyebrow={s.eyebrow}
          greeting={s.greeting}
          body={s.body ?? []}
          signOff={s.signOff}
          signature={s.signature}
          name={s.name}
          role={s.role}
          link={s.link}
          surface={lightSurface(surface)}
          headingId={headingId}
        />
      ) : s._type === 'findYourPlaceSection' ? (
        <FindYourPlace
          eyebrow={s.eyebrow}
          heading={s.heading}
          intro={s.intro}
          groups={s.groups ?? []}
          surface={lightSurface(surface)}
          headingId={headingId}
          isFirst={rowIndex === leadRow}
        />
      ) : s._type === 'thisWeekSection' ? (
        <ThisWeekSection
          heading={s.heading}
          intro={s.intro}
          mode={s.mode}
          surface={lightSurface(surface)}
          headingId={headingId}
        />
      ) : s._type === 'watchSection' ? (
        <WatchSection
          eyebrow={s.eyebrow}
          heading={s.heading}
          body={s.body}
          link={s.link}
          poster={s.poster}
          fallback={s.fallback}
          latestSermon={s.latestSermon}
          surface={lightSurface(surface)}
          headingId={headingId}
        />
      ) : s._type === 'teamSection' ? (
        <TeamGrid
          eyebrow={s.eyebrow}
          headline={s.headline}
          subhead={s.subhead}
          subheadRich={s.subheadRich}
          members={s.members ?? []}
          headingId={headingId}
        />
      ) : s._type === 'embedSection' ? (
        <EmbedSection
          eyebrow={s.eyebrow}
          headline={s.headline}
          subhead={s.subhead}
          embedUrl={s.embedUrl}
          embedCode={s.embedCode}
          runsOnPage={s.runsOnPage === true}
          heightHint={s.heightHint ?? 'medium'}
          headingId={headingId}
        />
      ) : s._type === 'dynamicListSection' ? (
        <DynamicList
          eyebrow={s.eyebrow}
          headline={s.headline}
          subhead={s.subhead}
          subheadRich={s.subheadRich}
          source={s.source}
          items={s.items ?? []}
          cta={s.cta}
          columns={s.columns}
          limit={s.limit}
          headingId={headingId}
        />
      ) : s._type === 'stepsRailSection' ? (
        <StepsRail
          heading={s.heading}
          intro={s.intro}
          steps={s.steps ?? []}
          endHeading={s.endHeading}
          primaryCta={s.primaryCta}
          secondaryCta={s.secondaryCta}
          surface={lightSurface(surface)}
          headingId={headingId}
          primaryVariant={primaryVariant(rowIndex)}
        />
      ) : s._type === 'walkSection' ? (
        <WalkSection
          heading={s.heading}
          intro={s.intro}
          stops={s.stops ?? []}
          endHeading={s.endHeading}
          endBody={s.endBody}
          endLinkLabel={s.endLinkLabel}
          endLinkHref={s.endLinkHref}
          surface={lightSurface(surface)}
          headingId={headingId}
          primaryVariant={primaryVariant(rowIndex)}
        />
      ) : s._type === 'latestSermonSection' ? (
        <LatestSermon
          heading={s.heading}
          intro={s.intro}
          sermon={s.sermon}
          bibleVersion={s.bibleVersion}
          surface={lightSurface(surface)}
          headingId={headingId}
        />
      ) : s._type === 'sermonSeriesSection' ? (
        <SermonSeriesGrid
          heading={s.heading}
          intro={s.intro}
          limit={s.limit}
          series={s.series ?? []}
          surface={lightSurface(surface)}
          headingId={headingId}
        />
      ) : s._type === 'peopleSection' ? (
        <PeopleSection
          heading={s.heading}
          intro={s.intro}
          mode={s.mode}
          items={s.items ?? []}
          showBios={s.showBios ?? true}
          surface={lightSurface(surface)}
          headingId={headingId}
        />
      ) : s._type === 'downloadsSection' ? (
        <DownloadsList
          heading={s.heading}
          intro={s.intro}
          category={s.category}
          limit={s.limit}
          showDates={s.showDates ?? true}
          featureBulletin={s.featureBulletin ?? false}
          items={s.items ?? []}
          bulletins={s.bulletins}
          surface={lightSurface(surface)}
          headingId={headingId}
        />
      ) : isChurchBlock(s) ? (
        <ChurchBlock block={s} surface={lightSurface(surface)} headingId={headingId} />
      ) : (
        // Unknown block type: render nothing, log in dev.
        import.meta.env.DEV &&
        console.warn(
          // `s` is `never` here: every member of PageBuilderBlock is handled
          // above, which is exactly what this branch exists to prove. The cast
          // is only so the runtime warning can name the type Sanity actually
          // sent when a NEW block ships without a mapping. Written as a
          // Record rather than an inline object type on purpose: a brace
          // inside an .astro template expression ends that expression, even
          // inside a comment, so an inline object type breaks the parse.
          `[SectionRenderer] Unknown block type: "${(s as Record<string, unknown>)._type}". Add a mapping in SectionRenderer.astro.`,
        )
      )}
    </Wrap>
  </>
))}
