---
// Foundation, edit with care
// Site footer. Compact layout that reads as a SEPARATE zone from the FinalCta
// section that sits above it on most pages.
//
// Color decoupling: the footer uses bg-muted (Cream in light, dark warm in
// dark) so it doesn't visually merge with the Charcoal Dark FinalCta. The
// 4px Warm Bronze accent stripe at the top is the same brand signature
// used in the header and mobile menu drawer.
//
// Structure (top to bottom):
//   1. Bronze accent stripe
//   2. Optional newsletter signup (only when siteSettings.newsletter.enabled)
//   3. Compact brand bar: logo + tagline side by side (one short row, not a
//      tall stacked block) so the footer stays roughly half its old height.
//   4. Five-column link grid: Studio / Work / Free tools / Latest projects /
//      Get in touch (email, phone, location, socials).
//   5. Thin bottom bar: auto-year copyright, privacy link, optional "Site
//      by..." credit, all on one line.
//
// Tailwind v4 gotcha: max-w-xs/s/m/l are shadowed by this project's custom
// --spacing-* tokens (they resolve to a few px, not the container scale). Use
// max-w-md / max-w-2xl / arbitrary values like max-w-[28rem] for text widths.
//
// Latest projects pull from Sanity. Gracefully degrades to a "see portfolio"
// message when nothing is published yet.

import { site } from '@/data/site';
import {
  IconBrandInstagram,
  IconBrandFacebook,
  IconBrandLinkedin,
  IconBrandPinterest,
  IconBrandYoutube,
  IconBrandTiktok,
  IconBrandX,
  IconLink,
  IconPlayerPlay,
} from '@tabler/icons-react';
import { Mail, Phone } from 'lucide-react';
import CopyEmailButton from '@/components/CopyEmailButton';
import NewsletterSignup from '@/components/NewsletterSignup';
import { getAllProjects, getNavPages, type CoreProjectCard } from '@/lib/queries';
import { mergePageSwitches } from '@/lib/page-switches';
// The brand row shows the mark (board E, 2026-10-17); the lockup lives in the header.
import { getSectionVisibility } from '@/lib/sectionVisibility';
import { resolveSiteSettings, type RawChromeSettings } from '@/lib/siteSettings';
import markAsset from '@/assets/brand/fbc-auburn-icon-full-color.svg';
import { getChurchFacts } from '@/lib/church-data';
import { ctaHref, type CtaTarget } from '@/lib/cta-href';
import { sundayIcs, thisSunday } from '@/lib/church-facts';
import { churchDataNow } from '@/lib/church-feeds';
import NotConfirmed from '@/components/church/NotConfirmed.astro';
import Sill from '@/components/Sill.astro';

interface NewsletterConfig {
  enabled?: boolean;
  heading?: string;
  blurb?: string;
  buttonLabel?: string;
  successMessage?: string;
  consentNote?: string;
  formActionUrl?: string | null;
  audienceId?: string | null;
}

interface SocialLink {
  platform?: string;
  url?: string;
  label?: string;
}

interface Props {
  siteSettings?:
    | (RawChromeSettings & {
        title?: string;
        email?: string;
        phone?: string;
        socialInstagram?: string;
        socialFacebook?: string;
        socialLinks?: SocialLink[] | null;
        serviceAreas?: string[];
        tagline?: string;
        footerCredit?: string;
        footerCreditUrl?: string;
        footerInvite?: string;
        footerAbout?: string;
        footerSecondaryCta?: CtaTarget & { label?: string };
        newsletter?: NewsletterConfig | null;
      })
    | null;
}

const { siteSettings } = Astro.props as Props;

// The chrome (footer columns, the small-print row, the social switch) resolves
// through one shared helper (see src/lib/siteSettings.ts) so the footer can't
// drift from the header. Both menus come back EMPTY when Sanity is empty, and
// the built-in markup below renders instead.
const chrome = resolveSiteSettings(siteSettings);

// Normalize section visibility. Unset => visible (safe default for live site).
const visible = getSectionVisibility(siteSettings?.sectionVisibility);

const brandName = siteSettings?.title ?? site.name;

// Social links: prefer the new socialLinks array; fall back to the legacy
// socialInstagram / socialFacebook fields so existing datasets keep working.
// The footer's own "show social buttons" switch (Site Settings -> Navigation).
// Unset means yes, so an untouched site is unchanged.
const showFooterSocials = chrome.showFooterSocials;
const rawSocialLinks = showFooterSocials ? (siteSettings?.socialLinks ?? []) : [];
const ig = showFooterSocials ? (siteSettings?.socialInstagram ?? '') : '';
const fb = showFooterSocials ? (siteSettings?.socialFacebook ?? '') : '';
const socialLinksToRender: SocialLink[] =
  rawSocialLinks.length > 0
    ? rawSocialLinks.filter((l) => l?.url)
    : [
        ...(ig ? [{ platform: 'Instagram', url: ig }] : []),
        ...(fb ? [{ platform: 'Facebook', url: fb }] : []),
      ];

// Map platform name to a Tabler icon component.
function socialIcon(platform: string | undefined) {
  switch (platform) {
    case 'Instagram':
      return IconBrandInstagram;
    case 'Facebook':
      return IconBrandFacebook;
    case 'LinkedIn':
      return IconBrandLinkedin;
    case 'Pinterest':
      return IconBrandPinterest;
    case 'YouTube':
      return IconBrandYoutube;
    case 'TikTok':
      return IconBrandTiktok;
    case 'X':
      return IconBrandX;
    // Tabler has no Houzz brand icon; the generic link icon covers it.
    default:
      return IconLink;
  }
}
// Copyright auto-updates every build via new Date(). The "Site by..." line
// (siteCredit + siteCreditUrl) is a SEPARATE concept that sits next to the
// auto-year copyright in the thin bottom bar.
const currentYear = new Date().getFullYear();
const siteCredit = siteSettings?.footerCredit;
const siteCreditUrl = siteSettings?.footerCreditUrl;

// Optional editor-managed footer columns. When non-empty, these replace the
// built-in Studio / Work / Free tools columns. "Get in touch" always renders
// as the last column regardless. Additive: empty = built-in defaults.
// A custom page ticked "Show in the footer" joins the last row (src/lib/page-switches.ts).
const sanityFooterColumns = mergePageSwitches([], chrome.footerColumns, await getNavPages()).footer;
const useCustomFooterColumns = sanityFooterColumns.length > 0;

// The small-print row at the very bottom. EMPTY means "keep the built-in
// privacy link", which is rendered as its own markup below.
const LEGAL_LINKS = chrome.legalNav;

// Pull the three most recent projects for the Latest Projects column.
// Falls back to an empty array when Sanity isn't reachable (build won't fail).
const allProjects: CoreProjectCard[] = (await getAllProjects().catch(() => [])) ?? [];
const latestProjects = allProjects.slice(0, 3);

// FBC Auburn, board E (2026-10-17): the ink footer's brand row. The mark with the tagline, then
// Sundays, Find us and Follow, all from Site settings (facts derived, never typed).
const footerFacts = await getChurchFacts();
const footerSundays = footerFacts.serviceTimes.filter((t) => t.dayIndex === 0);
const footerSundaysConfirmed = footerSundays.every((t) => t.confirmed);
const footerAddress = footerFacts.address;
// Phone, email, the Facebook page and the live stream link, all from Church facts and each null
// until filled in (visitor audit, 2026-10-18).
const { phone, email, facebookUrl, liveUrl } = footerFacts;
// The Facebook page gets a words link unless the social buttons below already show it.
const facebookText =
  facebookUrl && !socialLinksToRender.some((l) => l.platform === 'Facebook') ? facebookUrl : null;
const hasTouch = !!(email || phone || liveUrl || facebookText || socialLinksToRender.length > 0);
// The closing invitation (Home audit research, 2026-10-17): the footer's first row is the last
// thing on every page, so it ends with the two next steps a stranger can take. The visit button
// goes where the header's button goes, so a build without Sanity never links to a missing page.
const visitCta = chrome.headerCta.show ? chrome.headerCta : null;
// The footer's own words (Site settings > Social & footer), each with the built-in fallback.
const footerInvite =
  siteSettings?.footerInvite || 'Come along on a Sunday, or ask us anything first.';
const footerAbout = siteSettings?.footerAbout || 'A Southern Baptist church in Ross Township, Ohio';
const secondaryCta = siteSettings?.footerSecondaryCta?.label
  ? { label: siteSettings.footerSecondaryCta.label, href: ctaHref(siteSettings.footerSecondaryCta) }
  : { label: 'Ask a question', href: '/contact/' };
// The This Sunday panel and its calendar link, from the same facts as Home's card.
const sunday = thisSunday(footerFacts, churchDataNow());
const hasCalendar =
  sundayIcs({ ...footerFacts, title: site.name }, churchDataNow(), site.url) !== null;
---

<footer class="site-footer bg-muted text-foreground">
  {/* FBC Auburn footer (2026-10-18): the last screen of every page, built as a doorstep.
      1. The sill: a band of the mark's stones across the top edge, in the story's colours.
      2. The closing invitation (the tagline at display size, two next steps) beside a live
         This Sunday panel: date, times, address, Directions, all from Church facts.
      3. The link row (Sanity footer columns; Follow and Get in touch only when filled).
      4. The signature: a giant mosaic "Auburn" across the full width, running off the bottom.
      5. A slim bottom bar.
      The whole footer is ink: .site-footer redefines the colour tokens (src/styles/auburn.css),
      so the starter's link grid below turns light-on-ink without touching its classes. */}
  <Sill class="site-footer__sill" />

  <div class="sf-top mx-auto max-w-content px-l">
    <div class="sf-invite">
      <img
        class="sf-invite__mark"
        src={markAsset.src}
        width={72}
        height={72}
        alt=""
        loading="lazy"
        decoding="async"
      />
      {siteSettings?.tagline && <p class="sf-invite__tagline">{siteSettings.tagline}</p>}
      <p class="sf-invite__line">{footerInvite}</p>
      <div class="sf-invite__actions">
        {visitCta && (
          <a class="btn-auburn btn-auburn--primary" href={visitCta.href}>
            {visitCta.label}
          </a>
        )}
        <a class="btn-auburn btn-auburn--secondary" href={secondaryCta.href}>
          {secondaryCta.label}
        </a>
      </div>
    </div>

    {sunday && (
      <div class="sf-sunday" role="group" aria-labelledby="sf-sunday-title">
        {/* A group, not an aside: Home's This Sunday card is the page's complementary landmark of
            that name, and two would clash (axe landmark-unique). */}
        <div class="sf-sunday__top">
          <p class="sf-sunday__eyebrow" id="sf-sunday-title">
            {sunday.isToday ? 'Today' : 'This Sunday'}
          </p>
          <NotConfirmed
            confirmed={sunday.confirmed}
            label="Times to confirm"
            class="sf-sunday__tag"
          />
        </div>
        <p class="sf-sunday__date">
          <time datetime={sunday.date}>{sunday.dateLabel.replace(/^Sunday, /, '')}</time>
        </p>
        <dl class="sf-sunday__times">
          {sunday.services.map((s) => (
            <div>
              <dt>{s.timeLabel.replace(/ am$/, '')}</dt>
              <dd>{s.label}</dd>
            </div>
          ))}
        </dl>
        {footerAddress && (
          <div class="sf-sunday__where">
            <p>
              {footerAddress.street}
              <br />
              {footerAddress.lines[1]}
            </p>
            {footerAddress.findUs && <p class="sf-sunday__findus">{footerAddress.findUs}</p>}
            <p class="sf-sunday__links">
              <a href={footerAddress.mapsUrl} rel="noopener" target="_blank">
                Directions<span class="sr-only"> (opens Google Maps in a new tab)</span>
              </a>
              {hasCalendar && (
                <a href="/sunday.ics" download>
                  Add to my calendar
                </a>
              )}
            </p>
          </div>
        )}
      </div>
    )}
  </div>

  {/* Newsletter signup — renders only when siteSettings.newsletter.enabled is
       true. Island hydrates when scrolled into view. */}
  {siteSettings?.newsletter?.enabled && (
    <div class="mx-auto max-w-content px-l pt-l">
      <div class="mx-auto max-w-md">
        <NewsletterSignup client:visible newsletter={siteSettings.newsletter} source="footer" />
      </div>
    </div>
  )}

  {/* Link grid. FBC Auburn (Home audit, 2026-10-17): it takes the brand row's own columns
       (.site-footer__links in src/styles/auburn.css), so Visit, Belong and Connect line up under
       the tagline, Sundays and Find us; two columns on phones. When siteSettings.footerColumns is
       non-empty, the custom Sanity columns replace the built-in ones. Get in touch renders only
       when there is an email, a phone or a social link to show. */}
  <div class="site-footer__links mx-auto grid max-w-content gap-l px-l pt-l pb-m text-left">
    {/* --- Editor-managed columns (from Sanity siteSettings.footerColumns) --- */}
    {useCustomFooterColumns ? (
      sanityFooterColumns.map((col, colIdx) => (
        <nav aria-labelledby={`footer-custom-${colIdx}`}>
          <p
            id={`footer-custom-${colIdx}`}
            class="mb-s text-xs tracking-eyebrow text-foreground/80 uppercase"
          >
            {col.title}
          </p>
          <ul class="list-none p-0 text-sm">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    ) : (
      <>
        {/* --- Built-in columns (default when footerColumns is empty) --- */}

        {/* STUDIO */}
        <nav aria-labelledby="footer-studio">
          <p id="footer-studio" class="mb-s text-xs tracking-eyebrow text-foreground/80 uppercase">
            Our church
          </p>
          <ul class="list-none p-0 text-sm">
            {/* scaffold: about */}
            <li>
              <a
                href="/about/"
                class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
              >
                About
              </a>
            </li>
            {/* scaffold:end */}
            {/* scaffold: faq */}
            <li>
              <a
                href="/faq/"
                class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
              >
                FAQ
              </a>
            </li>
            {/* scaffold:end */}
            {visible.press && (
              <li>
                <a
                  href="/press/"
                  class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
                >
                  Press
                </a>
              </li>
            )}
          </ul>
        </nav>

        {/* WORK */}
        <nav aria-labelledby="footer-work">
          <p id="footer-work" class="mb-s text-xs tracking-eyebrow text-foreground/80 uppercase">
            Read
          </p>
          <ul class="list-none p-0 text-sm">
            {visible.portfolio && (
              <li>
                <a
                  href="/portfolio/"
                  class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
                >
                  Portfolio
                </a>
              </li>
            )}
            {visible.portfolio && (
              <li>
                <a
                  href="/portfolio/before-after/"
                  class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
                >
                  Before &amp; After
                </a>
              </li>
            )}
            {/* scaffold: journal */}
            {visible.journal && (
              <li>
                <a
                  href="/journal/"
                  class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
                >
                  Journal
                </a>
              </li>
            )}
            {/* scaffold:end */}
            {visible.shop && (
              <li>
                <a
                  href="/shop/"
                  class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
                >
                  Shop
                </a>
              </li>
            )}
            {visible.giftCertificates && (
              <li>
                <a
                  href="/gift-certificates/"
                  class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
                >
                  Gift Certificates
                </a>
              </li>
            )}
          </ul>
        </nav>

        {/* FREE TOOLS & GUIDES: only when one of its modules is switched on (FBC Auburn has none). */}
        {(visible.styleQuiz || visible.budgetCalculator || visible.guides || visible.resources) && (
          <nav aria-labelledby="footer-tools">
            <p id="footer-tools" class="mb-s text-xs tracking-eyebrow text-foreground/80 uppercase">
              Free tools &amp; guides
            </p>
            <ul class="list-none p-0 text-sm">
              {visible.styleQuiz && (
                <li>
                  <a
                    href="/quiz/"
                    class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
                  >
                    Style Quiz
                  </a>
                </li>
              )}
              {visible.budgetCalculator && (
                <li>
                  <a
                    href="/calculator/"
                    class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
                  >
                    Cost Calculator
                  </a>
                </li>
              )}
              {visible.guides && (
                <li>
                  <a
                    href="/guides/"
                    class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
                  >
                    Guides
                  </a>
                </li>
              )}
              {visible.resources && (
                <li>
                  <a
                    href="/resources/"
                    class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
                  >
                    Resources
                  </a>
                </li>
              )}
            </ul>
          </nav>
        )}
      </>
    )}

    {/* LATEST PROJECTS — only when portfolio is visible. */}
    {visible.portfolio ? (
      <nav aria-labelledby="footer-latest">
        <p id="footer-latest" class="mb-s text-xs tracking-eyebrow text-foreground/80 uppercase">
          Latest projects
        </p>
        {latestProjects.length > 0 ? (
          <ul class="list-none p-0 text-sm">
            {latestProjects.map((p) => (
              <li>
                <a
                  href={`/portfolio/${p.slug?.current ?? ''}/`}
                  class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
                >
                  {p.title}
                </a>
              </li>
            ))}
            <li class="pt-xs">
              <a
                href="/portfolio/"
                class="inline-flex min-h-[44px] items-center gap-xs text-xs font-semibold tracking-eyebrow text-link uppercase transition-colors hover:text-primary-dark"
              >
                View all <span aria-hidden="true">→</span>
              </a>
            </li>
          </ul>
        ) : (
          <p class="text-sm text-foreground/85 italic">
            Case studies are coming soon.{' '}
            <a
              href="/portfolio/"
              class="text-link underline underline-offset-2 hover:text-primary-dark"
            >
              See the portfolio →
            </a>
          </p>
        )}
      </nav>
    ) : null}

    {/* GET IN TOUCH: email, phone, the live stream, Facebook, socials. Skipped when there is none. */}
    {hasTouch && (
      <div>
        <p class="mb-s text-xs tracking-eyebrow text-foreground/80 uppercase">Get in touch</p>
        <div class="space-y-1 text-sm">
          {email && (
            <p>
              <CopyEmailButton client:visible email={email.display} variant="link" />
              <NotConfirmed confirmed={email.confirmed} />
            </p>
          )}
          {phone && (
            <p>
              <a
                href={phone.tel}
                class="inline-flex min-h-[44px] items-center gap-xs text-link transition-colors hover:text-primary-dark"
              >
                <Phone size={14} aria-hidden="true" />
                {phone.display}
              </a>
              <NotConfirmed confirmed={phone.confirmed} />
            </p>
          )}
          {liveUrl && (
            <p>
              <a
                href={liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-[44px] items-center gap-xs text-link transition-colors hover:text-primary-dark"
              >
                <IconPlayerPlay size={14} stroke={1.75} aria-hidden="true" />
                Watch live on Sunday<span class="sr-only"> (opens in a new tab)</span>
              </a>
            </p>
          )}
          {facebookText && (
            <p>
              <a
                href={facebookText}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-[44px] items-center gap-xs text-link transition-colors hover:text-primary-dark"
              >
                <IconBrandFacebook size={14} stroke={1.75} aria-hidden="true" />
                Facebook<span class="sr-only"> (opens in a new tab)</span>
              </a>
            </p>
          )}
        </div>
        <p class="mt-s text-sm text-foreground/75">{site.name}</p>
        {socialLinksToRender.length > 0 && (
          <ul class="mt-m flex list-none justify-start gap-s p-0 text-sm">
            {socialLinksToRender.map((link) => {
              const Icon = socialIcon(link.platform);
              const ariaLabel = link.label ?? link.platform ?? 'Social link';
              return (
                <li>
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={ariaLabel}
                    class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-border text-foreground transition-colors hover:border-primary-dark hover:bg-primary-dark hover:text-white"
                  >
                    <Icon size={20} stroke={1.5} />
                  </a>
                </li>
              );
            })}
          </ul>
        )}
      </div>
    )}
  </div>

  {/* The signature: the church's name in the mosaic letters at full width, running off the bottom
      edge. Decorative (the name is in the bottom bar as text). */}
  <div class="sf-signature" aria-hidden="true">
    <div class="sf-signature__word">
      {['A', 'u', 'b', 'u', 'r', 'n'].map((c, i) => (
        <span class={`s${i % 4}`}>{c}</span>
      ))}
    </div>
  </div>

  <div class="sf-bottom">
    <div class="sf-bottom__inner mx-auto max-w-content px-l">
      <p>
        © {currentYear} {brandName}
        <span class="sf-bottom__dot" aria-hidden="true">
          ·
        </span>
        <span class="sf-bottom__about">{footerAbout}</span>
      </p>
      <div class="sf-bottom__links">
        {LEGAL_LINKS.length > 0 ? (
          LEGAL_LINKS.map((l) => <a href={l.href}>{l.label}</a>)
        ) : (
          <a href="/privacy/">Privacy policy</a>
        )}
        {siteCredit &&
          (siteCreditUrl ? (
            <a href={siteCreditUrl} target="_blank" rel="noopener noreferrer">
              {siteCredit}
            </a>
          ) : (
            <span>{siteCredit}</span>
          ))}
        <a href="#main" class="sf-bottom__top">
          Back to top <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>
