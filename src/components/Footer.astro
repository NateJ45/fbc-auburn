---
// Foundation, edit with care
// Site footer. Compact layout that reads as a SEPARATE zone from the FinalCta
// section that sits above it on most pages.
//
// Color decoupling: the footer uses bg-muted (Cream in light, dark warm in
// dark) so it doesn't visually merge with the Charcoal Dark FinalCta. The
// 4px Warm Bronze accent stripe at the top is the same brand signature
// used in the header and mobile menu drawer.
//
// Structure (top to bottom):
//   1. Bronze accent stripe
//   2. Optional newsletter signup (only when siteSettings.newsletter.enabled)
//   3. Compact brand bar: logo + tagline side by side (one short row, not a
//      tall stacked block) so the footer stays roughly half its old height.
//   4. Five-column link grid: Studio / Work / Free tools / Latest projects /
//      Get in touch (email, phone, location, socials).
//   5. Thin bottom bar: auto-year copyright, privacy link, optional "Site
//      by..." credit, all on one line.
//
// Tailwind v4 gotcha: max-w-xs/s/m/l are shadowed by this project's custom
// --spacing-* tokens (they resolve to a few px, not the container scale). Use
// max-w-md / max-w-2xl / arbitrary values like max-w-[28rem] for text widths.
//
// Latest projects pull from Sanity. Gracefully degrades to a "see portfolio"
// message when nothing is published yet.

import { site } from '@/data/site';
import { IconBrandFacebook, IconMail, IconPlayerPlay, IconUser } from '@tabler/icons-react';
import { resolveSocialLinks, socialLabel, type SocialLink } from '@/lib/social-links';
import { socialIcon } from '@/lib/social-icons';
import { HandHeart, Mail, Phone } from 'lucide-react';
import { GIVE_PATH, giveHref } from '@/lib/give';
import CopyEmailButton from '@/components/CopyEmailButton.astro';
import NewsletterSignup from '@/components/NewsletterSignup';
import { getAllProjects, getNavPages, type CoreProjectCard } from '@/lib/queries';
import { mergePageSwitches } from '@/lib/page-switches';
// The brand row shows the mark (board E, 2026-10-17); the lockup lives in the header.
import { getSectionVisibility } from '@/lib/sectionVisibility';
import { resolveSiteSettings, type RawChromeSettings } from '@/lib/siteSettings';
// The small cut on its paper plate: the cut cross and mortar would show the ink ground otherwise.
import markAsset from '@/assets/brand/fbc-auburn-icon-white.svg';
import { urlFor } from '@/lib/sanity';
import { getChurchFacts } from '@/lib/church-data';
import type { CtaTarget } from '@/lib/church-cta-href';
import { sundayIcs, thisSunday } from '@/lib/church-facts';
import { churchDataNow } from '@/lib/church-feeds';
import NotConfirmed from '@/components/church/NotConfirmed.astro';
import Sill from '@/components/Sill.astro';
import WhereNext from '@/components/WhereNext.astro';
import BuildingSketch from '@/components/church/BuildingSketch.astro';
import { CLIENT_NOTES_ACTIVE } from '@/data/client-notes';
import SundayBar from '@/components/church/SundayBar.astro';
import SundayChange from '@/components/church/SundayChange.astro';
import { publicPath } from '@/lib/page-path';

interface NewsletterConfig {
  enabled?: boolean;
  heading?: string;
  blurb?: string;
  buttonLabel?: string;
  successMessage?: string;
  consentNote?: string;
  formActionUrl?: string | null;
  audienceId?: string | null;
}

interface Props {
  siteSettings?:
    | (RawChromeSettings & {
        title?: string;
        email?: string;
        phone?: string;
        socialInstagram?: string;
        socialFacebook?: string;
        socialLinks?: { platform?: string; url?: string; label?: string }[] | null;
        serviceAreas?: string[];
        tagline?: string;
        footerCredit?: string;
        footerCreditUrl?: string;
        footerInvite?: string;
        footerAbout?: string;
        footerVerse?: { text?: string | null; reference?: string | null } | null;
        footerSecondaryCta?: CtaTarget & { label?: string };
        newsletter?: NewsletterConfig | null;
      })
    | null;
}

const { siteSettings } = Astro.props as Props;

// The chrome (footer columns, the small-print row, the social switch) resolves
// through one shared helper (see src/lib/siteSettings.ts) so the footer can't
// drift from the header. Both menus come back EMPTY when Sanity is empty, and
// the built-in markup below renders instead.
const chrome = resolveSiteSettings(siteSettings);

// Normalize section visibility. Unset => visible (safe default for live site).
const visible = getSectionVisibility(siteSettings?.sectionVisibility);

const brandName = siteSettings?.title ?? site.name;
// The footer mark: Site settings' square icon when one is uploaded (2026-10-26), else the brand
// kit's white mark on its paper plate.
const footerMarkSrc = chrome.icon
  ? urlFor(chrome.icon).width(144).height(144).fit('crop').auto('format').url()
  : markAsset.src;

// Social links: the one shared list (src/lib/social-links.ts), the same one the header strip
// and the phone menu show. The footer's own "show social buttons" switch (Site Settings ->
// Navigation); unset means yes, so an untouched site is unchanged.
const socialLinksToRender: SocialLink[] = chrome.showFooterSocials
  ? resolveSocialLinks(siteSettings)
  : [];

// Copyright auto-updates every build via new Date(). The "Site by..." line
// (siteCredit + siteCreditUrl) is a SEPARATE concept that sits next to the
// auto-year copyright in the thin bottom bar.
const currentYear = new Date().getFullYear();
const siteCredit = siteSettings?.footerCredit;
const siteCreditUrl = siteSettings?.footerCreditUrl;

// Optional editor-managed footer columns. When non-empty, these replace the
// built-in Studio / Work / Free tools columns. "Get in touch" always renders
// as the last column regardless. Additive: empty = built-in defaults.
// A custom page ticked "Show in the footer" joins the last row (src/lib/page-switches.ts).
const sanityFooterColumns = mergePageSwitches([], chrome.footerColumns, await getNavPages()).footer;
const useCustomFooterColumns = sanityFooterColumns.length > 0;

// The small-print row at the very bottom. EMPTY means "keep the built-in
// privacy link", which is rendered as its own markup below.
const LEGAL_LINKS = chrome.legalNav;

// Pull the three most recent projects for the Latest Projects column.
// Falls back to an empty array when Sanity isn't reachable (build won't fail).
const allProjects: CoreProjectCard[] = (await getAllProjects().catch(() => [])) ?? [];
const latestProjects = allProjects.slice(0, 3);

// FBC Auburn, board E (2026-10-17): the ink footer's brand row. The mark with the tagline, then
// Sundays, Find us and Follow, all from Site settings (facts derived, never typed).
const footerFacts = await getChurchFacts();
const footerGive = giveHref(GIVE_PATH, footerFacts.givingUrl);
const footerSundays = footerFacts.serviceTimes.filter((t) => t.dayIndex === 0);
const footerSundaysConfirmed = footerSundays.every((t) => t.confirmed);
const footerAddress = footerFacts.address;
// Phone, email, the Facebook page and the live stream link, all from Church facts and each null
// until filled in (visitor audit, 2026-10-18).
const { phone, email, facebookUrl, liveUrl, memberLoginUrl, newsletterFormUrl } = footerFacts;
// Member sign-in (Church Trac > Member sign-in link, 2026-10-24). Before launch an empty link shows
// a "[Jacob: ...]" ask in its place, which ClientNotes.astro highlights; after launch it is simply left out.
const memberLoginAsk = !memberLoginUrl && CLIENT_NOTES_ACTIVE;
// The newsletter (2026-10-24): the church's email list is in Church Trac, so the footer links to
// its sign-up form (Church Trac > Newsletter sign-up form). Before launch an empty box shows an ask,
// unless the site's own list has been switched on instead (Site settings > Newsletter).
const ownNewsletter = siteSettings?.newsletter?.enabled === true && !newsletterFormUrl;
const newsletterAsk = !newsletterFormUrl && !ownNewsletter && CLIENT_NOTES_ACTIVE;
// The Facebook page gets a words link unless the social buttons below already show it.
const facebookText =
  facebookUrl && !socialLinksToRender.some((l) => l.platform === 'Facebook') ? facebookUrl : null;
const hasTouch = !!(
  email ||
  phone ||
  liveUrl ||
  facebookText ||
  memberLoginUrl ||
  memberLoginAsk ||
  newsletterFormUrl ||
  newsletterAsk ||
  socialLinksToRender.length > 0
);
// The page endings (site audit, 2026-10-25): the footer's own "Plan your visit" and "Ask a
// question" buttons are gone (the header carries the visit button and the link rows cover the
// rest), the verse runs on Home only, and the This Sunday panel shows only where nothing above it
// already gives the Sunday times. The where-next rows give way to a page's own closing band (CSS:
// .where-next in WhereNext.astro hides when <main> holds a [data-final-cta]).
// The live path, so the draft preview draws the same footer as the page it previews.
const path = publicPath(Astro.url.pathname);
const here = path;
const isHome = here === '/';
// Pages whose own content leads with the Sunday times and address. Other pages that show a
// This Sunday card or the times band ([data-this-sunday], [data-service-times], .times-band-wrap)
// hide the panel by CSS (auburn.css, "The page endings").
const SUNDAY_PAGES = new Set(['/', '/plan-your-visit/']);
const showSunday = !SUNDAY_PAGES.has(here);
// The footer's own words (Site settings > Social & footer), each with the built-in fallback.
const footerAbout =
  siteSettings?.footerAbout ||
  'A Southern Baptist church in Ross Township, Ohio, serving Millville, Ross and Hamilton';
// The verse across the top of the footer (2026-10-24), Site settings > Social and footer. The
// default is Hebrews 13:8 in the KJV, the verse on the church's Facebook page in the wording it
// quotes (2026-10-26; it was Matthew 11:28), until Pastor Jacob confirms or picks another.
const verseText =
  siteSettings?.footerVerse?.text?.trim() ||
  'Jesus Christ the same yesterday, and to day, and for ever.';
const verseRef = siteSettings?.footerVerse?.text?.trim()
  ? siteSettings.footerVerse.reference?.trim() || ''
  : 'Hebrews 13:8 (KJV)';
// The This Sunday panel and its calendar link, from the same facts as Home's card.
const sunday = thisSunday(footerFacts, churchDataNow());
const hasCalendar =
  sundayIcs({ ...footerFacts, title: site.name }, churchDataNow(), site.url) !== null;
---

<footer class="site-footer bg-muted text-foreground">
  {/* FBC Auburn footer, compact since 2026-10-24 (it was 1,523px on desktop, 1.7 screens: a
      display-size tagline, a building sketch and a full-width brick "Auburn" signature, all gone).
      1. The sill: a band of the mark's bricks across the top edge.
      2. Left: the mark, the two next steps (the closing invite on pages with no band of their own)
         and the link rows (Sanity footer columns; Get in touch only when filled). Right: the live
         This Sunday panel: date, times, address, Directions, all from Church facts.
      3. A slim bottom bar.
      Under the sill, the verse: one line of scripture in big type that slides across as the
      reader scrolls into the footer (src/scripts/flow.ts; at rest, or with reduced motion, it
      simply wraps).
      Behind 2, the building sketch at low opacity, bottom right.
      The whole footer is ink: .site-footer redefines the colour tokens (src/styles/auburn.css),
      so the starter's link grid below turns light-on-ink without touching its classes. */}
  <Sill class="site-footer__sill" />

  {/* Where next (2026-10-24): three big rows so no page is a dead end (WhereNext.astro). */}
  <WhereNext path={path} />

  {/* Home only (design audit H1 and L6, 2026-10-25): one signature moment, the same at both widths,
      instead of an 88px line ending every desktop page and nothing on a phone. */}
  {isHome && (
    <figure class="sf-verse" data-flow-verse>
      <blockquote class="m-0">
        <p class="sf-verse__line">
          <span class="sf-verse__text">&ldquo;{verseText}&rdquo;</span>
          {verseRef && <cite class="sf-verse__ref">{verseRef}</cite>}
        </p>
      </blockquote>
    </figure>
  )}

  <div class="sf-top mx-auto max-w-content px-l">
    {/* The building, faint, behind the footer's own content (2026-10-24): it takes no room of its
        own, so the compact footer stays compact. Decorative; CSS in auburn.css (.sf-sketch). */}
    <div class="sf-sketch" aria-hidden="true">
      <BuildingSketch ink="#7F98B8" class="sf-sketch__art" draw={false} />
    </div>
    <div class="sf-invite">
      {/* The mark with the church's name beside it (2026-10-24): the mark alone did not say whose
          footer this is. */}
      <p class="sf-invite__brand">
        <img
          class="sf-invite__mark"
          src={footerMarkSrc}
          width={72}
          height={72}
          alt=""
          loading="lazy"
          decoding="async"
        />
        <span class="sf-invite__name">{brandName}</span>
        {/* Give, as a button (Nathan, 2026-10-25), at the end of the name row: the Give page, or
            online giving once it is set. A light outline: navy would vanish on the ink footer. */}
        <a href={footerGive} class="btn-auburn sf-invite__give">
          <HandHeart size={18} aria-hidden="true" />
          Give
        </a>
      </p>

      {/* Link grid. FBC Auburn (Home audit, 2026-10-17): it takes the brand row's own columns
           (.site-footer__links in src/styles/auburn.css), so Visit, Belong and Connect line up under
           the tagline, Sundays and Find us; two columns on phones. When siteSettings.footerColumns is
           non-empty, the custom Sanity columns replace the built-in ones. Get in touch renders only
           when there is an email, a phone or a social link to show. */}
      <div
        id="site-footer-nav"
        class="site-footer__links mx-auto grid max-w-content gap-l px-l pt-l pb-m text-left"
      >
        {/* --- Editor-managed columns (from Sanity siteSettings.footerColumns) --- */}
        {useCustomFooterColumns ? (
          sanityFooterColumns.map((col, colIdx) => (
            <nav aria-labelledby={`footer-custom-${colIdx}`}>
              <p
                id={`footer-custom-${colIdx}`}
                class="mb-s text-xs tracking-eyebrow text-foreground/80 uppercase"
              >
                {col.title}
              </p>
              <ul class="list-none p-0 text-sm">
                {col.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        ) : (
          <>
            {/* --- Built-in columns (default when footerColumns is empty) --- */}

            {/* STUDIO */}
            <nav aria-labelledby="footer-studio">
              <p
                id="footer-studio"
                class="mb-s text-xs tracking-eyebrow text-foreground/80 uppercase"
              >
                Our church
              </p>
              <ul class="list-none p-0 text-sm">
                {/* scaffold: about */}
                <li>
                  <a
                    href="/about/"
                    class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
                  >
                    About
                  </a>
                </li>
                {/* scaffold:end */}
                {/* scaffold: faq */}
                <li>
                  <a
                    href="/plan-your-visit/#questions"
                    class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
                  >
                    Questions
                  </a>
                </li>
                {/* scaffold:end */}
                {visible.press && (
                  <li>
                    <a
                      href="/press/"
                      class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
                    >
                      Press
                    </a>
                  </li>
                )}
              </ul>
            </nav>

            {/* WORK */}
            <nav aria-labelledby="footer-work">
              <p
                id="footer-work"
                class="mb-s text-xs tracking-eyebrow text-foreground/80 uppercase"
              >
                Read
              </p>
              <ul class="list-none p-0 text-sm">
                {visible.portfolio && (
                  <li>
                    <a
                      href="/portfolio/"
                      class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
                    >
                      Portfolio
                    </a>
                  </li>
                )}
                {visible.portfolio && (
                  <li>
                    <a
                      href="/portfolio/before-after/"
                      class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
                    >
                      Before &amp; After
                    </a>
                  </li>
                )}
                {/* scaffold: journal */}
                {visible.journal && (
                  <li>
                    <a
                      href="/journal/"
                      class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
                    >
                      Journal
                    </a>
                  </li>
                )}
                {/* scaffold:end */}
                {visible.shop && (
                  <li>
                    <a
                      href="/shop/"
                      class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
                    >
                      Shop
                    </a>
                  </li>
                )}
                {visible.giftCertificates && (
                  <li>
                    <a
                      href="/gift-certificates/"
                      class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
                    >
                      Gift Certificates
                    </a>
                  </li>
                )}
              </ul>
            </nav>

            {/* FREE TOOLS & GUIDES: only when one of its modules is switched on (FBC Auburn has none). */}
            {(visible.styleQuiz ||
              visible.budgetCalculator ||
              visible.guides ||
              visible.resources) && (
              <nav aria-labelledby="footer-tools">
                <p
                  id="footer-tools"
                  class="mb-s text-xs tracking-eyebrow text-foreground/80 uppercase"
                >
                  Free tools &amp; guides
                </p>
                <ul class="list-none p-0 text-sm">
                  {visible.styleQuiz && (
                    <li>
                      <a
                        href="/quiz/"
                        class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
                      >
                        Style Quiz
                      </a>
                    </li>
                  )}
                  {visible.budgetCalculator && (
                    <li>
                      <a
                        href="/calculator/"
                        class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
                      >
                        Cost Calculator
                      </a>
                    </li>
                  )}
                  {visible.guides && (
                    <li>
                      <a
                        href="/guides/"
                        class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
                      >
                        Guides
                      </a>
                    </li>
                  )}
                  {visible.resources && (
                    <li>
                      <a
                        href="/resources/"
                        class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
                      >
                        Resources
                      </a>
                    </li>
                  )}
                </ul>
              </nav>
            )}
          </>
        )}

        {/* LATEST PROJECTS — only when portfolio is visible. */}
        {visible.portfolio ? (
          <nav aria-labelledby="footer-latest">
            <p
              id="footer-latest"
              class="mb-s text-xs tracking-eyebrow text-foreground/80 uppercase"
            >
              Latest projects
            </p>
            {latestProjects.length > 0 ? (
              <ul class="list-none p-0 text-sm">
                {latestProjects.map((p) => (
                  <li>
                    <a
                      href={`/portfolio/${p.slug?.current ?? ''}/`}
                      class="inline-flex min-h-[44px] min-w-[44px] items-center justify-start text-foreground/85 transition-colors hover:text-link"
                    >
                      {p.title}
                    </a>
                  </li>
                ))}
                <li class="pt-xs">
                  <a
                    href="/portfolio/"
                    class="inline-flex min-h-[44px] items-center gap-xs text-xs font-semibold tracking-eyebrow text-link uppercase transition-colors hover:text-primary-dark"
                  >
                    View all <span aria-hidden="true">→</span>
                  </a>
                </li>
              </ul>
            ) : (
              <p class="text-sm text-foreground/85 italic">
                Case studies are coming soon.{' '}
                <a
                  href="/portfolio/"
                  class="text-link underline underline-offset-2 hover:text-primary-dark"
                >
                  See the portfolio →
                </a>
              </p>
            )}
          </nav>
        ) : null}

        {/* GET IN TOUCH: email, phone, the live stream, Facebook, socials. Skipped when there is none. */}
        {hasTouch && (
          <div class="sf-touch">
            <p class="mb-s text-xs tracking-eyebrow text-foreground/80 uppercase">Contact</p>
            <div class="sf-touch__rows space-y-1 text-sm">
              {email && (
                <p>
                  <CopyEmailButton email={email.display} variant="link" />
                  <NotConfirmed confirmed={email.confirmed} />
                </p>
              )}
              {phone && (
                <p class="sf-touch__phone">
                  <a
                    href={phone.tel}
                    class="inline-flex min-h-[44px] items-center gap-xs text-link transition-colors hover:text-primary-dark"
                  >
                    <Phone size={14} aria-hidden="true" />
                    {phone.display}
                  </a>
                  {/* Text and the "To confirm" tag wrap together, never the tag alone. */}
                  <span class="sf-touch__text">
                    {phone.sms && (
                      <>
                        {' '}
                        <span aria-hidden="true">·</span>{' '}
                        <a
                          href={phone.sms}
                          class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center text-link transition-colors hover:text-primary-dark"
                        >
                          Text<span class="sr-only"> {phone.display}</span>
                        </a>
                      </>
                    )}
                    <NotConfirmed confirmed={phone.confirmed} />
                  </span>
                </p>
              )}
              {liveUrl && (
                <p>
                  <a
                    href={liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-[44px] items-center gap-xs text-link transition-colors hover:text-primary-dark"
                  >
                    <IconPlayerPlay size={14} stroke={1.75} aria-hidden="true" />
                    Watch live on Sunday<span class="sr-only"> (opens in a new tab)</span>
                  </a>
                </p>
              )}
              {facebookText && (
                <p>
                  <a
                    href={facebookText}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-[44px] items-center gap-xs text-link transition-colors hover:text-primary-dark"
                  >
                    <IconBrandFacebook size={14} stroke={1.75} aria-hidden="true" />
                    Facebook<span class="sr-only"> (opens in a new tab)</span>
                  </a>
                </p>
              )}
              {memberLoginUrl && (
                <p>
                  <a
                    href={memberLoginUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-[44px] items-center gap-xs text-link transition-colors hover:text-primary-dark"
                  >
                    <IconUser size={14} stroke={1.75} aria-hidden="true" />
                    Members: sign in<span class="sr-only"> (opens in a new tab)</span>
                  </a>
                </p>
              )}
              {newsletterFormUrl && (
                <p>
                  <a
                    href={newsletterFormUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-[44px] items-center gap-xs text-link transition-colors hover:text-primary-dark"
                  >
                    <IconMail size={14} stroke={1.75} aria-hidden="true" />
                    Get the church newsletter<span class="sr-only"> (opens in a new tab)</span>
                  </a>
                </p>
              )}
              {/* Outside <main>, so the For Jacob highlighter does not reach it: marked here instead. */}
              {memberLoginAsk && (
                <p>
                  <mark class="fj-mark">
                    [Jacob: your Church Trac member sign-in link goes here.]
                  </mark>
                </p>
              )}
              {newsletterAsk && (
                <p>
                  <mark class="fj-mark">
                    [Jacob: your Church Trac newsletter sign-up form goes here.]
                  </mark>
                </p>
              )}
            </div>
            {socialLinksToRender.length > 0 && (
              <ul class="sf-touch__social mt-m flex list-none flex-wrap justify-start gap-s p-0 text-sm">
                {socialLinksToRender.map((link) => {
                  const Icon = socialIcon(link.platform);
                  const ariaLabel = socialLabel(link);
                  return (
                    <li>
                      <a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={ariaLabel}
                        class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-border text-foreground transition-colors hover:border-primary-dark hover:bg-primary-dark hover:text-white"
                      >
                        <Icon size={20} stroke={1.5} />
                      </a>
                    </li>
                  );
                })}
              </ul>
            )}
          </div>
        )}
      </div>
    </div>
    {sunday && showSunday && (
      <div class="sf-sunday" role="group" aria-labelledby="sf-sunday-title">
        {/* A group, not an aside: Home's This Sunday card is the page's complementary landmark of
            that name, and two would clash (axe landmark-unique). */}
        <div class="sf-sunday__top">
          <p class="sf-sunday__eyebrow" id="sf-sunday-title">
            {sunday.isToday ? 'Today' : 'This Sunday'}
          </p>
          <NotConfirmed
            confirmed={sunday.confirmed}
            label="Times to confirm"
            class="sf-sunday__tag"
          />
        </div>
        <p class="sf-sunday__date">
          <time datetime={sunday.date}>{sunday.dateLabel.replace(/^Sunday, /, '')}</time>
        </p>
        <dl class="sf-sunday__times">
          {sunday.services.map((s) => (
            <div>
              <dt>{s.timeLabel.replace(/ am$/, '')}</dt>
              <dd>{s.label}</dd>
            </div>
          ))}
        </dl>
        {/* A different Sunday (2026-10-26): the times above are that date's. */}
        <SundayChange sunday={sunday} size="compact" />
        {footerAddress && (
          <div class="sf-sunday__where">
            <p>
              {footerAddress.street}
              <br />
              {footerAddress.lines[1]}
            </p>
            {footerAddress.findUs && <p class="sf-sunday__findus">{footerAddress.findUs}</p>}
            <p class="sf-sunday__links">
              <a href={footerAddress.mapsUrl} rel="noopener" target="_blank">
                Directions<span class="sr-only"> (opens Google Maps in a new tab)</span>
              </a>
              {phone?.confirmed && (
                <a href={phone.tel} class="sf-sunday__phone">
                  {phone.display}
                </a>
              )}
              {hasCalendar && (
                <a href="/sunday.ics" download class="sf-sunday__ics">
                  Add to my calendar
                </a>
              )}
            </p>
          </div>
        )}
      </div>
    )}
  </div>

  {/* The site's own newsletter box: only when siteSettings.newsletter.enabled is true and no
       Church Trac sign-up form is set (Church Trac wins). Island hydrates when scrolled into view. */}
  {ownNewsletter && siteSettings?.newsletter && (
    <div class="mx-auto max-w-content px-l pt-l">
      <div class="mx-auto max-w-md">
        <NewsletterSignup client:visible newsletter={siteSettings.newsletter} source="footer" />
      </div>
    </div>
  )}

  <div class="sf-bottom">
    <div class="sf-bottom__inner mx-auto max-w-content px-l">
      <p>
        © {currentYear} {brandName}
        <span class="sf-bottom__dot" aria-hidden="true">
          ·
        </span>
        <span class="sf-bottom__about">{footerAbout}</span>
      </p>
      <div class="sf-bottom__links">
        {LEGAL_LINKS.length > 0 ? (
          LEGAL_LINKS.map((l) => <a href={l.href}>{l.label}</a>)
        ) : (
          <a href="/privacy/">Privacy policy</a>
        )}
        {siteCredit &&
          (siteCreditUrl ? (
            <a href={siteCreditUrl} target="_blank" rel="noopener noreferrer">
              {siteCredit}
            </a>
          ) : (
            <span>{siteCredit}</span>
          ))}
        <a href="#main" class="sf-bottom__top">
          Back to top <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

{/* The phone Sunday bar: Home and Plan your visit (SundayBar.astro). */}
<SundayBar path={here} />
