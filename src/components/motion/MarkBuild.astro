---
// Safe to edit by hand
// The church mark, large (the "mark" picture choice on an Image and text block, and the Steps rail).
// Since 2026-10-23 the mark is the linocut print (brand/logo/mark.svg), shown from its raster
// (src/assets/brand/mark-print.png, as WebP) because the SVG is about 900 KB of grain. The old
// stone mark that built itself stone by stone (mark-layered.svg) is retired; the class name stays
// so the blocks' layout CSS still applies.
import { getImage } from 'astro:assets';
import markPrint from '@/assets/brand/mark-print.png';

interface Props {
  class?: string;
}
const { class: extraClass = '' } = Astro.props as Props;
const img = await getImage({ src: markPrint, width: 720, format: 'webp', quality: 82 });
---

<div class:list={['mark-build-wrap', extraClass]}>
  <img
    src={img.src}
    width={markPrint.width}
    height={markPrint.height}
    alt="The church's mark: a wall of red-brown brick with a plain cross cut out of it"
    loading="lazy"
    decoding="async"
    style="display:block;width:100%;height:auto"
  />
</div>
