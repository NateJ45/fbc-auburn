---
// Safe to edit by hand
// Page-builder block (FBC Auburn, 2026-10-26): "Contact form". The form column (the phone line on
// a phone, the note above the form, the form or its Church Trac stand-in, the email and phone
// lines under it, the booking widget and "What happens next") beside the sticky sidebar (email,
// phone, the address and directions, the social buttons). Moved here whole from contact.astro so
// the Contact page is a page builder like the others and the pastor can put sections around it.
//
// The form's own settings (its questions, the note above it, "What happens next") stay on the
// Contact page document, tab "The form"; the GROQ arm in src/lib/collection-arms.ts reads them
// into `settings`, so the block draws the same form wherever it is placed and the preview shows
// a draft of them. With no settings at all (a fresh clone, CI) it asks the church's visit
// questions. The church's phone, email and address come from Church facts (rule 15).
//
// Church Trac (2026-10-24, docs/agent/church-trac.md): once Church facts has a contact form or a
// connection card, it takes the site form's place, so messages land in Church Trac.
import { normalizeCustomFields } from '@/lib/custom-form-fields';
import PortableTextStatic from '@/components/PortableTextStatic.astro';
import ContactForm from '@/components/ContactForm';
import ChurchTracFrame from '@/components/church-blocks/ChurchTracFrame.astro';
import { churchTracFormFor } from '@/lib/church-links';
import CopyEmailButton from '@/components/CopyEmailButton.astro';
import CalendlyInline from '@/components/CalendlyInline';
import ChurchAddress from '@/components/church/ChurchAddress.astro';
import NotConfirmed from '@/components/church/NotConfirmed.astro';
import { getChurchFacts } from '@/lib/church-data';
import { getSiteSettings } from '@/lib/queries';
import { Mail, Phone } from 'lucide-react';
import PostInquiryRoadmap from '@/components/PostInquiryRoadmap.astro';
import { resolveSocialLinks, socialLabel } from '@/lib/social-links';
import { socialIcon } from '@/lib/social-icons';
import type { ContactFormSettings } from '@/lib/pageBuilder.types';

interface Props {
  settings?: ContactFormSettings | null;
  /** Show the address, phone and email column beside the form (default yes). */
  sidebar?: boolean;
}
const { settings, sidebar = true } = Astro.props;
const page = settings ?? null;
const siteSettings = await getSiteSettings();

const formIntroNote = page?.formIntroNote ?? '';

// Editor-written form questions (contactPage.formFields), shaped here so the island receives a
// clean list.
// FBC Auburn: with no questions written in the Studio (a fresh build, CI), the form still asks
// the church's visit questions, never the starter's interior-design questionnaire. The same two
// questions are in the Contact page in Sanity; editing them there replaces these.
const DEFAULT_VISIT_QUESTIONS = [
  {
    label: 'What is this about?',
    kind: 'select',
    // No prayer option (re-audit 2026-10-26): a prayer request goes to /prayer/, which keeps its own
    // privacy promise; this form's messages are stored (Privacy page).
    options: ['I am planning to visit', 'A question', 'Something else'],
    required: true,
  },
  { label: 'Your message', kind: 'textarea', required: true },
];
const written = normalizeCustomFields(page?.formFields);
// A prayer topic written in the Studio is left out too (re-audit 2026-10-26): prayer requests go
// to /prayer/, never through this stored form.
const questions = (
  written.length > 0 ? written : normalizeCustomFields(DEFAULT_VISIT_QUESTIONS)
).map((q) =>
  Array.isArray(q.options) ? { ...q, options: q.options.filter((o) => !/pray/i.test(o)) } : q,
);
const questionProps = { customFields: questions };

const schedulingLink = page?.schedulingLink;
const schedulingLinkLabel = page?.schedulingLinkLabel ?? 'Book a time to talk.';

const availability = page?.availabilityNote ?? siteSettings?.availabilityStatus;
// The church's phone and email, from Site settings through Church facts (src/lib/church-facts.ts):
// each is null until it is filled in, and carries its "To confirm" tag until confirmed.
const contactFacts = await getChurchFacts();
const { email, phone } = contactFacts;
const churchTracForm = churchTracFormFor('contact', contactFacts);
// The church's social accounts (2026-10-26), the same list as the footer and the phone menu
// (Site settings > Social links, src/lib/social-links.ts). Empty draws nothing.
const socials = resolveSocialLinks(siteSettings, contactFacts.facebookUrl);

// Satisfaction guarantee — renders near the form CTA when set in siteSettings.
const satisfactionGuarantee = siteSettings?.satisfactionGuarantee;

// Post-inquiry roadmap — prefer the structured steps when present;
// fall through to the legacy whatToExpectContent when the array is empty.
const roadmapSteps = (page?.postInquiryRoadmap ?? []).filter((s) => s?.title?.trim());
const hasRoadmap = roadmapSteps.length > 0;
---

<section
  class:list={[
    'mx-auto grid max-w-content grid-cols-1 gap-section-md px-m py-section-lg',
    sidebar && 'lg:grid-cols-3',
  ]}
>
  {/* Form column */}
  <div class:list={[sidebar && 'lg:col-span-2']}>
    {/* Phones (site audit, 2026-10-25): people who would rather ring or text should not have to
        scroll past every field to find the number, so it leads the column under 1024px, where
        the sidebar falls below the form. The number comes from Church facts. */}
    {phone && (
      <p
        class:list={[
          'mb-s flex flex-wrap items-center gap-xs text-base text-foreground',
          sidebar && 'lg:hidden',
        ]}
      >
        <Phone size={16} aria-hidden="true" className="text-secondary" />
        <span>{phone.sms ? 'Call or text' : 'Call'}</span>
        <a
          href={phone.tel}
          class="inline-flex min-h-[44px] items-center font-semibold text-link underline underline-offset-2 hover:text-primary-dark"
        >
          {phone.display}
        </a>
        <NotConfirmed confirmed={phone.confirmed} />
      </p>
    )}
    {formIntroNote && <p class="mb-m text-base text-foreground/80">{formIntroNote}</p>}

    {/* Satisfaction guarantee line — renders above the form when set in
        siteSettings so it reassures visitors before they fill anything in. */}
    {satisfactionGuarantee && (
      <p class="mb-m flex items-start gap-xs border-l-2 border-primary py-px pl-s text-sm text-foreground/80">
        {satisfactionGuarantee}
      </p>
    )}

    {churchTracForm ? (
      <ChurchTracFrame src={churchTracForm} title="Contact the church" size="long" />
    ) : (
      <>
        <noscript>
          {/* Audit 2026-10-25 (DEV-M3): with JavaScript off the form cannot send; say so, like
            /prayer/, and point at the phone and email below. */}
          <p class="mb-m rounded-md border border-border p-m text-sm text-foreground">
            This form needs JavaScript to send. Please call or email us instead, using the details
            on this page.
          </p>
        </noscript>
        <ContactForm
          client:visible
          projectTypes={page?.formProjectTypeOptions ?? undefined}
          locations={page?.formLocationOptions ?? undefined}
          budgets={page?.formBudgetOptions ?? undefined}
          timelines={page?.formTimelineOptions ?? undefined}
          sources={page?.formSourceOptions ?? undefined}
          {...questionProps}
        />
      </>
    )}

    {/* Email failsafe — surfaced right after the form so visitors who hit
        a submission error or just prefer email have a clear alternate path
        without scrolling away to the sidebar. The widget itself opens a
        mail draft on click and has a small copy button beside it. */}
    {email && (
      <p class="mt-m flex flex-wrap items-center gap-xs text-sm text-foreground/75">
        <Mail size={14} aria-hidden="true" className="text-secondary" />
        <span>Prefer email? Reach us directly at</span>
        <CopyEmailButton email={email.display} variant="link" />
        <NotConfirmed confirmed={email.confirmed} />
      </p>
    )}
    {/* Under 1024px the line above the form and the sidebar already give the number. */}
    {phone && sidebar && (
      <p class="mt-s flex flex-wrap items-center gap-xs text-sm text-foreground/75 max-lg:hidden">
        <Phone size={14} aria-hidden="true" className="text-secondary" />
        <span>{phone.sms ? 'Or call or text' : 'Or call'}</span>
        {/* Phones (phone polish, 2026-10-24): each link a 44px fingertip tall, and the "To confirm"
            tag kept on the line of the link before it instead of wrapping onto a line alone. */}
        <a
          href={phone.tel}
          class="font-medium text-link underline underline-offset-2 hover:text-primary-dark max-md:inline-flex max-md:min-h-[44px] max-md:items-center"
        >
          {phone.display}
        </a>
        <span class="inline-flex items-center gap-xs whitespace-nowrap">
          {phone.sms && (
            <a
              href={phone.sms}
              class="font-medium text-link underline underline-offset-2 hover:text-primary-dark max-md:inline-flex max-md:min-h-[44px] max-md:items-center"
            >
              Text us
            </a>
          )}
          <NotConfirmed confirmed={phone.confirmed} />
        </span>
      </p>
    )}

    {schedulingLink && (
      <CalendlyInline client:visible url={schedulingLink} loadLabel={schedulingLinkLabel} />
    )}

    {/* Post-inquiry roadmap — structured steps when present.
        Falls back to the legacy whatToExpectContent when the roadmap array
        is empty so the page degrades gracefully before content is filled in. */}
    {hasRoadmap ? (
      <PostInquiryRoadmap
        steps={roadmapSteps}
        eyebrow={page?.whatToExpectEyebrow ?? undefined}
        headline={page?.whatToExpectHeadline ?? undefined}
      />
    ) : (
      page?.whatToExpectContent && (
        <div class="mt-section-lg border-t border-border-soft pt-l">
          {page.whatToExpectEyebrow && (
            <p class="mb-s text-xs tracking-[0.22em] text-foreground/80 uppercase">
              {page.whatToExpectEyebrow}
            </p>
          )}
          {page.whatToExpectHeadline && (
            <h2 class="font-display text-h3 auburn-h2">{page.whatToExpectHeadline}</h2>
          )}
          <PortableTextStatic
            value={page.whatToExpectContent as never}
            className="mt-s text-foreground/90"
          />
        </div>
      )
    )}
  </div>

  {/* Sidebar */}
  {/* Sticky on lg+ so the email + service area + map ride along while the
      visitor reads/fills the form. top-24 (6rem) gives clearance under the
      site header when it's revealed via scroll-up. self-start prevents the
      aside from stretching to fill the grid row, which would otherwise
      defeat the sticky positioning. */}
  {sidebar && (
    <aside class="space-y-l lg:sticky lg:top-24 lg:self-start">
      {availability && (
        <div class="flex items-center gap-2 text-sm text-foreground">
          <span class="inline-block h-2 w-2 rounded-full bg-tertiary" aria-hidden="true" />
          <span>{availability}</span>
        </div>
      )}

      {email && (
        <div>
          <p class="mb-xs text-xs tracking-widest text-foreground/80 uppercase">Email</p>
          <CopyEmailButton email={email.display} variant="link" />
          <NotConfirmed confirmed={email.confirmed} />
        </div>
      )}

      {phone && (
        <div>
          <p class="mb-xs text-xs tracking-widest text-foreground/80 uppercase">
            {phone.sms ? 'Call or text' : 'Call'}
          </p>
          {/* 44px tall links on phones; the tag stays beside the Text link (phone polish, 2026-10-24). */}
          <a
            href={phone.tel}
            class="inline-flex items-center gap-xs text-sm text-link transition-colors hover:text-primary-dark max-md:min-h-[44px]"
          >
            <Phone size={14} aria-hidden="true" />
            {phone.display}
          </a>
          <span class="inline-flex items-center whitespace-nowrap">
            {phone.sms && (
              <a
                href={phone.sms}
                class="ml-s inline-flex items-center text-sm text-link transition-colors hover:text-primary-dark max-md:min-h-[44px] max-md:min-w-[44px]"
              >
                Text<span class="sr-only"> {phone.display}</span>
              </a>
            )}
            <NotConfirmed confirmed={phone.confirmed} />
          </span>
        </div>
      )}

      {schedulingLink && (
        <div>
          <p class="mb-xs text-xs tracking-widest text-foreground/80 uppercase">
            Prefer to schedule?
          </p>
          <a
            href={schedulingLink}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-auburn btn-auburn--secondary"
          >
            {schedulingLinkLabel}
          </a>
        </div>
      )}

      {siteSettings?.serviceAreas && siteSettings.serviceAreas.length > 0 && (
        <div>
          <p class="mb-xs text-xs tracking-widest text-foreground/80 uppercase">Service area</p>
          <ul class="space-y-0.5 text-sm text-foreground">
            {siteSettings.serviceAreas.slice(0, 8).map((area: string) => (
              <li>{area}</li>
            ))}
          </ul>
        </div>
      )}

      <div>
        {/* FBC Auburn: the church address and directions (Site settings > Church facts) in place of the starter map. */}
        <p class="mb-xs text-xs tracking-widest text-foreground/80 uppercase">Find us</p>
        <ChurchAddress />
      </div>

      {socials.length > 0 && (
        <div>
          <p class="mb-xs text-xs tracking-widest text-foreground/80 uppercase" id="contact-social">
            Follow along
          </p>
          <ul class="flex list-none flex-wrap gap-s p-0" aria-labelledby="contact-social">
            {socials.map((link) => {
              const Icon = socialIcon(link.platform);
              return (
                <li>
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={socialLabel(link)}
                    class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-border text-foreground transition-colors hover:border-primary-dark hover:bg-primary-dark hover:text-white"
                  >
                    <Icon size={20} stroke={1.5} aria-hidden="true" />
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      )}
    </aside>
  )}
</section>
