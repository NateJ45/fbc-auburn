---
// Page-builder block: image and text side by side. Image side is
// editor-controlled; surface comes from SectionRenderer. Safe to edit by hand.
import SanityImage from '@/components/SanityImage.astro';
import { surfaceClass, type CadenceSurface } from '@/lib/surfaces';
import PortableText from '@/components/PortableText';
import CtaLink from '@/components/CtaLink.astro';
import SectionLabel from '@/components/home/SectionLabel.astro';
import MarkBuild from '@/components/motion/MarkBuild.astro';
import BaptismGraphic from '@/components/motion/BaptismGraphic.astro';
import BuildingSketch from '@/components/church/BuildingSketch.astro';
import ShotRequest from '@/components/ShotRequest.astro';
import { shotFor } from '@/data/shot-list';
import { splitStega } from '@/lib/preview-stega';
// Auburn's shape system (2026-10-24): a photo here is cut to the building's gable and set over a
// navy brick slab that runs to the page edge on the photo's side (src/styles/shapes.css).
import '@/styles/shapes.css';
// With no photo yet, the slot holds the church's mark, not an empty grey shape (2026-10-24).
import markPrint from '@/assets/brand/mark-print.png';
import { getImage } from 'astro:assets';

interface Props {
  /** FBC Auburn: a photo, or one of the church's drawings with its scroll motion. */
  art?: 'photo' | 'mark' | 'baptism' | 'building' | 'none';
  image?: any;
  imageSide?: 'left' | 'right';
  eyebrow?: string;
  heading?: string;
  body?: any;
  cta?: any;
  /** From SectionRenderer's cadence, including the band an editor's look asks for. */
  surface?: CadenceSurface;
  headingId: string;
  /** The page's first section (SectionRenderer leadImage): the photo loads eagerly, at high priority. */
  isFirst?: boolean;
}

const {
  art = 'photo',
  image,
  imageSide = 'left',
  eyebrow,
  heading,
  body,
  cta,
  surface = 'background',
  headingId,
  isFirst = false,
} = Astro.props as Props;

// Surface classes come from src/lib/surfaces.ts (the measured pairs). Same
// strings as the ternary that was here for 'background' and 'muted'.
const bg = surfaceClass(surface);
const imageFirst = imageSide === 'left';
// The empty-arch mark as WebP at the sizes it is drawn (up to 150px, so 150 and 300 for 2x screens),
// not the 720px master PNG (about 128 KB; audit DEV-L1, 2026-10-25).
const markImg = await getImage({ src: markPrint, widths: [150, 300], format: 'webp' });
// Before launch, a photo slot that is empty or holds a stand-in names the photo we want instead
// (src/data/shot-list.ts, keyed by page and heading). Drawings ('mark', 'baptism', 'building') never.
const shot =
  art === 'photo' ? shotFor(Astro.url.pathname, splitStega(heading ?? '').cleaned, 0, image) : null;
const bodyClass = `text-foreground/85 text-lg leading-relaxed ${heading || eyebrow ? 'mt-m' : ''}`;
---

{art === 'none' ? (
  // No picture (2026-10-25, the site audit): the words alone, on the page's reading measure.
  <section class={bg} aria-labelledby={heading ? headingId : undefined}>
    <div class="mx-auto max-w-content px-m py-section-lg" data-reveal>
      <div class="max-w-3xl">
        {eyebrow && <SectionLabel text={eyebrow} as="p" />}
        {heading && (
          <h2 id={headingId} class="font-display text-h2 auburn-h2">
            {heading}
          </h2>
        )}
        {body && <PortableText value={body} className={bodyClass} />}
        {cta?.label && (
          <div class="mt-l">
            <CtaLink cta={cta} variant="secondary" />
          </div>
        )}
      </div>
    </div>
  </section>
) : art === 'building' ? (
  // THE BUILDING BAND (2026-10-23): the words on one row (heading left, the paragraph and the
  // button right, the split's own tracks), then the pen-and-pencil sketch of the church across the
  // full column, standing on the page (its brick sill went in the 2026-10-25 audit: one sill per page). The Muncie site's heritage band is the
  // model: the drawing is the page's centrepiece, not a picture beside a paragraph.
  <section class={bg} aria-labelledby={heading ? headingId : undefined}>
    <div class="mx-auto max-w-content px-m pt-section-lg" data-reveal>
      <div class="split items-start">
        <div>
          {eyebrow && <SectionLabel text={eyebrow} as="p" />}
          {heading && (
            <h2 id={headingId} class="font-display text-h2 auburn-h2">
              {heading}
            </h2>
          )}
        </div>
        <div>
          {body && <PortableText value={body} className={bodyClass} />}
          {cta?.label && (
            <div class="mt-l">
              <CtaLink cta={cta} variant="secondary" />
            </div>
          )}
        </div>
      </div>
      <BuildingSketch
        class="building-band__sketch"
        label="A pen and pencil sketch of the church: the red brick building with its white portico, the ramp up to the front door, the steeple, and the road sign beside the plain roadside cross"
      />
    </div>
  </section>
) : (
  <section class:list={[bg, 'shape-slab-host']} aria-labelledby={heading ? headingId : undefined}>
    {/* THE SHARED SPLIT (PORTS.md card 91). `.split` in globals.css is the one text/picture
      column split; the picture takes the narrow track on whichever side it is on, so
      `.split--media-first` mirrors the tracks. The picture stays first in the DOM and the
      side is chosen with `lg:order-*`, so the stacked phone order (picture, then words) is
      unchanged. */}
    <div
      class:list={[
        'split mx-auto max-w-content items-center px-m py-section-lg',
        imageFirst && 'split--media-first',
      ]}
      data-reveal
    >
      <div class:list={[imageFirst ? 'lg:order-1' : 'lg:order-2']}>
        {art === 'mark' ? (
          <div class="auburn-art">
            <MarkBuild class="auburn-art__mark" />
          </div>
        ) : art === 'baptism' ? (
          <div class="auburn-art">
            <BaptismGraphic class="auburn-art__baptism" />
          </div>
        ) : shot || image?.asset ? (
          // A photo (or its Photo needed request): the gable over the brick slab.
          <div class:list={['shape-slab', imageFirst && 'shape-slab--left']}>
            {shot ? (
              <ShotRequest shot={shot} class="auburn-arch shape-gable" priority={isFirst} />
            ) : (
              <SanityImage
                source={image}
                width={800}
                sizes="(min-width: 1024px) 45vw, 100vw"
                quality={75}
                loading={isFirst ? 'eager' : 'lazy'}
                fetchpriority={isFirst ? 'high' : undefined}
                class="auburn-arch shape-gable h-auto w-full object-cover"
              />
            )}
          </div>
        ) : (
          <div class="auburn-arch auburn-arch--empty" aria-hidden="true">
            <img
              class="auburn-arch__mark"
              src={markImg.src}
              srcset={markImg.srcSet.attribute}
              sizes="150px"
              width="720"
              height="703"
              alt=""
              loading="lazy"
              decoding="async"
            />
          </div>
        )}
      </div>

      <div class:list={[imageFirst ? 'lg:order-2' : 'lg:order-1']}>
        {eyebrow && <SectionLabel text={eyebrow} as="p" />}
        {heading && (
          <h2 id={headingId} class="font-display text-h2 auburn-h2">
            {heading}
          </h2>
        )}
        {body && <PortableText value={body} className={bodyClass} />}
        {cta?.label && (
          <div class="mt-l">
            <CtaLink cta={cta} variant="secondary" />
          </div>
        )}
      </div>
    </div>
  </section>
)}
