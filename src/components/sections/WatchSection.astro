---
// Safe to edit by hand
// Page-builder block (FBC Auburn): the Watch band from the mockups. Light, words on the left, the
// latest message from the church's YouTube channel on the right (LastSunday, which plays in place).
// With no channel set or the feed down, the editor's "no video yet" line stands in. When the block
// has a poster picture, that line becomes a dark video card instead (the Gemini comp's "Watch the
// latest sermon"): the picture, a play button and the link, so the band never shows an empty box.
// Under the words, the live stream and the church's Facebook page (visitor audit, 2026-10-18), both
// from Site settings through Church facts and each hidden until it is filled in.
import CtaLink from '@/components/CtaLink.astro';
import LastSunday from '@/components/church/LastSunday.astro';
import SanityImage from '@/components/SanityImage.astro';
import { surfaceClass } from '@/lib/surfaces';
import { ctaHref } from '@/lib/cta-href';
import type { ProjectedCtaBlock, SanityImageObject } from '@/lib/pageBuilder.types';
import { getChurchFacts } from '@/lib/church-data';
import { churchDataNow } from '@/lib/church-feeds';
import { monthDay } from '@/lib/church-facts';
import SermonArt from '@/components/collections/SermonArt.astro';
import { sermonHref, watchSermon, type SermonDoc } from '@/lib/sermons';
import { fixtureNewestSermon } from '@/lib/collection-queries';

interface Props {
  eyebrow?: string;
  heading?: string;
  body?: string;
  link?: ProjectedCtaBlock | null;
  fallback?: string;
  poster?: SanityImageObject | null;
  /** The newest sermon (the Sermons list), 2026-10-18. */
  latestSermon?: SermonDoc | null;
  surface?: 'background' | 'muted';
  headingId: string;
}
const {
  eyebrow,
  heading = 'Missed a Sunday?',
  body,
  link,
  fallback,
  poster,
  latestSermon,
  surface = 'background',
  headingId,
} = Astro.props;
const posterHref = poster?.asset && link ? ctaHref(link, '/watch/') : null;
const newTab = link?.linkType === 'external' || !!link?.openInNewTab;
const { liveUrl, facebookUrl } = await getChurchFacts();
// The Facebook page only gets its own line when the live link goes somewhere else.
const facebookLine = facebookUrl && facebookUrl !== liveUrl ? facebookUrl : null;
// The sermon archive (2026-10-18), first match wins: a sermon preached in the last eight days
// (it names the card and goes to its page), then the YouTube replay (LastSunday), then the newest
// sermon of any age as "Latest message", then the poster card or the "no video yet" line. With no
// sermons at all the band is exactly what it was.
const { fresh: sermonNow, latest: sermonAny } = watchSermon(
  latestSermon ?? (await fixtureNewestSermon()),
  churchDataNow(),
);
const sermon = sermonNow ?? sermonAny;
const sermonLabel = sermonNow ? 'Last Sunday' : 'Latest message';
---

<section class:list={[surfaceClass(surface), 'watch-band']} aria-labelledby={headingId}>
  <div class="split mx-auto max-w-content items-center px-m py-section-lg" data-reveal>
    <div>
      {eyebrow && <p class="arch-hero__eyebrow">{eyebrow}</p>}
      <h2 id={headingId} class="font-display text-h2 auburn-h2 leading-tight">
        {heading}
      </h2>
      {body && <p class="mt-m max-w-xl text-lg leading-relaxed text-muted-foreground">{body}</p>}
      {(link?.label || liveUrl) && (
        <div class="watch-band__actions mt-l">
          {liveUrl && (
            <a
              class="btn-auburn btn-auburn--primary press-tactile"
              href={liveUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Watch live on Sunday<span class="sr-only"> (opens in a new tab)</span>
            </a>
          )}
          {link?.label && <CtaLink cta={link} variant="secondary" />}
        </div>
      )}
      {facebookLine && (
        <p class="mt-m text-muted-foreground">
          News and photos are on{' '}
          <a
            class="text-link underline underline-offset-2"
            href={facebookLine}
            target="_blank"
            rel="noopener noreferrer"
          >
            the church's Facebook page<span class="sr-only"> (opens in a new tab)</span>
          </a>
          .
        </p>
      )}
    </div>
    <div>
      <LastSunday fallbackOnly={Boolean(sermonNow)}>
        {sermon ? (
          <a slot="fallback" class="watch-sermon" href={sermonHref(sermon?.slug)}>
            <SermonArt sermon={sermon} play width={760} sizes="(min-width: 54rem) 45vw, 100vw" />
            <span class="watch-sermon__label">
              {sermonLabel} ·{' '}
              <time datetime={sermon?.date ?? undefined}>
                {sermon?.date ? monthDay(sermon.date) : ''}
              </time>
            </span>
            <span class="watch-sermon__title">{sermon?.title}</span>
          </a>
        ) : posterHref ? (
          <a
            slot="fallback"
            class="watch-card"
            href={posterHref}
            target={newTab ? '_blank' : undefined}
            rel={newTab ? 'noopener noreferrer' : undefined}
          >
            <SanityImage
              source={poster}
              width={760}
              height={428}
              alt=""
              sizes="(min-width: 54rem) 45vw, 100vw"
              quality={65}
              class="watch-card__img"
            />
            <span class="watch-card__shade" aria-hidden="true"></span>
            <span class="watch-card__play" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="26" height="26">
                <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
              </svg>
            </span>
            <span class="watch-card__label">Watch the latest message</span>
          </a>
        ) : (
          fallback && (
            <p slot="fallback" class="watch-band__fallback">
              {fallback}
            </p>
          )
        )}
      </LastSunday>
    </div>
  </div>
</section>

<style>
  .watch-band {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .watch-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
  }
  .watch-band__fallback {
    border: 2px dashed var(--border);
    border-radius: 18px;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--muted-foreground);
    font-size: 1.1rem;
    line-height: 1.55;
  }
  .watch-card {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 18px;
    background: #16304d;
    color: #fff;
    text-decoration: none;
    box-shadow: 0 18px 40px -22px rgb(29 47 68 / 0.55);
  }
  .watch-card :global(.watch-card__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .watch-card__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(15 25 38 / 0.35), rgb(15 25 38 / 0.7));
  }
  .watch-card__play {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 4.25rem;
    height: 4.25rem;
    margin: -2.6rem 0 0 -2.125rem;
    border-radius: 999px;
    background: #fff;
    color: var(--auburn-red);
    transition: transform 0.3s ease;
  }
  .watch-card__play svg {
    margin-left: 3px;
  }
  .watch-card__label {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.1rem;
    text-align: center;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.85rem;
  }
  .watch-card:hover .watch-card__play,
  .watch-card:focus-visible .watch-card__play {
    transform: scale(1.08);
  }
  .watch-card:hover :global(.watch-card__img) {
    transform: scale(1.03);
  }
  .watch-card:focus-visible {
    outline: 3px solid var(--auburn-gold);
    outline-offset: 3px;
  }
  .watch-sermon {
    display: grid;
    gap: 0.25rem;
    color: inherit;
    text-decoration: none;
  }
  .watch-sermon__label {
    margin-top: 0.65rem;
    font-weight: 600;
    color: var(--heading-solid, var(--foreground));
  }
  .watch-sermon__title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1.3;
    color: var(--foreground);
  }
  .watch-sermon:hover .watch-sermon__title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .watch-sermon:focus-visible {
    outline: 3px solid var(--ring);
    outline-offset: 4px;
    border-radius: 14px;
  }
  @media (prefers-reduced-motion: reduce) {
    .watch-card :global(.watch-card__img),
    .watch-card__play {
      transition: none;
    }
  }
</style>
