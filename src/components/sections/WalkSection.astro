---
// Safe to edit by hand
// Page-builder block: "Walk in with us" (walkSection), the Plan your visit standout. The stops of a
// first Sunday as one readable column down a gold stepping-stone path, each stop with its stone
// icon, ending on a button that opens Contact with the visit filled in (/contact/?visit=sunday-11).
//
// The ordered list of stops is the real content. The icons are picked in code from what each stop
// says (src/lib/walk-stops.ts; the schema has no icon field). Everything is in the HTML; the flow
// layer (src/scripts/flow.ts) fades the stops up as they scroll in, and nothing else moves.
// 2026-10-24: the drawn stone-mosaic plan of the lot that used to pin beside the stops was removed
// on every width (its labels were about 6px on a phone); the opener's sketch is the one picture.
// The walk is worship. The line under the intro that named the gatherings before it went in the
// re-audit (2026-10-26): the page head's times band now names each one ("Sunday School 9:45 ·
// Worship 11:00") on the first screen, so it said the same thing twice.
import SectionHeading from '@/components/SectionHeading.astro';
import CtaLink from '@/components/CtaLink.astro';
import { stoneSrcs, stoneIconSrc } from '@/components/motion/stones';
import { walkStopIcon } from '@/lib/walk-stops';
import { surfaceClass } from '@/lib/surfaces';
import type { ProjectedWalkSection } from '@/lib/pageBuilder.types';
import BuildingSketch from '@/components/church/BuildingSketch.astro';
import markEnd from '@/assets/brand/fbc-auburn-icon-full-color.svg';

type Props = Omit<ProjectedWalkSection, '_type' | '_key'> & {
  surface?: 'background' | 'muted';
  headingId: string;
  /** The one-red-button rule (audit 2026-10-25): the walk's ask is red unless an earlier block has
      the red. One ask only since the re-audit (2026-10-26): the opener's copy of it went, so Plan
      your visit says "Tell us you are coming" once in the walk (when set) and once in its close. */
  primaryVariant?: 'primary' | 'navy';
};

const {
  heading,
  intro,
  stops = [],
  endHeading,
  endBody,
  endLinkLabel,
  endLinkHref,
  surface = 'background',
  headingId,
  primaryVariant = 'primary',
} = Astro.props as Props;

const list = stops.filter((s) => s?.title);
const stones = await stoneSrcs();
const icons = await Promise.all(list.map((s, i) => stoneIconSrc(walkStopIcon(s, i))));
---

<section
  class:list={[surfaceClass(surface), 'walk']}
  id="walk"
  aria-labelledby={heading ? headingId : undefined}
  data-no-bgpath
  data-bgpath-page
  data-stones={stones.join(',')}
>
  <div class="mx-auto max-w-content px-m py-section-lg">
    {heading && (
      <SectionHeading
        headline={heading}
        subhead={intro}
        headingId={headingId}
        align="center"
        class="mx-auto steps-rail__intro"
      />
    )}

    {/* The opener (2026-10-23): the building as you see it from the lot, the front door pinned,
        so the walk below starts somewhere a first-time guest will recognise. */}
    <figure class="walk-opener">
      <BuildingSketch
        door
        label="A sketch of the church from the parking lot, with the front door at the top of the ramp marked as the place to start"
      />
      <figcaption>
        [Placeholder: Follow the ramp to the white front porch, and someone will meet you at the
        door.]
      </figcaption>
    </figure>

    <ol class="walk-steps" role="list">
      {list.map((stop, i) => (
        <li class="walk-step">
          <span class="walk-step__stone" aria-hidden="true">
            {icons[i] && <img src={icons[i]} alt="" width="64" height="64" />}
          </span>
          <div class="walk-step__body">
            {stop.time && <p class="walk-steps__t">{stop.time}</p>}
            <h3>{stop.title}</h3>
            {stop.body && <p>{stop.body}</p>}
          </div>
        </li>
      ))}
      {endHeading && (
        <li class="walk-step walk-end">
          {/* The path's last stop: the church mark (audit 2026-10-25, GD-M4). */}
          <span class="walk-step__stone walk-step__stone--end" aria-hidden="true">
            <img src={markEnd.src} alt="" width="40" height="40" />
          </span>
          <div class="walk-step__body">
            <h3>{endHeading}</h3>
            {endBody && <p>{endBody}</p>}
            {endLinkLabel && (
              <div class="mt-l">
                <CtaLink
                  cta={{ label: endLinkLabel, href: endLinkHref || '/contact/?visit=sunday-11' }}
                  variant={primaryVariant}
                />
              </div>
            )}
          </div>
        </li>
      )}
    </ol>
  </div>
</section>
