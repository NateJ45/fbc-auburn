---
// Safe to edit by hand
// Page-builder block (FBC Auburn, 2026-10-18): "Sermon series grid". The newest series first,
// ordered by each series' first sermon (derived, rule 15), three across on a wide screen like the
// stone-icon cards. A content block: the surface comes from the cadence.
import SeriesCard from '@/components/collections/SeriesCard.astro';
import SeriesPreviewList from '@/components/collections/SeriesPreviewList.astro';
import { surfaceClass } from '@/lib/surfaces';
import { seriesUsesPreview, sortSeries, type SeriesDoc } from '@/lib/sermons';
import { getAllPageSlugs } from '@/lib/queries';

// The Watch page is made in the Studio: link it only while it is published, so a build without
// the dataset (CI) or a renamed page never leaves a broken link (2026-10-24).
const hasWatch = (await getAllPageSlugs()).includes('watch');

interface Props {
  heading?: string;
  intro?: string;
  limit?: number;
  /** Draw nothing (and skip series with no sermons yet) until there is one to show (2026-10-26). */
  hideWhenEmpty?: boolean;
  series?: SeriesDoc[];
  surface?: 'background' | 'muted';
  headingId: string;
}
const {
  heading = 'Sermon series',
  intro,
  limit = 6,
  hideWhenEmpty = false,
  series = [],
  surface = 'background',
  headingId,
} = Astro.props;
const list = sortSeries(
  (series ?? []).filter((s) => s?.title && s?.slug && (!hideWhenEmpty || (s.count ?? 0) > 0)),
).slice(0, Math.max(1, Math.min(24, limit ?? 6)));
// Three or more series: a wide screen with a mouse also gets the list with one large picture
// (SeriesPreviewList.astro, 2026-11-09); CSS picks which of the two shows, the cards everywhere else.
const preview = seriesUsesPreview(list);
---

{!(hideWhenEmpty && list.length === 0) && (
  <section class={surfaceClass(surface)} aria-labelledby={headingId}>
    <div class="mx-auto max-w-content px-m py-section-lg" data-reveal>
      <div class="c-head">
        <h2 id={headingId} class="font-display text-h2 auburn-h2 leading-tight">
          {heading}
        </h2>
        {intro && <p class="c-intro">{intro}</p>}
      </div>
      {list.length > 0 ? (
        <>
          <ul class:list={['c-grid', preview && 'c-grid--has-preview']} role="list">
            {list.map((s) => (
              <SeriesCard series={s} />
            ))}
          </ul>
          {preview && <SeriesPreviewList list={list} />}
          <p class="c-more">
            <a class="c-link" href="/sermons/">
              Every sermon
            </a>
          </p>
        </>
      ) : (
        <p class="c-empty">
          Sermon series will show here once the first one is added.
          {hasWatch && (
            <>
              {' '}
              In the meantime,{' '}
              <a class="c-link" href="/watch/">
                watch Sunday's service
              </a>
              .
            </>
          )}
        </p>
      )}
    </div>
  </section>
)}
