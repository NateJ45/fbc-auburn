---
// Safe to edit by hand
// Page-builder block: the stepping-stone rail (stepsRailSection). Numbered steps, each beside a
// big stone icon, joined icon to icon by a trail of the mark's small stepping stones that snakes down
// the icon column for the full height of each step (2026-10-25); the path ends in
// the church mark, which builds itself stone by stone (MarkBuild), then a closing line and buttons.
//
// Everything here is server-rendered: the stones, the mark and every word are in the HTML, so the
// block reads the same without JS. Motion (src/styles/motion.css, src/scripts/motion.ts): each
// stone lands as it scrolls in, in order down the page; reduced motion shows it all at rest.
// Design source: the studio mockups' index.html ".rail" and motion.js part 1 (2026-10-17).
import SectionHeading from '@/components/SectionHeading.astro';
import CtaLink from '@/components/CtaLink.astro';
import MarkBuild from '@/components/motion/MarkBuild.astro';
import { stoneSrcs, stoneIconSrc } from '@/components/motion/stones';
import { surfaceClass } from '@/lib/surfaces';
import { withTrailingSlash } from '@/lib/href';
import type { ProjectedStepsRailSection } from '@/lib/pageBuilder.types';

type Props = Omit<ProjectedStepsRailSection, '_type' | '_key'> & {
  surface?: 'background' | 'muted';
  headingId: string;
};

const {
  heading,
  intro,
  steps = [],
  endHeading,
  primaryCta,
  secondaryCta,
  surface = 'background',
  headingId,
} = Astro.props as Props;

const stones = await stoneSrcs();
const rows = await Promise.all(
  steps.filter((s) => s?.title).map(async (s) => ({ ...s, iconSrc: await stoneIconSrc(s.icon) })),
);
// The trail between two icons: PEBBLES of the mark's two long slabs (stone-a and stone-b; the
// squat stone-c looked like a stray block at this size) on a gentle arc, bending the other way on
// each segment so the whole path snakes down the page. x is the sideways offset, r the turn,
// which follows the arc smoothly; w evens the two shapes out so they read as one size.
const PEBBLES = 5;
const trail = (n: number) =>
  Array.from({ length: PEBBLES }, (_, k) => {
    const t = (k + 1) / (PEBBLES + 1);
    const dir = n % 2 ? 1 : -1;
    const slab = (n + k) % 2;
    return {
      src: stones[slab],
      w: slab ? 27 : 30,
      x: Math.round(dir * Math.sin(t * Math.PI) * 12),
      r: Math.round(dir * Math.cos(t * Math.PI) * -14),
    };
  });
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<section
  class:list={[surfaceClass(surface), 'steps-rail']}
  aria-labelledby={heading ? headingId : undefined}
  data-no-bgpath
  data-bgpath-page
  data-stones={stones.join(',')}
>
  <div class="mx-auto max-w-content px-m py-section-lg">
    {heading && (
      <SectionHeading
        headline={heading}
        subhead={intro}
        headingId={headingId}
        align="center"
        class="mx-auto steps-rail__intro"
      />
    )}

    <ol class="rail" role="list">
      {rows.map((step, n) => (
        <li class="rail__step">
          <div class="rail__col">
            <span class="rail__stone reveal">
              {step.iconSrc && <img src={step.iconSrc} alt="" width="80" height="80" />}
            </span>
            {n < rows.length - 1 && (
              <span class="rail__trail" aria-hidden="true">
                {trail(n).map((t, k) => (
                  <img
                    class="rail__pebble reveal"
                    src={t.src}
                    alt=""
                    width={t.w}
                    height="12"
                    style={`--w:${t.w}px;--d:${k * 90}ms;--k:${k / 2};--x:${t.x}px;--r:${t.r}deg`}
                  />
                ))}
              </span>
            )}
          </div>
          <div class="rail__body">
            <p class="rail__n">Step {n + 1}</p>
            <h3 class="rail__title">{step.title}</h3>
            {step.body && <p class="rail__text">{step.body}</p>}
            {step.times && step.times.length > 0 && (
              <dl class="rail__times">
                {step.times.map((t) => (
                  <div>
                    <dt>{t.time}</dt>
                    <dd>{t.label}</dd>
                  </div>
                ))}
              </dl>
            )}
            {step.linkLabel && step.linkHref && (
              <a
                class="rail__link"
                href={withTrailingSlash(step.linkHref)}
                target={isExternal(step.linkHref) ? '_blank' : undefined}
                rel={isExternal(step.linkHref) ? 'noopener noreferrer' : undefined}
              >
                {step.linkLabel}
                {isExternal(step.linkHref) && <span class="sr-only"> (opens in a new tab)</span>}
              </a>
            )}
          </div>
        </li>
      ))}
    </ol>

    <div class="rail-end">
      <MarkBuild class="rail-end__mark" />
      {endHeading && <p class="rail-end__line font-display auburn-h2">{endHeading}</p>}
      {(primaryCta?.label || secondaryCta?.label) && (
        <div class="rail-end__ctas">
          {primaryCta?.label && <CtaLink cta={primaryCta} variant="primary" />}
          {secondaryCta?.label && <CtaLink cta={secondaryCta} variant="secondary" />}
        </div>
      )}
    </div>
  </div>
</section>
