---
// scaffold-file: faq
// Safe to edit by hand
// Page-builder block: inline FAQ accordion. References existing faqItem documents
// resolved at query time via sectionsProjection. Reuses the FaqAccordion React
// island from src/components/FaqAccordion.tsx.
//
// SELF_CONTAINED — manages its own bg-background surface (no surface prop).
//
// JSON-LD: this block deliberately does NOT emit FAQPage structured data.
// Duplicate FAQPage markup is penalised in rich results, and a page can hold two
// of these blocks. FBC Auburn retired the /faq page on 2026-10-24 (it forwards to
// /plan-your-visit/#questions), so no page emits it now; see docs/PENDING.md.
//
// FBC Auburn (2026-10-24): on the page's left edge like every other band (rule 17),
// and the first one on a page carries id="questions" (`anchor`, from SectionRenderer).
import SectionHeading from '@/components/SectionHeading.astro';
import CtaLink from '@/components/CtaLink.astro';
import FaqAccordion from '@/components/FaqAccordion';

interface FaqItem {
  _id?: string;
  question?: string;
  answer?: any;
  category?: string;
  displayOrder?: number;
}

interface Props {
  eyebrow?: string;
  headline?: string;
  /** One word of the headline in the brand accent colour. See SectionHeading. */
  headingAccent?: string;
  subhead?: string;
  /** Optional rich twin of `subhead`: bold and italic only. */
  subheadRich?: unknown;
  items?: FaqItem[];
  cta?: any;
  headingId?: string;
  /** The section's id, for links like /plan-your-visit/#questions. */
  anchor?: string;
}

const {
  eyebrow,
  headline = 'Common Questions.',
  headingAccent,
  subhead,
  subheadRich,
  items = [],
  cta,
  headingId = 'faq-section-heading',
  anchor,
} = Astro.props as Props;

const validItems = items.filter((i) => i?.question);
---

{validItems.length > 0 && (
  <section
    id={anchor}
    class="bg-background scroll-mt-24"
    aria-labelledby={headline ? headingId : undefined}
    aria-label={!headline ? 'Frequently asked questions' : undefined}
  >
    <div class="mx-auto max-w-content px-m py-section-lg" data-reveal>
      <SectionHeading
        eyebrow={eyebrow}
        headline={headline}
        subhead={subhead}
        subheadRich={subheadRich}
        headingId={headingId}
        align="left"
        headingAccent={headingAccent}
      />

      <div class="mt-l max-w-3xl">
        <FaqAccordion client:visible faqs={validItems} idPrefix={headingId} />
      </div>

      {cta?.label && (
        <div class="mt-l flex">
          <CtaLink
            cta={cta}
            variant="secondary"
            fallbackHref="/plan-your-visit/#questions"
            fallbackLabel="See All Questions"
          />
        </div>
      )}
    </div>
  </section>
)}
