---
// Safe to edit by hand
// "Add our calendar to your phone": the subscribe buttons on their own, with a heading and a line.
// Renders nothing until Church facts has a Church Trac calendar feed.
import ChurchBand from './ChurchBand.astro';
import SubscribeButtons from './SubscribeButtons.astro';
import { getChurchFacts } from '@/lib/church-data';
import type { ProjectedCalendarSubscribeSection } from '@/lib/churchBlocks.types';

interface Props {
  block: ProjectedCalendarSubscribeSection;
  surface?: 'background' | 'muted';
  headingId: string;
}
const { block, surface, headingId } = Astro.props;
const { icalUrl } = await getChurchFacts();
---

{icalUrl && (
  <ChurchBand
    type={block._type}
    heading={block.heading}
    intro={block.intro}
    headingId={headingId}
    surface={surface}
    label="Add our calendar"
  >
    <SubscribeButtons />
    <p class="cb-small" style="margin-top: 1rem">
      New events then show up on your phone by themselves.
    </p>
  </ChurchBand>
)}
