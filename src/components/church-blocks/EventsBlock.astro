---
// Safe to edit by hand
// Upcoming events from the Church Trac calendar, read once per build (loadChurchEvents, the same
// feed This week and Home read) and rebuilt every morning: the next N dated events, optionally only
// those that mention a keyword. Weekly gatherings are left to Service times. Empty state: the
// block's own line, which is also what shows until Church facts has a calendar feed.
import ChurchBand from './ChurchBand.astro';
import SubscribeButtons from './SubscribeButtons.astro';
import { getChurchFacts } from '@/lib/church-data';
import { churchDataNow, loadChurchEvents } from '@/lib/church-feeds';
import {
  dayOfMonth,
  monthShort,
  nextEvents,
  timeRange,
  whatsOn,
  whenLine,
} from '@/lib/church-calendar';
import { keywordsOf, matchesKeywords } from '@/lib/church-blocks';
import type { ProjectedEventsSection } from '@/lib/churchBlocks.types';

interface Props {
  block: ProjectedEventsSection;
  surface?: 'background' | 'muted';
  headingId: string;
  now?: Date;
}
const { block, surface, headingId, now = churchDataNow() } = Astro.props;
const facts = await getChurchFacts();
const events = await loadChurchEvents(facts);
const count = Math.min(12, Math.max(1, block.count ?? 5));
const all = events ? nextEvents(whatsOn(events, now), 200) : [];
const rows = matchesKeywords(all, keywordsOf(block.keywords)).slice(0, count);
const Title = block.heading ? 'h3' : 'h2';
---

<ChurchBand
  type={block._type}
  heading={block.heading}
  intro={block.intro}
  headingId={headingId}
  surface={surface}
  label="Upcoming events"
>
  {rows.length > 0 ? (
    <ul class="cb-events" role="list">
      {rows.map((r) => (
        <li class="cb-event">
          <span class="cb-event__date" aria-hidden="true">
            <span class="cb-event__month">{monthShort(r.date)}</span>
            <span class="cb-event__day">{dayOfMonth(r.date)}</span>
          </span>
          <div>
            <Title class="cb-event__title">{r.title}</Title>
            <p class="cb-event__meta">
              {whenLine(r)}, {timeRange(r.startMinutes, r.durationMinutes)}
              {r.location && `, ${r.location}`}
            </p>
          </div>
        </li>
      ))}
    </ul>
  ) : (
    <p class="cb-card">{block.emptyText || 'Nothing else is on the calendar just now.'}</p>
  )}
  {block.showSubscribe !== false && <SubscribeButtons />}
</ChurchBand>
