---
// Safe to edit by hand
// Picks the component for one block of the church section library (churchSections.ts).
// SectionRenderer hands every church block here in one branch, so the library grows without
// touching the shared renderer again. Every component is empty-safe: a block with nothing to show
// (no address, no events, a notice outside its dates) renders nothing at all.
import '@/styles/church-blocks.css';
import type { ChurchPageBlock } from '@/lib/churchBlocks.types';
import ServiceTimesBlock from './ServiceTimesBlock.astro';
import MapBlock from './MapBlock.astro';
import BeliefsBlock from './BeliefsBlock.astro';
import TimelineBlock from './TimelineBlock.astro';
import AccordionBlock from './AccordionBlock.astro';
import TabsBlock from './TabsBlock.astro';
import ScriptureBlock from './ScriptureBlock.astro';
import NoticeBlock from './NoticeBlock.astro';
import CountdownBlock from './CountdownBlock.astro';
import GivingBlock from './GivingBlock.astro';
import LivestreamBlock from './LivestreamBlock.astro';
import EventsBlock from './EventsBlock.astro';
import NewsletterBlock from './NewsletterBlock.astro';
import CalendarSubscribeBlock from './CalendarSubscribeBlock.astro';
import ProgressBlock from './ProgressBlock.astro';
import AffiliationsBlock from './AffiliationsBlock.astro';
import ButtonRowBlock from './ButtonRowBlock.astro';
import ContactCardBlock from './ContactCardBlock.astro';
import ColumnsBlock from './ColumnsBlock.astro';
import PhotoBlock from './PhotoBlock.astro';
import FormBlock from './FormBlock.astro';
import RsvpBlock from './RsvpBlock.astro';

interface Props {
  block: ChurchPageBlock;
  surface?: 'background' | 'muted';
  headingId: string;
}

const { block: b, surface = 'background', headingId } = Astro.props;
const common = { surface, headingId };
---

{b._type === 'serviceTimesSection' ? (
  <ServiceTimesBlock block={b} {...common} />
) : b._type === 'mapSection' ? (
  <MapBlock block={b} {...common} />
) : b._type === 'beliefsSection' ? (
  <BeliefsBlock block={b} {...common} />
) : b._type === 'timelineSection' ? (
  <TimelineBlock block={b} {...common} />
) : b._type === 'accordionSection' ? (
  <AccordionBlock block={b} {...common} />
) : b._type === 'tabsSection' ? (
  <TabsBlock block={b} {...common} />
) : b._type === 'scriptureSection' ? (
  <ScriptureBlock block={b} {...common} />
) : b._type === 'noticeSection' ? (
  <NoticeBlock block={b} />
) : b._type === 'countdownSection' ? (
  <CountdownBlock block={b} {...common} />
) : b._type === 'givingSection' ? (
  <GivingBlock block={b} {...common} />
) : b._type === 'livestreamSection' ? (
  <LivestreamBlock block={b} {...common} />
) : b._type === 'eventsSection' ? (
  <EventsBlock block={b} {...common} />
) : b._type === 'newsletterSection' ? (
  <NewsletterBlock block={b} {...common} />
) : b._type === 'calendarSubscribeSection' ? (
  <CalendarSubscribeBlock block={b} {...common} />
) : b._type === 'progressSection' ? (
  <ProgressBlock block={b} {...common} />
) : b._type === 'affiliationsSection' ? (
  <AffiliationsBlock block={b} {...common} />
) : b._type === 'buttonRowSection' ? (
  <ButtonRowBlock block={b} {...common} />
) : b._type === 'contactCardSection' ? (
  <ContactCardBlock block={b} {...common} />
) : b._type === 'columnsSection' ? (
  <ColumnsBlock block={b} {...common} />
) : b._type === 'photoSection' ? (
  <PhotoBlock block={b} {...common} />
) : b._type === 'formSection' ? (
  <FormBlock block={b} {...common} />
) : b._type === 'rsvpSection' ? (
  <RsvpBlock block={b} {...common} />
) : null}
