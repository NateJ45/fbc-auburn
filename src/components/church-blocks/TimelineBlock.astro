---
// Safe to edit by hand
// History timeline: moments in order down a rail of gold stepping-stone dashes (the walk's rail on
// Home), each moment marked by a hand-laid stone in the walk's shapes. On a wide screen the year
// sits in its own column left of the rail and a moment's photo sits beside its words on the shared
// split, so the band uses the whole column (block polish, 2026-10-18). On a phone the year moves
// above the title and the photo under the words.
import ChurchBand from './ChurchBand.astro';
import SanityImage from '@/components/SanityImage.astro';
import type { ProjectedTimelineSection } from '@/lib/churchBlocks.types';

interface Props {
  block: ProjectedTimelineSection;
  surface?: 'background' | 'muted';
  headingId: string;
}
const { block, surface, headingId } = Astro.props;
const entries = (block.entries ?? []).filter((e) => e?.title || e?.year);
const Title = block.heading ? 'h3' : 'h2';
---

{entries.length > 0 && (
  <ChurchBand
    type={block._type}
    heading={block.heading}
    intro={block.intro}
    headingId={headingId}
    surface={surface}
    label="History timeline"
  >
    <ol class="cb-timeline" role="list">
      {entries.map((e, i) => (
        <li class:list={['cb-moment', e.image?.asset && 'cb-moment--photo']}>
          <span class="cb-moment__year">{e.year}</span>
          <span class:list={['cb-moment__stone', `cb-stone--${i % 4}`]} aria-hidden="true" />
          <div class="cb-moment__body">
            {e.title && <Title class="cb-moment__title">{e.title}</Title>}
            {e.text && <p>{e.text}</p>}
          </div>
          {e.image?.asset && (
            <div class="cb-moment__photo">
              <SanityImage
                source={e.image}
                width={720}
                sizes="(min-width: 64rem) 32rem, 90vw"
                quality={72}
              />
            </div>
          )}
        </li>
      ))}
    </ol>
  </ChurchBand>
)}
