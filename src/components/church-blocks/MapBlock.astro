---
// Safe to edit by hand
// Map and directions block: the drawn map card Plan your visit already has (ChurchMap: the
// address from Church facts, Google Maps and Apple Maps buttons, nothing loaded from a map service
// until a visitor taps one), with Church facts' "How to find us" line and the block's own extra
// directions above it. Renders nothing when no address is set.
import ChurchBand from './ChurchBand.astro';
import ChurchMap from '@/components/church/ChurchMap.astro';
import { getChurchFacts } from '@/lib/church-data';
import type { ProjectedMapSection } from '@/lib/churchBlocks.types';

interface Props {
  block: ProjectedMapSection;
  surface?: 'background' | 'muted';
  headingId: string;
}
const { block, surface, headingId } = Astro.props;
const { address } = await getChurchFacts();
const lines = [address?.findUs, block.note].filter((l): l is string => Boolean(l?.trim()));
---

{address && (
  <ChurchBand
    type={block._type}
    heading={block.heading}
    intro={block.intro}
    headingId={headingId}
    surface={surface}
    label="Map and directions"
  >
    {lines.length > 0 && (
      <div class="cb-prose" style="max-width: 44rem">
        {lines.map((l) => (
          <p>{l}</p>
        ))}
      </div>
    )}
    <ChurchMap />
  </ChurchBand>
)}
