---
// Safe to edit by hand
// Progress toward a goal (a building fund): raised so far over the goal, a bar, the amount to go
// and the "as of" date, all worked out from the two numbers typed (progressState, rule 15). Plain
// whole-dollar formatting. Renders nothing without a positive goal.
import ChurchBand from './ChurchBand.astro';
import CtaLink from '@/components/CtaLink.astro';
import { asOfLabel, progressState } from '@/lib/church-blocks';
import type { ProjectedProgressSection } from '@/lib/churchBlocks.types';

interface Props {
  block: ProjectedProgressSection;
  surface?: 'background' | 'muted';
  headingId: string;
}
const { block, surface, headingId } = Astro.props;
const p = progressState(block.goal, block.raised);
const asOf = asOfLabel(block.asOf);
const name = block.heading || 'Progress toward our goal';
---

{p.valid && (
  <ChurchBand
    type={block._type}
    heading={block.heading}
    intro={block.intro}
    headingId={headingId}
    surface={surface}
    label={name}
  >
    <div class="cb-progress">
      <p class="cb-progress__numbers">
        <span>
          <span class="cb-progress__raised">{p.raised}</span> raised
        </span>
        <span>of {p.goal}</span>
      </p>
      <div
        class="cb-progress__track"
        role="progressbar"
        aria-label={name}
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow={p.percent}
        aria-valuetext={`${p.raised} of ${p.goal}, ${p.percent} percent`}
      >
        <div class="cb-progress__fill" style={`width: ${p.percent}%`} />
      </div>
      <p class="cb-progress__foot cb-small">
        <span>{p.remaining}</span>
        {asOf && <span>{asOf}</span>}
      </p>
      {block.link?.label && (
        <div class="cb-actions">
          <CtaLink cta={block.link} variant="secondary" />
        </div>
      )}
    </div>
  </ChurchBand>
)}
