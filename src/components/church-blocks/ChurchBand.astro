---
// Safe to edit by hand
// The frame every church-library block shares (churchSections.ts): the surface the cadence gave
// it (rule 9), the content column, and the optional heading and intro line on the page's one left
// edge (rule 17). A block with no heading is named by `label` so its region still has a name.
import SectionHeading from '@/components/SectionHeading.astro';
import { surfaceClass } from '@/lib/surfaces';

interface Props {
  heading?: string | null;
  intro?: string | null;
  headingId: string;
  surface?: 'background' | 'muted';
  /** The region's name when there is no heading. */
  label?: string;
  type: string;
}

const { heading, intro, headingId, surface = 'background', label, type } = Astro.props;
---

<section
  class:list={[surfaceClass(surface), 'cb']}
  data-church-block={type}
  aria-labelledby={heading ? headingId : undefined}
  aria-label={!heading ? label : undefined}
>
  <div class="mx-auto max-w-content px-m py-section-lg" data-reveal>
    {(heading || intro) && (
      <div class="cb-head">
        {heading && <SectionHeading headline={heading} headingId={headingId} />}
        {intro && <p class="cb-intro">{intro}</p>}
      </div>
    )}
    <slot />
  </div>
</section>
