---
// Safe to edit by hand
// "Add to your calendar" buttons for the church's Church Trac feed: Google, Apple (and desktop
// Outlook, which opens webcal links) and Outlook on the web. Derived from the one feed address in
// Church facts (subscribeLinks, rule 15). A subscription keeps itself up to date on the phone.
// Renders nothing without a feed.
import { getChurchFacts } from '@/lib/church-data';
import { subscribeLinks } from '@/lib/church-blocks';
import { site } from '@/data/site';

const { icalUrl } = await getChurchFacts();
const links = subscribeLinks(icalUrl, site.name);
const label = (name: string) => `${name}<span class="sr-only"> (opens in a new tab)</span>`;
---

{links && (
  <div class="cb-actions" data-cb-subscribe>
    <a
      class="btn-auburn btn-auburn--secondary press-tactile"
      href={links.google}
      target="_blank"
      rel="noopener noreferrer"
      set:html={label('Google Calendar')}
    />
    <a class="btn-auburn btn-auburn--secondary press-tactile" href={links.apple}>
      Apple Calendar
    </a>
    <a
      class="btn-auburn btn-auburn--secondary press-tactile"
      href={links.outlook}
      target="_blank"
      rel="noopener noreferrer"
      set:html={label('Outlook')}
    />
  </div>
)}
