---
// Safe to edit by hand
// One wide photo across the content column, with its caption under it. (Two or more side by side
// is the photo gallery block, set to two across.)
import ChurchBand from './ChurchBand.astro';
import SanityImage from '@/components/SanityImage.astro';
import type { ProjectedPhotoSection } from '@/lib/churchBlocks.types';

interface Props {
  block: ProjectedPhotoSection;
  surface?: 'background' | 'muted';
  headingId: string;
}
const { block, surface, headingId } = Astro.props;
---

{block.image?.asset && (
  <ChurchBand
    type={block._type}
    headingId={headingId}
    surface={surface}
    label={block.caption || block.image.alt || 'Photo'}
  >
    <figure class="cb-photo">
      <div class="cb-photo__frame">
        <SanityImage
          source={block.image}
          width={1600}
          sizes="(min-width: 82.5rem) 80rem, 95vw"
          quality={72}
        />
      </div>
      {block.caption && <figcaption>{block.caption}</figcaption>}
    </figure>
  </ChurchBand>
)}
