---
// Safe to edit by hand
// One wide photo across the content column, with its caption under it. (Two or more side by side
// is the photo gallery block, set to two across.) The photo opens full screen in the viewer
// (LightboxLink + Lightbox, 2026-10-18); with JavaScript off it is a link to the full-size photo.
import ChurchBand from './ChurchBand.astro';
import SanityImage from '@/components/SanityImage.astro';
import Lightbox from '@/components/Lightbox.astro';
import LightboxLink from '@/components/LightboxLink.astro';
import type { ProjectedPhotoSection } from '@/lib/churchBlocks.types';

interface Props {
  block: ProjectedPhotoSection;
  surface?: 'background' | 'muted';
  headingId: string;
}
const { block, surface, headingId } = Astro.props;
---

{block.image?.asset && (
  <ChurchBand
    type={block._type}
    headingId={headingId}
    surface={surface}
    label={block.caption || block.image.alt || 'Photo'}
  >
    <figure class="cb-photo" data-lightbox-group>
      <div class="cb-photo__frame">
        <LightboxLink source={block.image} caption={block.caption}>
          <SanityImage
            source={block.image}
            width={1600}
            sizes="(min-width: 82.5rem) 80rem, 95vw"
            quality={72}
          />
        </LightboxLink>
      </div>
      {block.caption && <figcaption>{block.caption}</figcaption>}
    </figure>
    <Lightbox />
  </ChurchBand>
)}
