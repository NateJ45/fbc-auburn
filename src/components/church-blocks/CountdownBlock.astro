---
// Safe to edit by hand
// Countdown to a date (VBS, Easter). Worked out at build time from the dates (rule 15): days to go
// before, the "happening now" line during, the thank-you line after (or nothing, when that line is
// empty). All three are in the page; a tiny script recounts by the church's clock in the visitor's
// browser, so the number is right between the morning rebuilds and the page reads fully without
// JavaScript.
import ChurchBand from './ChurchBand.astro';
import CtaLink from '@/components/CtaLink.astro';
import { churchDataNow } from '@/lib/church-feeds';
import { churchToday, countdownState, daysToGo, isoDay, longDate } from '@/lib/church-blocks';
import type { ProjectedCountdownSection } from '@/lib/churchBlocks.types';

interface Props {
  block: ProjectedCountdownSection;
  surface?: 'background' | 'muted';
  headingId: string;
  now?: Date;
}
const { block, surface, headingId, now = churchDataNow() } = Astro.props;
const state = countdownState(block.startDate, block.endDate, churchToday(now));
const afterText = block.afterText?.trim() ?? '';
const show = state.phase !== 'none' && !(state.phase === 'after' && !afterText);
const start = isoDay(block.startDate);
const end = isoDay(block.endDate) || start;
const when = end && end !== start ? `${longDate(start)} to ${longDate(end)}` : longDate(start);
const name = block.eventName?.trim() || 'The big day';
---

{show && (
  <ChurchBand
    type={block._type}
    headingId={headingId}
    surface={surface}
    label={`Countdown: ${name}`}
  >
    <div
      class="cb-countdown"
      data-cb-countdown
      data-start={start}
      data-end={end}
      data-has-after={afterText ? '1' : undefined}
    >
      <h2 class="cb-count__name" id={headingId}>
        {name}
      </h2>
      <div data-phase="before" hidden={state.phase !== 'before'}>
        <p class="cb-count">
          <span class="cb-count__days" data-days>
            {state.days}
          </span>
          <span class="cb-count__label" data-days-label>
            {daysToGo(state.days).replace(/^\d+ /, '')}
          </span>
        </p>
      </div>
      <p class="cb-count__now" data-phase="during" hidden={state.phase !== 'during'}>
        {block.duringText?.trim() || 'It is happening now.'}
      </p>
      <p class="cb-count__now" data-phase="after" hidden={state.phase !== 'after'}>
        {afterText}
      </p>
      <p class="cb-count__when cb-small">{when}</p>
      {block.intro && <p class="cb-intro">{block.intro}</p>}
      {block.link?.label && (
        <div class="cb-actions">
          <CtaLink cta={block.link} variant="secondary" />
        </div>
      )}
    </div>
  </ChurchBand>
)}

<script>
  // Recount by the church's calendar day (Eastern), so the number is right between rebuilds.
  const today = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'America/New_York',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(new Date());
  const utc = (iso: string) => Date.UTC(+iso.slice(0, 4), +iso.slice(5, 7) - 1, +iso.slice(8, 10));
  for (const el of document.querySelectorAll<HTMLElement>('[data-cb-countdown]')) {
    const start = el.dataset.start ?? '';
    const end = el.dataset.end || start;
    if (!start) continue;
    const phase = today < start ? 'before' : today <= end ? 'during' : 'after';
    if (phase === 'after' && !el.dataset.hasAfter) {
      el.closest('section')?.setAttribute('hidden', '');
      continue;
    }
    for (const p of el.querySelectorAll<HTMLElement>('[data-phase]')) {
      p.hidden = p.dataset.phase !== phase;
    }
    if (phase === 'before') {
      const days = Math.round((utc(start) - utc(today)) / 86_400_000);
      const n = el.querySelector('[data-days]');
      const label = el.querySelector('[data-days-label]');
      if (n) n.textContent = String(days);
      if (label) label.textContent = days === 1 ? 'day to go' : 'days to go';
    }
  }
</script>
