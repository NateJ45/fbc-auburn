---
// Safe to edit by hand
// Newsletter sign-up. The church's email list lives in Church Trac (2026-10-24), so once Site
// settings > Church Trac > Newsletter sign-up form is set, the block shows that form in the site's
// frame and nothing else. Without it: the site's own email box (NewsletterSignup, the one the
// footer uses), using the email service set once in Site settings > Newsletter (rule 15: the
// provider address is never typed per block); until that box is switched on and connected, the
// block's sign-up page link shows as a button instead; with none of them, the block draws nothing.
import ChurchBand from './ChurchBand.astro';
import ChurchTracFrame from './ChurchTracFrame.astro';
import { getChurchFacts } from '@/lib/church-data';
import NewsletterSignup from '@/components/NewsletterSignup';
import { getSiteSettings } from '@/lib/queries';
import type { ProjectedNewsletterSection } from '@/lib/churchBlocks.types';
import type { NewsletterConfig } from '@/components/NewsletterSignup';

interface Props {
  block: ProjectedNewsletterSection;
  surface?: 'background' | 'muted';
  headingId: string;
}
const { block, surface, headingId } = Astro.props;
const settings = await getSiteSettings().catch(() => null);
const { newsletterFormUrl } = await getChurchFacts();
const newsletter = (settings?.newsletter ?? null) as NewsletterConfig | null;
const boxReady = Boolean(
  newsletter?.enabled && (newsletter.formActionUrl || import.meta.env.PUBLIC_WEB3FORMS_KEY),
);
const signupUrl = /^https:\/\//.test(block.signupUrl ?? '') ? block.signupUrl : null;
---

{(newsletterFormUrl || boxReady || signupUrl) && (
  <ChurchBand
    type={block._type}
    heading={block.heading}
    intro={block.intro}
    headingId={headingId}
    surface={surface}
    label="Newsletter sign-up"
    beside
  >
    {newsletterFormUrl ? (
      <div class="cb-sky">
        <ChurchTracFrame src={newsletterFormUrl} title="Newsletter sign-up" size="short" />
      </div>
    ) : boxReady && newsletter ? (
      <div class="cb-sky">
        <NewsletterSignup
          client:visible
          newsletter={newsletter}
          source="newsletter-block"
          hideHeading
          idPrefix={`${headingId}-newsletter`}
        />
      </div>
    ) : (
      <div class="cb-sky cb-actions">
        <a
          class="btn-auburn btn-auburn--secondary press-tactile"
          href={signupUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Sign up for the newsletter<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </div>
    )}
  </ChurchBand>
)}
