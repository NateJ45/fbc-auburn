---
// Safe to edit by hand
// StoneHeading: a page heading in plain Young Serif, deep navy (2026-10-24). It was drawn in brick
// from 2026-10-21 (scripts/lib/brick-letters.mjs, treatment A); Nathan dropped that as too busy, so
// every page head is now real text. The name is kept so ArchHero and BoardPageHead need no change.
//
// Live preview: the text is rendered as given, so an invisible stega run (click-to-edit) rides
// along with it and the overlay finds the field. With an accent the title is split on its visible
// text and the run is put back after the words.
import { splitStega } from '@/lib/preview-stega';
import { splitHeadingAccent } from '@/lib/heading-accent';

interface Props {
  text: string;
  as?: 'h1' | 'h2';
  id?: string;
  class?: string;
  /**
   * Two-tone (2026-10-24): words of the title to set apart in the auburn colour.
   * First match, case-insensitive (src/lib/heading-accent.ts). Not found: the title as usual.
   */
  accent?: string;
}
const { text, as: Tag = 'h1', id, class: cls, accent } = Astro.props;
const { cleaned, encoded } = splitStega(text ?? '');
const two = splitHeadingAccent(cleaned, accent);
---

<Tag id={id} class:list={['stone-heading', 'stone-solid', cls]}>
  {two.found ? (
    <>
      {two.before}
      <span class="stone-heading__accent">{two.word}</span>
      {two.after}
      {encoded}
    </>
  ) : (
    text
  )}
</Tag>
