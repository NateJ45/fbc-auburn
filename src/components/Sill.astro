---
// Safe to edit by hand
// The sill (2026-10-18): a band of the mark's stones in the story's colours (the water, the green
// ring, the gold steps, the red cross), the doorstep along the top of the footer. Generated with
// the Home path by scripts/gen-stones.mjs (SILL in src/components/home/stones.generated.ts), so it
// is the same stone language everywhere. Drawn at its own size and centred, so the stones never
// stretch; the edges run off the screen. Decorative: aria-hidden.
//
// Motion: with html.motion, the stones lay themselves left to right the first time the sill comes
// into view (CSS in src/styles/auburn.css, script below); no JS or reduced motion shows it laid.
import { SILL, SILL_PRINT, SILL_VIEWBOX } from '@/components/home/stones.generated';
import { layOrder } from '@/lib/brick-lay';

// The turn each brick is laid in: bottom course left to right, then back along the top
// (src/lib/brick-lay.ts; the laying is .sill.is-laid in src/styles/auburn.css).
const turns = layOrder(SILL);

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
// The linocut flecks: a mask over the bricks. A page can draw the sill more than once, so the id
// takes the class (footer, menu) to stay unique.
const maskId = `sill-print${className ? '-' + className.replace(/[^a-z0-9-]/gi, '') : ''}`;
---

<div class:list={['sill', className]} aria-hidden="true" data-sill>
  <svg viewBox={SILL_VIEWBOX} focusable="false" preserveAspectRatio="xMidYMid slice">
    <Fragment set:html={SILL_PRINT.replaceAll('__ID__', maskId)} />
    <g mask={`url(#${maskId})`}>
      {SILL.map((s, i) => (
        <path class="sill-brick" d={s.d} fill={s.fill} style={`--i: ${i}; --lay: ${turns[i]}`} />
      ))}
    </g>
  </svg>
</div>

<script>
  // Lay each sill once, when a quarter of it is on screen. Only under html.motion (BaseLayout sets
  // it unless reduced motion or ?still), so no JS shows the finished sill.
  // Laid only on a full-motion page (Home, the 404; audit 2026-10-25); elsewhere it rests laid.
  if (
    document.documentElement.classList.contains('motion') &&
    document.querySelector('#main [data-flow-full]') &&
    'IntersectionObserver' in window
  ) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-laid');
          io.unobserve(e.target);
        }
      },
      { threshold: 0.25 },
    );
    document.querySelectorAll<HTMLElement>('[data-sill]').forEach((el) => {
      el.classList.add('is-armed');
      io.observe(el);
    });
  }
</script>
