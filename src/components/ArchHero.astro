---
// Safe to edit by hand
// ArchHero: the FBC Auburn page hero (Direction A blended with B and C, DESIGN.md).
// Hero.astro hands over to this whenever the site's hero layout is "split" (brand.config.json).
//
//   size="tall"   Home masthead: the eyebrow reads "First Baptist Church of" and the headline,
//                 "Auburn", is set huge as brick letters (StoneHeading). The subhead's first
//                 sentence becomes the large serif intro line (red, the Gemini comp's "Come as you
//                 are.") and the rest sits under it, then the derived "This Sunday" line.
//   size="short"  Inner pages: handed to BoardPageHead (board E, 2026-10-17): no arch, no mark.
//
// The right column is an arched photo (Sanity "Background image"). With no photo yet (the photo
// session comes later) the arch shows the church's stone mark instead of an empty box.
// The arched photo is the LCP element, so it loads eagerly with high priority.
import { getImage } from 'astro:assets';
import SanityImage from '@/components/SanityImage.astro';
import CtaLink from '@/components/CtaLink.astro';
import StoneHeading from '@/components/StoneHeading.astro';
import StoneIcon from '@/components/StoneIcon.astro';
import ThisSunday from '@/components/church/ThisSunday.astro';
import BoardPageHead from '@/components/home/BoardPageHead.astro';
// The full linocut print as a raster (brand/logo/mark.svg is about 900 KB of grain).
import markLight from '@/assets/brand/mark-print.png';
import type { SanityImageObject } from '@/lib/pageBuilder.types';
import type { ComponentProps } from 'astro/types';

type Cta = ComponentProps<typeof CtaLink>['cta'];

interface Props {
  eyebrow?: string;
  headline: string;
  subhead?: string;
  image?: SanityImageObject | null;
  primaryCta?: Cta | null;
  secondaryCta?: Cta | null;
  headingId: string;
  size?: 'tall' | 'short';
  /** Inner pages: one large stone icon above the title (src/lib/stone-icons.ts). */
  icon?: string | null;
  /** Inner pages: the page has its own stone moment further down (BoardPageHead). */
  quiet?: boolean;
  /** Inner pages: words of the title set in auburn (BoardPageHead, StoneHeading). */
  headingAccent?: string;
  /** Inner pages: the Sunday times band under the head (TimesBand.astro). */
  showTimes?: boolean;
}

const {
  eyebrow,
  headline,
  subhead,
  image,
  primaryCta,
  secondaryCta,
  headingId,
  size = 'short',
  icon,
  quiet = false,
  headingAccent,
  showTimes = false,
} = Astro.props as Props;

const masthead = size === 'tall';

// Masthead only: split the subhead after its first sentence. Derived from the one field, so the
// editor still writes a single subhead (CLAUDE.md rule 15).
let intro = '';
let rest = subhead ?? '';
if (masthead && subhead) {
  const m = subhead.match(/^(.+?[.!?])\s+(.+)$/s);
  if (m) {
    intro = m[1];
    rest = m[2];
  } else {
    intro = subhead;
    rest = '';
  }
}

const hasImage = !!image?.asset;
const mark =
  hasImage || !masthead
    ? null
    : await getImage({ src: markLight, width: 640, format: 'webp', quality: 82 });
---

{!masthead ? (
  <BoardPageHead
    {eyebrow}
    {headline}
    {subhead}
    {image}
    {primaryCta}
    {secondaryCta}
    {headingId}
    {icon}
    {quiet}
    {headingAccent}
    {showTimes}
  />
) : (
  <section
    class:list={['arch-hero', masthead ? 'arch-hero--masthead' : 'arch-hero--page']}
    aria-labelledby={headingId}
    data-hero="arch"
  >
    <div class="arch-hero__inner mx-auto max-w-content px-m">
      <div class="arch-hero__copy">
        {!masthead && icon && (
          <StoneIcon name={icon} size={112} loading="eager" class="arch-hero__icon reveal" />
        )}
        {eyebrow && <p class="arch-hero__eyebrow">{eyebrow}</p>}
        <StoneHeading text={headline} id={headingId} />
        {intro && <p class="arch-hero__intro">{intro}</p>}
        {rest && <p class="arch-hero__sub">{rest}</p>}
        {masthead && <ThisSunday class="arch-hero__sunday" />}
        {(primaryCta || secondaryCta) && (
          <div class="arch-hero__ctas">
            {primaryCta && <CtaLink cta={primaryCta} variant="primary" />}
            {secondaryCta && <CtaLink cta={secondaryCta} variant="secondary" />}
          </div>
        )}
      </div>

      {hasImage ? (
        <div class="arch-hero__arch">
          <SanityImage
            source={image}
            width={720}
            sizes="(min-width: 54rem) 40vw, 100vw"
            loading="eager"
            fetchpriority="high"
            quality={70}
          />
        </div>
      ) : (
        <div class="arch-hero__arch arch-hero__arch--mark" aria-hidden="true">
          <img src={mark!.src} alt="" width="400" height="400" loading="eager" decoding="async" />
        </div>
      )}
    </div>
  </section>
)}
